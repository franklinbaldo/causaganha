[Unit]
Description=CausaGanha Daily Parquet Export Timer
Documentation=https://github.com/franklinbaldo/causaganha
Requires=causaganha-export.service

[Timer]
# Run daily at 02:00 UTC
OnCalendar=*-*-* 02:00:00 UTC

# If system was off during scheduled time, run on next boot
Persistent=true

# Add random delay of 0-30 minutes to avoid thundering herd
RandomizedDelaySec=30min

# Time zone (UTC to ensure consistent timing)
# Note: OnCalendar already specifies UTC above
# AccuracySec determines how precisely the timer fires
AccuracySec=5min

[Install]
WantedBy=timers.target
