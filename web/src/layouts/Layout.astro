---
import '../index.css';
import { ClientRouter } from 'astro:transitions';
import { css } from '../../styled-system/css';
import { navLink } from '../../styled-system/recipes';
import NetworkStatusBanner from '../components/NetworkStatusBanner.astro';
import { CSP_META_CONTENT } from '../lib/csp';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  fullWidth?: boolean;
  showNetworkBanner?: boolean;
}

const {
  title,
  description = 'CausaGanha — consulte processos e publicações judiciais com fontes, cobertura e proveniência explícitas.',
  ogImage,
  fullWidth = false,
  showNetworkBanner = true,
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage || new URL(`${BASE}og-image.png`, Astro.site).toString();
const pathname = Astro.url.pathname;
const primary = [
  { href: BASE + 'processo', label: 'Processo', match: '/processo' },
  { href: BASE + 'publicacoes', label: 'Publicações', match: '/publicacoes' },
  { href: BASE + 'minhas-consultas', label: 'Salvos', match: '/minhas-consultas' },
  { href: BASE + 'agentes', label: 'Agentes', match: '/agentes' },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#17221f" />
    <!--
      Content-Security-Policy (#1613, TM-08 in docs/SECURITY_THREAT_MODEL.md).
      This is a fully static GitHub Pages build (astro.config.mjs:
      `output: 'static'`) — there is no server to send an HTTP response
      header, so this <meta> tag is the only delivery mechanism available.
      Per the CSP spec, `frame-ancestors`, `sandbox` and `report-uri`/
      `report-to` are silently ignored when delivered via <meta> and are
      deliberately omitted here rather than left in to look enforced.

      - script-src 'self' + build-time sha256 hashes, never 'unsafe-inline':
        the one former inline redirect script in advogados.astro/
        comparador.astro was removed in favor of the <meta http-equiv=
        "refresh"> already on those pages, but Astro's own client-hydration
        runtime (the astro-island bootstrap, the astro:transitions
        ClientRouter used below) still injects a handful of small inline
        <script> tags into every built page with a hydrated island —
        confirmed live: without an allowance for them, a real browser
        refuses them outright and ProcessoLookup.svelte never hydrates.
        `scripts/injectCspHashes.mjs` (run as `postbuild`, see
        web/package.json) rewrites every dist/**/*.html's script-src to add
        `'sha256-<hash>'` for each inline script's exact build output, so
        the allowlist can never drift out of sync with an Astro/Vite
        upgrade the way a hand-maintained hash list would.
      - style-src keeps 'unsafe-inline': Svelte's scoped-style mechanism
        (CLAUDE.md's CSS token boundary — Svelte components never use
        Panda's css(), only global CSS + a scoped <style> block) emits
        static <style> blocks and style="..." attributes directly into
        every server-rendered page. None of that is user-controlled:
        djen.ts's sanitizeHtml() (FORBID_TAGS: ["style"], FORBID_ATTR:
        ["style"]) means untrusted judicial text can never reach a <style>
        sink, so this is a bounded, reviewed exception — never extended to
        script-src.
      - connect-src / worker-src include https://cdn.jsdelivr.net because
        web/src/lib/duckdbSingleton.ts loads the DuckDB-WASM worker/module
        from the jsDelivr bundle CDN (`duckdb.getJsDelivrBundles()`), with a
        `blob:` worker fallback when direct Worker construction fails.
      - connect-src also allows the fixed set of official data hosts the
        app fetches from: archive.org (Internet Archive parquet/downloads),
        comunicaapi.pje.jus.br (DJEN public API) and the DJEN Cloud Run
        proxy fallback (djenClient.ts).
    -->
    <meta http-equiv="Content-Security-Policy" content={CSP_META_CONTENT} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CausaGanha" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BASE}apple-touch-icon.png`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir para o conteúdo principal</a>
    {showNetworkBanner && <NetworkStatusBanner />}

    <header class={css({ borderBottom: '1px solid', borderColor: 'border', background: 'canvas' })}>
      <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '4', sm: '0' }, minH: { sm: '20' }, display: 'grid', gridTemplateColumns: { base: '1fr', sm: 'auto 1fr' }, alignItems: 'center', gap: { base: '3', sm: '6' } })}>
        <a href={BASE} class={css({ display: 'inline-flex', alignItems: 'center', gap: '3', color: 'text', textDecoration: 'none', fontWeight: 'black', fontSize: 'xl', letterSpacing: '-0.04em' })}>
          <span class={css({ display: 'grid', placeItems: 'center', w: '10', h: '10', background: 'accent', border: '1px solid', borderColor: 'text', fontFamily: 'mono', fontSize: 'sm' })} aria-hidden="true">CG</span>
          <span>CausaGanha</span>
        </a>
        <nav class={css({ display: 'flex', alignItems: 'center', gap: { base: '3', md: '6' }, flexWrap: 'wrap', justifyContent: { base: 'space-between', sm: 'end' }, w: '100%' })} aria-label="Principal">
          {primary.map((link) => (
            <a class={navLink({ active: pathname.includes(link.match) })} href={link.href} aria-current={pathname.includes(link.match) ? 'page' : undefined}>{link.label}</a>
          ))}
          <details class={css({ position: 'relative' })}>
            <summary class={css({ cursor: 'pointer', listStyle: 'none', fontSize: 'xs', fontWeight: 'bold', letterSpacing: '0.06em', textTransform: 'uppercase' })}>Mais</summary>
            <div class={css({ position: 'absolute', right: '0', top: 'calc(100% + 0.75rem)', zIndex: '30', minW: '14rem', p: '3', background: 'surface', border: '1px solid', borderColor: 'text', display: 'grid', gap: '1', boxShadow: 'lift' })}>
              <a class={navLink()} href={BASE + 'stats'}>Cobertura</a>
              <a class={navLink()} href={BASE + 'sobre'}>Projeto & dados</a>
              <a class={navLink()} href="https://github.com/franklinbaldo/causaganha">GitHub ↗</a>
            </div>
          </details>
        </nav>
      </div>
    </header>

    <main id="main-content" class={fullWidth ? undefined : css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '16' } })}>
      <slot />
    </main>

    <footer class={css({ mt: '20', borderTop: '1px solid', borderColor: 'border', background: 'surfaceMuted' })}>
      <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: '10', display: 'grid', gridTemplateColumns: { base: '1fr', md: '1fr auto' }, gap: '8', alignItems: 'end' })}>
        <div>
          <p class={css({ textStyle: 'eyebrow', mb: '3' })}>CausaGanha</p>
          <p class={css({ m: '0', maxW: '42rem', color: 'text', lineHeight: 'body' })}>Consulta judicial pública com fontes oficiais, arquivo preservado e proveniência explícita.</p>
        </div>
        <nav class={css({ display: 'flex', flexWrap: 'wrap', gap: '5' })} aria-label="Rodapé">
          <a class={navLink()} href={BASE + 'processo'}>Processo</a>
          <a class={navLink()} href={BASE + 'publicacoes'}>Publicações</a>
          <a class={navLink()} href={BASE + 'agentes'}>Agentes</a>
          <a class={navLink()} href={BASE + 'sobre'}>Sobre</a>
        </nav>
      </div>
    </footer>
  </body>
</html>