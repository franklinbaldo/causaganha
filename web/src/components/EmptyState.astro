---
interface Props {
  title: string;
  message: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, message, actionHref, actionLabel } = Astro.props;
---

<article class="empty-state">
  <h3>{title}</h3>
  <p>{message}</p>
  {actionHref && actionLabel && (
    <a href={actionHref} role="button">{actionLabel}</a>
  )}
</article>

<style>
  .empty-state {
    text-align: center;
  }
</style>
