---
export interface Crumb {
  label: string;
  href?: string;
}

export interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

// Generate structured data
const breadcrumbList = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": crumbs.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.label,
    "item": crumb.href ? new URL(crumb.href, Astro.site).toString() : undefined
  }))
};
---

<nav class="breadcrumbs" aria-label="Trilha de navegação">
  <ul>
    {crumbs.map((crumb, index) => {
      const isLast = index === crumbs.length - 1;
      return (
        <li>
          {isLast || !crumb.href ? (
            <span class={isLast ? 'current' : ''} aria-current={isLast ? 'page' : undefined}>{crumb.label}</span>
          ) : (
            <a href={crumb.href}>{crumb.label}</a>
          )}
        </li>
      );
    })}
  </ul>
</nav>

<script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbList)} />

<style>
  .breadcrumbs {
    font-size: var(--font-size-sm);
    margin-bottom: 1rem;
  }

  .breadcrumbs ul {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumbs li + li::before {
    content: "/";
    opacity: 0.5;
    margin-right: 0.5rem;
  }

  .breadcrumbs a {
    color: var(--color-primary);
    text-decoration: none;
    transition: var(--transition-base);
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .current {
    font-weight: 500;
  }
</style>
