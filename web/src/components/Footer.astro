---
interface Props {
  class?: string;
}

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-brand">CausaGanha</p>
    <nav class="footer-links">
      <a href={BASE + 'publicacoes'} class="footer-link">Publicações</a>
      <a href={BASE + 'sobre'} class="footer-link">Termos</a>
      <a href={BASE + '#como-funciona'} class="footer-link">Contato</a>
      <a href={BASE + 'dados'} class="footer-link">Documentação</a>
    </nav>
    <p class="footer-tagline">&copy; {new Date().getFullYear()} CausaGanha &middot; Inspirado no modernismo brasileiro</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-base-200);
    color: var(--color-base-content);
    margin-top: var(--space-20, 5rem);
    padding: var(--space-10, 2.5rem) var(--space-4);
  }

  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .footer-brand {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    font-weight: 400;
    letter-spacing: 0;
    margin: 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .footer-link {
    text-decoration: none;
    color: var(--color-content-secondary);
    font-size: var(--font-size-sm);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  .footer-link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .footer-tagline {
    font-size: var(--font-size-xs);
    color: var(--color-content-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }
</style>
