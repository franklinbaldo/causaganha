---
---
<dialog
  id="command-palette-dialog"
  aria-labelledby="command-palette-title">
  <article>
    <header>
      <h3 id="command-palette-title">Atalhos de teclado</h3>
      <form method="dialog">
        <button
          id="command-palette-close"
          class="outline"
          aria-label="Fechar diálogo">
          ✕
        </button>
      </form>
    </header>

    <dl>
      <div>
        <dt>Abrir paleta de comandos / ajuda</dt>
        <dd>
          <kbd>Ctrl</kbd>
          +
          <kbd>K</kbd>
          ou
          <kbd>?</kbd>
        </dd>
      </div>

      <div>
        <dt>Fechar diálogos / dicas</dt>
        <dd><kbd>Esc</kbd></dd>
      </div>

      <div>
        <dt>Navegar mapa de calor</dt>
        <dd>
          <kbd>↑</kbd>
          <kbd>↓</kbd>
          <kbd>←</kbd>
          <kbd>→</kbd>
        </dd>
      </div>

      <div>
        <dt>Selecionar célula do mapa</dt>
        <dd><kbd>Enter</kbd></dd>
      </div>
    </dl>

    <footer>
      <small>O modo de acessibilidade está sempre ativo. Use Tab para navegar pelos elementos interativos.</small>
    </footer>
  </article>
</dialog>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement;
    const closeBtn = document.getElementById('command-palette-close');

    if (!dialog) return;

    function handleKeyDown(e: KeyboardEvent) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        const searchInput = document.getElementById('ia-search-input');
        if (searchInput && document.activeElement !== searchInput) {
          searchInput.focus();
        } else {
          toggleDialog();
        }
      } else if (e.key === '?' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName ?? '')) {
        e.preventDefault();
        toggleDialog();
      } else if (e.key === 'Escape' && dialog.open) {
        dialog.close();
      }
    }

    function toggleDialog() {
      if (dialog.open) {
        dialog.close();
      } else {
        dialog.showModal();
      }
    }

    document.addEventListener('keydown', handleKeyDown);

    if (closeBtn) {
      closeBtn.addEventListener('click', () => dialog.close());
    }

    // Cleanup logic for View Transitions
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', handleKeyDown);
    }, { once: true });
  }

  setupCommandPalette();
  document.addEventListener('astro:after-swap', setupCommandPalette);
</script>
