---
---
<dialog
  id="command-palette-dialog"
  class="modal"
  aria-labelledby="command-palette-title">
  <div class="modal-box">
    <h3 class="modal-title" id="command-palette-title">Keyboard Shortcuts</h3>
    <form method="dialog">
      <button
        id="command-palette-close"
        class="btn-close"
        aria-label="Close dialog">
        ✕
      </button>
    </form>

    <div class="shortcut-list">
      <div class="shortcut-row">
        <span>Open Command Palette / Help</span>
        <div class="shortcut-keys">
          <kbd class="kbd">Ctrl</kbd>
          <span>+</span>
          <kbd class="kbd">K</kbd>
          <span>or</span>
          <kbd class="kbd">?</kbd>
        </div>
      </div>

      <div class="shortcut-row">
        <span>Close Modals / Tooltips</span>
        <kbd class="kbd">Esc</kbd>
      </div>

      <div class="shortcut-row">
        <span>Navigate Heatmap</span>
        <div class="shortcut-keys">
          <kbd class="kbd">↑</kbd>
          <kbd class="kbd">↓</kbd>
          <kbd class="kbd">←</kbd>
          <kbd class="kbd">→</kbd>
        </div>
      </div>

      <div class="shortcut-row">
        <span>Select Heatmap Cell</span>
        <kbd class="kbd">Enter</kbd>
      </div>
    </div>

    <div class="modal-footer">
      <small class="footer-note">Accessibility mode is always active. Use Tab to navigate through all interactive elements.</small>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement;
    const closeBtn = document.getElementById('command-palette-close');

    if (!dialog) return;

    function handleKeyDown(e: KeyboardEvent) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        const searchInput = document.getElementById('ia-search-input');
        if (searchInput && document.activeElement !== searchInput) {
          searchInput.focus();
        } else {
          toggleDialog();
        }
      } else if (e.key === '?' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName ?? '')) {
        e.preventDefault();
        toggleDialog();
      } else if (e.key === 'Escape' && dialog.open) {
        dialog.close();
      }
    }

    function toggleDialog() {
      if (dialog.open) {
        dialog.close();
      } else {
        dialog.showModal();
      }
    }

    document.addEventListener('keydown', handleKeyDown);

    if (closeBtn) {
      closeBtn.addEventListener('click', () => dialog.close());
    }

    // Cleanup logic for View Transitions
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', handleKeyDown);
    }, { once: true });
  }

  setupCommandPalette();
  document.addEventListener('astro:after-swap', setupCommandPalette);
</script>

<style>
  /* Modal (native dialog) */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
  }

  .modal::backdrop {
    background: rgba(0, 0, 0, 0.5);
  }

  .modal:not([open]) {
    display: none;
  }

  .modal-box {
    position: relative;
    background: var(--color-base-100);
    border-radius: var(--radius-box);
    padding: var(--space-6, 1.5rem);
    max-width: 32rem;
    width: 90%;
    max-height: 80vh;
    overflow-y: auto;
    box-shadow: var(--shadow-md);
  }

  .modal-title {
    font-weight: 700;
    font-size: var(--font-size-lg);
    margin: 0;
  }

  .btn-close {
    position: absolute;
    right: var(--space-2, 0.5rem);
    top: var(--space-2, 0.5rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: transparent;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    font-size: var(--font-size-sm);
    color: var(--color-base-content);
  }

  .btn-close:hover {
    background: var(--color-base-200);
  }

  .modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
  }

  .modal-backdrop button {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: transparent;
    border: none;
    cursor: pointer;
    font-size: 0;
  }

  /* Shortcut list */
  .shortcut-list {
    padding: var(--space-4, 1rem) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }

  .shortcut-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--color-base-200);
    padding-bottom: var(--space-2, 0.5rem);
  }

  .shortcut-keys {
    display: flex;
    align-items: center;
    gap: var(--space-1, 0.25rem);
  }

  /* Kbd */
  .kbd {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.375rem;
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    background: var(--color-base-200);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-sm);
  }

  /* Footer */
  .modal-footer {
    display: flex;
    justify-content: flex-start;
    gap: var(--space-2, 0.5rem);
    margin-top: var(--space-4, 1rem);
  }

  .footer-note {
    color: var(--color-base-content);
    opacity: 0.7;
  }
</style>
