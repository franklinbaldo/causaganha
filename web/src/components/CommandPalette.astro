---
---
<dialog
  id="command-palette-dialog"
  class="modal"
  aria-labelledby="command-palette-title">
  <div class="modal-box">
    <h3 class="modal-title" id="command-palette-title">Atalhos de teclado</h3>
    <form method="dialog">
      <button
        id="command-palette-close"
        class="btn-close"
        aria-label="Fechar diálogo">
        ✕
      </button>
    </form>

    <div class="shortcut-list">
      <div class="shortcut-row">
        <span>Abrir paleta de comandos / ajuda</span>
        <div class="shortcut-keys">
          <kbd class="kbd">Ctrl</kbd>
          <span>+</span>
          <kbd class="kbd">K</kbd>
          <span>ou</span>
          <kbd class="kbd">?</kbd>
        </div>
      </div>

      <div class="shortcut-row">
        <span>Fechar diálogos / dicas</span>
        <kbd class="kbd">Esc</kbd>
      </div>

      <div class="shortcut-row">
        <span>Navegar mapa de calor</span>
        <div class="shortcut-keys">
          <kbd class="kbd">↑</kbd>
          <kbd class="kbd">↓</kbd>
          <kbd class="kbd">←</kbd>
          <kbd class="kbd">→</kbd>
        </div>
      </div>

      <div class="shortcut-row">
        <span>Selecionar célula do mapa</span>
        <kbd class="kbd">Enter</kbd>
      </div>
    </div>

    <div class="modal-footer">
      <small class="footer-note">O modo de acessibilidade está sempre ativo. Use Tab para navegar pelos elementos interativos.</small>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button aria-label="Fechar diálogo">fechar</button>
  </form>
</dialog>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement;
    const closeBtn = document.getElementById('command-palette-close');

    if (!dialog) return;

    function handleKeyDown(e: KeyboardEvent) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        const searchInput = document.getElementById('ia-search-input');
        if (searchInput && document.activeElement !== searchInput) {
          searchInput.focus();
        } else {
          toggleDialog();
        }
      } else if (e.key === '?' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName ?? '')) {
        e.preventDefault();
        toggleDialog();
      } else if (e.key === 'Escape' && dialog.open) {
        dialog.close();
      }
    }

    function toggleDialog() {
      if (dialog.open) {
        dialog.close();
      } else {
        dialog.showModal();
      }
    }

    document.addEventListener('keydown', handleKeyDown);

    if (closeBtn) {
      closeBtn.addEventListener('click', () => dialog.close());
    }

    // Cleanup logic for View Transitions
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', handleKeyDown);
    }, { once: true });
  }

  setupCommandPalette();
  document.addEventListener('astro:after-swap', setupCommandPalette);
</script>
