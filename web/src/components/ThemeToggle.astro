<button
  class="theme-toggle-btn"
  type="button"
  aria-label="Alternar tema"
  title="Alternar tema (claro/escuro)"
>
  <svg class="icon-sun" width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
  </svg>
  <svg class="icon-moon" width="18" height="18" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
  </svg>
</button>

<script>
  // Bind all .theme-toggle-btn instances on the page (desktop + mobile nav
  // both render a copy, so we query all of them rather than using getElementById).
  function setupThemeToggles() {
    document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn:not([data-bound])').forEach(btn => {
      btn.dataset.bound = '1';

      function isDark(): boolean {
        return document.documentElement.getAttribute('data-theme') === 'dark';
      }

      function syncLabel() {
        btn.setAttribute('aria-label', isDark() ? 'Mudar para modo claro' : 'Mudar para modo escuro');
      }

      syncLabel();

      btn.addEventListener('click', () => {
        const next = !isDark();
        document.documentElement.setAttribute('data-theme', next ? 'dark' : 'light');
        localStorage.setItem('causaganha-theme', next ? 'dark' : 'light');
        // Sync labels on all instances after any toggle
        document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn').forEach(b => {
          b.setAttribute('aria-label', next ? 'Mudar para modo claro' : 'Mudar para modo escuro');
        });
      });
    });
  }

  setupThemeToggles();
  document.addEventListener('astro:after-swap', setupThemeToggles);
</script>
