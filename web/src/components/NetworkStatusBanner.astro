---
---
<aside
  id="network-status-banner"
  role="alert"
  aria-live="assertive"
  hidden>

  <div id="ns-slow" hidden>
    <strong>Rede Lenta Detectada</strong>
    <small>O carregamento pode demorar mais que o normal. Usando dados em cache, se disponíveis.</small>
  </div>

  <div id="ns-retry" hidden>
    <strong>Problema de Conexão</strong>
    <small id="ns-retry-text"></small>
  </div>

  <div id="ns-error" hidden>
    <div>
      <strong>Falha na Rede</strong>
      <small>Não foi possível conectar ao servidor. Mostrando dados offline em cache.</small>
    </div>
    <button
      id="ns-retry-btn"
      type="button"
      class="outline"
      aria-label="Tentar reconectar rede agora">
      Tentar Novamente
    </button>
  </div>
</aside>

<script>
  function setupNetworkStatus() {
    const banner = document.getElementById('network-status-banner');
    const elSlow = document.getElementById('ns-slow');
    const elRetry = document.getElementById('ns-retry');
    const elRetryText = document.getElementById('ns-retry-text');
    const elError = document.getElementById('ns-error');
    const retryBtn = document.getElementById('ns-retry-btn');

    if (!banner || !elSlow || !elRetry || !elError || !elRetryText) return;

    let status = 'idle';
    let countdownInterval: number | null = null;
    let countdown = 0;
    let slowTimer: number | null = null;
    // Page load timestamp — slow-network events fired within 3 s of load are
    // treated as false positives (common on initial hydration / static renders).
    const loadedAt = Date.now();

    function hideAll() {
      elSlow!.hidden = true;
      elRetry!.hidden = true;
      elError!.hidden = true;
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
      }
      if (slowTimer) {
        clearTimeout(slowTimer);
        slowTimer = null;
      }
    }

    function updateView() {
      if (status === 'idle') {
        banner!.hidden = true;
        hideAll();
      } else {
        banner!.hidden = false;
        hideAll();
        if (status === 'slow') elSlow!.hidden = false;
        if (status === 'retrying') elRetry!.hidden = false;
        if (status === 'error') elError!.hidden = false;
      }
    }

    const handleSlow = () => {
      if (status === 'error' || status === 'retrying' || status === 'slow') return;
      const elapsed = Date.now() - loadedAt;
      if (elapsed < 3000) {
        // Debounce: only show after the page has been interactive for 3 s to
        // avoid false positives during initial hydration / static pre-renders.
        if (slowTimer) return;
        slowTimer = window.setTimeout(() => {
          slowTimer = null;
          if (status !== 'error' && status !== 'retrying' && status !== 'slow') {
            status = 'slow';
            updateView();
          }
        }, 3000 - elapsed);
      } else {
        status = 'slow';
        updateView();
      }
    };

    const handleRetry = (e: any) => {
      const detail = e.detail;
      status = 'retrying';
      countdown = detail.delay;

      const updateText = () => {
        elRetryText!.textContent = `Tentando novamente (tentativa ${detail.attempt}/${detail.maxRetries}) em ${Math.ceil(countdown / 1000)}s...`;
      };

      updateText();
      updateView();

      countdownInterval = window.setInterval(() => {
        countdown -= 1000;
        if (countdown <= 0) {
           clearInterval(countdownInterval!);
           countdownInterval = null;
        } else {
           updateText();
        }
      }, 1000);
    };

    const handleError = () => {
      status = 'error';
      updateView();
    };

    const handleSuccess = () => {
      status = 'idle';
      updateView();
    };

    window.addEventListener('cg-network-slow', handleSlow);
    window.addEventListener('cg-network-retry', handleRetry);
    window.addEventListener('cg-network-error', handleError);
    window.addEventListener('cg-network-success', handleSuccess);

    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        handleSuccess(); // Hide banner immediately
        window.dispatchEvent(new CustomEvent('cg-network-force-refresh'));
      });
    }

    // Cleanup
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('cg-network-slow', handleSlow);
      window.removeEventListener('cg-network-retry', handleRetry);
      window.removeEventListener('cg-network-error', handleError);
      window.removeEventListener('cg-network-success', handleSuccess);
      if (countdownInterval) clearInterval(countdownInterval);
      if (slowTimer) clearTimeout(slowTimer);
    }, { once: true });
  }

  setupNetworkStatus();
  document.addEventListener('astro:after-swap', setupNetworkStatus);
</script>
