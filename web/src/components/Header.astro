---
import ThemeToggle from './ThemeToggle.astro';
import ActivePipelineStatus from './ActivePipelineStatus.svelte';

interface Props {
  variant: 'home' | 'page';
  title?: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
  tile?: string;
}

const {
  variant,
  title,
  subtitle,
  backHref = import.meta.env.BASE_URL,
  backLabel = 'Voltar',
  tile,
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hasIconSlot = Astro.slots.has('icon');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === BASE.replace(/\/$/, '')) return currentPath === normalized;
  return currentPath.startsWith(normalized);
}

const primaryLinks = [
  { href: BASE + 'publicacoes', label: 'Jurisprudência' },
  { href: BASE + 'explorador', label: 'Explorador' },
  { href: BASE + 'sobre', label: 'Metodologia' },
  { href: BASE + 'dados', label: 'API' },
];

const ferramentasLinks = [
  { href: BASE + 'advogados', label: 'Advogados' },
  { href: BASE + 'comparador', label: 'Comparar tribunais' },
];

const recursosLinks = [
  { href: BASE + 'consultas', label: 'Consultas' },
  { href: BASE + 'dicionario', label: 'Entender esquema' },
  { href: BASE + 'changelog', label: 'Changelog' },
];

const ferramentasActive = [...ferramentasLinks, ...recursosLinks].some(l => isActive(l.href));
---

{variant === 'home' ? (
  <header class="site-header">
    <nav class="container">
      <ul>
        <li><a href={BASE} class="brand-link">CausaGanha</a></li>
      </ul>
      <ul class="desktop-nav">
        {primaryLinks.map(link => (
          <li>
            <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <details class="dropdown nav-dropdown">
            <summary aria-haspopup="true" class={ferramentasActive ? 'active' : ''}>Ferramentas</summary>
            <ul>
              {ferramentasLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
              <li class="dropdown-divider" role="separator"></li>
              {recursosLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li class="widget-li">
          <ActivePipelineStatus client:idle />
        </li>
        <li>
          <a href={BASE + 'publicacoes'} role="button" class="btn-enter">Entrar</a>
        </li>
        <li><ThemeToggle /></li>
      </ul>
      <!-- Mobile controls -->
      <ul class="mobile-nav">
        <li><ThemeToggle /></li>
        <li>
          <div class="drawer drawer-end">
            <input id="mobile-drawer-home" type="checkbox" class="drawer-toggle" />
            <div class="drawer-content">
              <label for="mobile-drawer-home" class="btn-menu" aria-label="Abrir menu de navegação">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                  <line x1="3" y1="12" x2="21" y2="12"></line>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
              </label>
            </div>
            <div class="drawer-side">
              <label for="mobile-drawer-home" aria-label="Fechar menu" class="drawer-overlay"></label>
              <ul class="drawer-menu">
                <li class="menu-title">Principal</li>
                {primaryLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
                <div class="divider-horizontal"></div>
                <li class="menu-title">Ferramentas</li>
                {ferramentasLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
                <div class="divider-horizontal"></div>
                <li class="menu-title">Recursos</li>
                {recursosLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      </ul>
    </nav>
  </header>
) : (
  <header class="site-header page-header">
    <nav class="container">
      <ul>
        <li>
          {hasIconSlot ? (
            <div class="icon-slot">
              <slot name="icon" />
            </div>
          ) : tile ? (
            <a href={backHref} aria-label={backLabel} class="tile-icon-link">
              <img src={`${BASE}tiles/${tile}.svg`} alt="" width="40" height="40" class="tile-icon" aria-hidden="true" />
            </a>
          ) : (
            <a href={backHref} aria-label={backLabel} class="btn-back">
              <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
              </svg>
            </a>
          )}
        </li>
        <li class="title-li">
          <div class="title-group">
            <h1 class="page-title"><slot name="title">{title}</slot></h1>
            {subtitle && <p class="page-subtitle">{subtitle}</p>}
            <slot name="subtitle" />
          </div>
        </li>
      </ul>
      <ul class="desktop-nav">
        <li class="widget-li">
          <ActivePipelineStatus client:idle />
        </li>
        {primaryLinks.map(link => (
          <li>
            <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <details class="dropdown nav-dropdown">
            <summary aria-haspopup="true" class={ferramentasActive ? 'active' : ''}>Ferramentas</summary>
            <ul>
              {ferramentasLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
              <li class="dropdown-divider" role="separator"></li>
              {recursosLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
        <li><ThemeToggle /></li>
      </ul>
      <!-- Mobile controls -->
      <ul class="mobile-nav">
        <li class="widget-li">
          <ActivePipelineStatus client:idle />
        </li>
        <li><ThemeToggle /></li>
        <li>
          <div class="drawer drawer-end">
            <input id="mobile-drawer-page" type="checkbox" class="drawer-toggle" />
            <div class="drawer-content">
              <label for="mobile-drawer-page" class="btn-menu" aria-label="Abrir menu de navegação">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                  <line x1="3" y1="12" x2="21" y2="12"></line>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
              </label>
            </div>
            <div class="drawer-side">
              <label for="mobile-drawer-page" aria-label="Fechar menu" class="drawer-overlay"></label>
              <ul class="drawer-menu">
                <li><a href={BASE}>Início</a></li>
                <div class="divider-horizontal"></div>
                <li class="menu-title">Principal</li>
                {primaryLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
                <div class="divider-horizontal"></div>
                <li class="menu-title">Ferramentas</li>
                {ferramentasLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
                <div class="divider-horizontal"></div>
                <li class="menu-title">Recursos</li>
                {recursosLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>
      </ul>
    </nav>
  </header>
)}

<script>
  // Close any open <details class="nav-dropdown"> on outside click or Escape.
  if (!(window as any).__navDropdownBound) {
    (window as any).__navDropdownBound = true;
    document.addEventListener('click', (e) => {
      const target = e.target as Element | null;
      const inside = target?.closest('details.nav-dropdown');
      document.querySelectorAll<HTMLDetailsElement>('details.nav-dropdown[open]').forEach(d => {
        if (d !== inside) d.open = false;
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const open = document.querySelector<HTMLDetailsElement>('details.nav-dropdown[open]');
      if (!open) return;
      open.open = false;
      open.querySelector<HTMLElement>('summary')?.focus();
    });
  }
</script>

<style>
  /* ── Site header wraps the nav ── */
  .site-header {
    background: var(--color-base-100);
    border-bottom: 1px solid var(--color-base-300);
  }

  /* Use Pico's own spacing variable to suppress block padding on the header */
  .site-header {
    --pico-block-spacing-vertical: 0;
  }

  .site-header nav {
    min-height: 4rem;
    align-items: center;
  }

  /* Override Pico's nav ul margin hacks — we want full control */
  .site-header nav > ul:first-of-type {
    margin-left: 0;
    flex-shrink: 0;
  }

  .site-header nav > ul:last-of-type {
    margin-right: 0;
  }

  /* Brand link */
  .brand-link {
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    font-weight: 400;
    text-decoration: none;
    color: var(--color-base-content);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }

  .brand-link:hover {
    background: var(--color-base-200);
    text-decoration: none;
  }

  /* Active nav link */
  nav a.active {
    font-weight: 600;
    background: var(--color-base-200);
  }

  /* Enter button (pill CTA in home nav) */
  .btn-enter {
    padding: 0.4rem 1.25rem;
    font-size: var(--font-size-sm);
    font-weight: 600;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-primary-content);
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: background var(--transition-base);
  }

  .btn-enter:hover,
  .btn-enter:focus-visible {
    background: var(--color-primary-hover);
    color: var(--color-primary-content);
    text-decoration: none;
  }

  /* Desktop/mobile nav visibility — higher specificity beats Pico's nav ul rule */
  .site-header nav > ul.desktop-nav {
    display: none;
    margin-right: 0;
  }

  .site-header nav > ul.mobile-nav {
    display: flex;
    align-items: center;
    margin-right: 0;
  }

  @media (min-width: 1024px) {
    .site-header nav > ul.desktop-nav {
      display: flex;
    }

    .site-header nav > ul.mobile-nav {
      display: none;
    }
  }

  /* Widget inline in nav */
  .widget-li {
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Nav dropdown — override Pico's form-like default summary with a link-like one */
  .nav-dropdown > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: var(--pico-nav-link-spacing-vertical) var(--pico-nav-link-spacing-horizontal);
    border-radius: var(--pico-border-radius);
    background: none;
    border: none;
    color: var(--color-base-content);
    font-size: inherit;
    cursor: pointer;
    height: auto;
  }

  .nav-dropdown > summary::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    opacity: 0.6;
    transition: transform var(--transition-base, 0.15s ease);
    display: inline-block;
    float: none;
    margin-inline-start: 0;
  }

  .nav-dropdown[open] > summary::after {
    transform: translateY(1px) rotate(225deg);
  }

  .nav-dropdown > summary:hover,
  .nav-dropdown > summary:focus-visible {
    background: var(--color-base-200);
  }

  .nav-dropdown > summary.active {
    background: var(--color-base-200);
    font-weight: 600;
  }

  /* Dropdown menu */
  .nav-dropdown > ul {
    right: 0;
    left: auto;
    min-width: 160px;
    background: var(--color-base-100);
    border: 1px solid var(--color-base-300);
    border-radius: 0 0 var(--radius-btn) var(--radius-btn);
    box-shadow: var(--shadow-lg);
    padding: var(--space-2);
  }

  .nav-dropdown > ul li a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-btn);
    font-size: var(--font-size-sm);
    text-decoration: none;
    color: var(--color-base-content);
  }

  .nav-dropdown > ul li a:hover {
    background: var(--color-base-200);
  }

  .dropdown-divider {
    height: 1px;
    background: var(--color-base-300);
    margin: var(--space-1) 0;
    padding: 0;
    list-style: none;
  }

  /* Drawer (mobile off-canvas) */
  .drawer {
    position: relative;
    width: auto;
  }

  .drawer-toggle {
    display: none;
  }

  .drawer-side {
    position: fixed;
    inset: 0;
    z-index: 99;
    transform: translateX(100%);
    transition: transform var(--transition-base, 0.2s ease);
    pointer-events: none;
  }

  .drawer-toggle:checked ~ .drawer-side {
    transform: translateX(0);
    pointer-events: auto;
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    cursor: pointer;
    display: block;
  }

  .drawer-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 20rem;
    background: var(--color-base-200);
    min-height: 100%;
    padding: var(--space-4);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    overflow-y: auto;
    z-index: 1;
    margin: 0;
  }

  .drawer-menu a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-btn);
    font-size: var(--font-size-sm);
    text-decoration: none;
    color: var(--color-base-content);
    display: block;
  }

  .drawer-menu a:hover {
    background: var(--color-base-300);
  }

  .drawer-menu a:focus-visible {
    background: var(--color-base-300);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .drawer-menu a.active {
    background: var(--color-base-300);
    font-weight: 600;
  }

  /* Menu section titles */
  .menu-title {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.5;
    padding: var(--space-2) var(--space-3);
    list-style: none;
  }

  .divider-horizontal {
    height: 1px;
    background: var(--color-base-300);
    margin: var(--space-2) 0;
  }

  /* Burger menu button */
  .btn-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: transparent;
    border: none;
    border-radius: var(--radius-btn);
    cursor: pointer;
    color: var(--color-base-content);
  }

  .btn-menu:hover {
    background: var(--color-base-200);
  }

  .btn-menu:focus-visible {
    background: var(--color-base-200);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Back button */
  .btn-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-2);
    background: transparent;
    border: none;
    border-radius: var(--radius-btn);
    cursor: pointer;
    color: var(--color-base-content);
    text-decoration: none;
  }

  @media (pointer: coarse) {
    .btn-back,
    .btn-menu {
      min-width: 44px;
      min-height: 44px;
    }
  }

  .btn-back:hover {
    background: var(--color-base-200);
  }

  .btn-back:focus-visible {
    background: var(--color-base-200);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Page header variant */
  .page-header {
    border-bottom: 1px solid var(--color-base-300);
    margin-bottom: var(--space-6);
  }

  .icon-slot {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    transition: opacity var(--transition-base);
  }

  .tile-icon-link:hover {
    opacity: 0.7;
  }

  .tile-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
  }

  .title-li {
    flex: 1;
  }

  .title-group {
    display: flex;
    flex-direction: column;
  }

  .page-title {
    font-size: var(--font-size-2xl);
    font-family: var(--font-serif);
    font-weight: 400;
    line-height: 1.25;
  }

  .page-subtitle {
    font-size: var(--font-size-xs);
    color: var(--color-base-content);
    opacity: 0.5;
    line-height: 1.25;
    margin: 0;
  }

  /* Override Pico's nav padding/margin on li */
  .site-header nav li {
    padding: 0;
  }
</style>
