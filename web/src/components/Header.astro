---
import ThemeToggle from './ThemeToggle.astro';
import ActivePipelineStatus from './ActivePipelineStatus.svelte';

interface Props {
  variant: 'home' | 'page';
  title?: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
  tile?: string;
}

const {
  variant,
  title,
  subtitle,
  backHref = import.meta.env.BASE_URL,
  backLabel = 'Voltar',
  tile,
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hasIconSlot = Astro.slots.has('icon');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === BASE.replace(/\/$/, '')) return currentPath === normalized;
  return currentPath.startsWith(normalized);
}

const primaryLinks = [
  { href: BASE + 'publicacoes', label: 'Jurisprudência' },
  { href: BASE + 'explorador', label: 'Explorador' },
  { href: BASE + 'sobre', label: 'Metodologia' },
  { href: BASE + 'dados', label: 'API' },
];

const ferramentasLinks = [
  { href: BASE + 'advogados', label: 'Advogados' },
  { href: BASE + 'comparador', label: 'Comparar tribunais' },
];

const recursosLinks = [
  { href: BASE + 'consultas', label: 'Consultas' },
  { href: BASE + 'dicionario', label: 'Entender esquema' },
  { href: BASE + 'changelog', label: 'Changelog' },
];
---

{variant === 'home' ? (
  <div class="navbar">
    <div class="navbar-start">
      <a href={BASE} class="brand-link">CausaGanha</a>
    </div>
    <div class="navbar-center desktop-only">
      <ul class="menu menu-horizontal">
        {primaryLinks.map(link => (
          <li>
            <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <details>
            <summary aria-haspopup="true">Ferramentas</summary>
            <ul class="dropdown-menu">
              {ferramentasLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
              <li class="dropdown-divider"></li>
              {recursosLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </div>
    <div class="navbar-end">
      <div class="desktop-only mr-2 widget-wrapper">
        <ActivePipelineStatus client:idle />
      </div>
      <a href={BASE + 'publicacoes'} class="btn btn-primary btn-enter desktop-only">Entrar</a>
      <ThemeToggle />
      <div class="drawer drawer-end mobile-only">
        <input id="mobile-drawer-home" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content">
          <label for="mobile-drawer-home" class="btn-menu" aria-label="Abrir menu de navegação">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </label>
        </div>
        <div class="drawer-side">
          <label for="mobile-drawer-home" aria-label="Fechar menu" class="drawer-overlay"></label>
          <ul class="drawer-menu">
            <li class="menu-title">Principal</li>
            {primaryLinks.map(link => (
              <li>
                <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                  {link.label}
                </a>
              </li>
            ))}
            <div class="divider-horizontal"></div>
            <li class="menu-title">Ferramentas</li>
            {ferramentasLinks.map(link => (
              <li>
                <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                  {link.label}
                </a>
              </li>
            ))}
            <div class="divider-horizontal"></div>
            <li class="menu-title">Recursos</li>
            {recursosLinks.map(link => (
              <li>
                <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
) : (
  <header class="page-header">
    <div class="navbar">
      <div class="navbar-start">
        {hasIconSlot ? (
          <div class="icon-slot">
            <slot name="icon" />
          </div>
        ) : tile ? (
          <a href={backHref} aria-label={backLabel} class="tile-icon-link">
            <img src={`${BASE}tiles/${tile}.svg`} alt="" width="40" height="40" class="tile-icon" aria-hidden="true" />
          </a>
        ) : (
          <a href={backHref} aria-label={backLabel} class="btn-back">
            <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </a>
        )}
        <div class="title-group">
          <h1 class="page-title"><slot name="title">{title}</slot></h1>
          {subtitle && <p class="page-subtitle">{subtitle}</p>}
          <slot name="subtitle" />
        </div>
      </div>
      <div class="navbar-end desktop-only">
        <div class="mr-2 widget-wrapper">
          <ActivePipelineStatus client:idle />
        </div>
        <ul class="menu menu-horizontal">
          {primaryLinks.map(link => (
            <li>
              <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <details>
              <summary aria-haspopup="true">Ferramentas</summary>
              <ul class="dropdown-menu">
                {ferramentasLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
                <li class="dropdown-divider"></li>
                {recursosLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        </ul>
        <div class="divider-vertical"></div>
        <ThemeToggle />
      </div>
      <div class="navbar-end-mobile mobile-only">
        <div class="mr-2 widget-wrapper">
          <ActivePipelineStatus client:idle />
        </div>
        <ThemeToggle />
        <div class="drawer drawer-end">
          <input id="mobile-drawer-page" type="checkbox" class="drawer-toggle" />
          <div class="drawer-content">
            <label for="mobile-drawer-page" class="btn-menu" aria-label="Abrir menu de navegação">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </label>
          </div>
          <div class="drawer-side">
            <label for="mobile-drawer-page" aria-label="Fechar menu" class="drawer-overlay"></label>
            <ul class="drawer-menu">
              <li><a href={BASE}>Início</a></li>
              <div class="divider-horizontal"></div>
              <li class="menu-title">Principal</li>
              {primaryLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
              <div class="divider-horizontal"></div>
              <li class="menu-title">Ferramentas</li>
              {ferramentasLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
              <div class="divider-horizontal"></div>
              <li class="menu-title">Recursos</li>
              {recursosLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>
)}

<style>
  /* Navbar */
  .navbar {
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-4);
    min-height: 4rem;
    background: var(--color-base-100);
    max-width: 1280px;
    margin: 0 auto;
  }

  .navbar-start {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .navbar-center {
    flex: 0;
  }

  .navbar-end {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
  }

  /* Brand link */
  .brand-link {
    background: transparent;
    border: none;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-serif);
    font-size: var(--font-size-lg);
    font-weight: 400;
    letter-spacing: 0;
    text-decoration: none;
    color: var(--color-base-content);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  .brand-link:hover {
    background: var(--color-base-200);
  }

  /* Enter button */
  .btn-enter {
    padding: 0.4rem 1.25rem;
    font-size: var(--font-size-sm);
    border-radius: var(--radius-full);
  }

  /* Menu */
  .menu {
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: var(--space-1);
  }

  .menu li {
    list-style: none;
  }

  .menu a,
  .menu summary {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-btn);
    font-size: var(--font-size-sm);
    text-decoration: none;
    color: var(--color-base-content);
    cursor: pointer;
  }

  .menu details summary {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    list-style: none;
  }

  .menu details summary::-webkit-details-marker {
    display: none;
  }

  .menu details summary::after {
    content: "";
    width: 0.5rem;
    height: 0.5rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    opacity: 0.6;
    transition: transform var(--transition-base, 0.15s ease);
  }

  .menu details[open] summary::after {
    transform: translateY(1px) rotate(225deg);
  }

  .menu a:hover,
  .menu summary:hover {
    background: var(--color-base-200);
  }

  .menu a.active {
    background: var(--color-base-200);
    font-weight: 600;
  }

  .menu-horizontal {
    flex-direction: row;
    align-items: center;
  }

  /* Dropdown menu (details/summary) */
  .menu details {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    right: 0;
    background: var(--color-base-100);
    border-radius: 0 0 var(--radius-btn) var(--radius-btn);
    padding: var(--space-2);
    z-index: 100;
    min-width: 160px;
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-base-300);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .dropdown-menu a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-btn);
    font-size: var(--font-size-sm);
    text-decoration: none;
    color: var(--color-base-content);
    display: block;
  }

  .dropdown-menu a:hover {
    background: var(--color-base-200);
  }

  .dropdown-divider {
    height: 1px;
    background: var(--color-base-300);
    margin: var(--space-1) 0;
    padding: 0;
  }

  /* Dividers */
  .divider-vertical {
    width: 1px;
    background: var(--color-base-300);
    align-self: stretch;
    margin: 0 var(--space-2);
  }

  .divider-horizontal {
    height: 1px;
    background: var(--color-base-300);
    margin: var(--space-2) 0;
  }

  /* Drawer (checkbox-based off-canvas) */
  .drawer {
    position: relative;
    width: auto;
  }

  .drawer-toggle {
    display: none;
  }

  .drawer-side {
    position: fixed;
    inset: 0;
    z-index: 99;
    transform: translateX(100%);
    transition: transform var(--transition-base, 0.2s ease);
    pointer-events: none;
  }

  .drawer-toggle:checked ~ .drawer-side {
    transform: translateX(0);
    pointer-events: auto;
  }

  .drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    cursor: pointer;
    display: block;
  }

  .drawer-menu {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: 20rem;
    background: var(--color-base-200);
    min-height: 100%;
    padding: var(--space-4);
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    overflow-y: auto;
    z-index: 1;
    margin: 0;
  }

  .drawer-menu a {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-btn);
    font-size: var(--font-size-sm);
    text-decoration: none;
    color: var(--color-base-content);
    display: block;
  }

  .drawer-menu a:hover {
    background: var(--color-base-300);
  }

  .drawer-menu a.active {
    background: var(--color-base-300);
    font-weight: 600;
  }

  /* Menu title */
  .menu-title {
    font-size: var(--font-size-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.5;
    padding: var(--space-2) var(--space-3);
    list-style: none;
  }

  /* Buttons */
  .btn-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    background: transparent;
    border: none;
    border-radius: var(--radius-btn);
    cursor: pointer;
    color: var(--color-base-content);
  }

  .btn-menu:hover {
    background: var(--color-base-200);
  }

  .btn-menu:focus-visible {
    background: var(--color-base-200);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-1) var(--space-2);
    background: transparent;
    border: none;
    border-radius: var(--radius-btn);
    cursor: pointer;
    color: var(--color-base-content);
    text-decoration: none;
  }

  .btn-back:hover {
    background: var(--color-base-200);
  }

  .btn-back:focus-visible {
    background: var(--color-base-200);
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* Page header variant */
  .page-header {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--space-4);
    border-bottom: 1px solid var(--color-base-300);
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
  }

  .page-header .navbar {
    padding-left: 0;
    padding-right: 0;
  }

  .icon-slot {
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tile-icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    overflow: hidden;
    flex-shrink: 0;
    transition: opacity var(--transition-base);
  }

  .tile-icon-link:hover {
    opacity: 0.7;
  }

  .tile-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
  }

  .title-group {
    display: flex;
    flex-direction: column;
  }

  .page-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    line-height: 1.25;
    margin: 0;
  }

  .page-subtitle {
    font-size: var(--font-size-xs);
    color: var(--color-base-content);
    opacity: 0.5;
    line-height: 1.25;
    margin: 0;
  }

  /* Responsive: desktop-only / mobile-only */
  .desktop-only {
    display: none;
  }

  .mobile-only {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .navbar-end-mobile {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 1024px) {
    .desktop-only {
      display: flex;
      align-items: center;
    }

    .mobile-only {
      display: none;
    }

    .navbar-end-mobile {
      display: none;
    }
  }

.mr-2 {
  margin-right: var(--space-2);
}

.widget-wrapper {
  flex-shrink: 0;
  white-space: nowrap;
}
</style>
