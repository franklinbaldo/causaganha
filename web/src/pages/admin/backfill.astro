---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ManifestStatus from '../../components/ManifestStatus.svelte';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title="Backfill — Admin — CausaGanha" description="Progresso de backfill e cobertura histórica do pipeline.">
  <Header variant="page" title="Manifest Status" subtitle="Cobertura do backup por tribunal e ano" backHref={BASE + 'admin'} backLabel="Admin" />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'Admin', href: BASE + 'admin' },
      { label: 'Backfill' }
    ]} />
    <ManifestStatus client:load />
  </div>
</Layout>
