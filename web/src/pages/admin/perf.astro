---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PerfDashboard from '../../components/PerfDashboard.svelte';
import TribunalCoverageHeatmap from '../../components/TribunalCoverageHeatmap.svelte';
import LatencyHeatmap from '../../components/LatencyHeatmap.svelte';
import ParquetDensityHeatmap from '../../components/ParquetDensityHeatmap.svelte';
import { readJson } from '../../lib/readJson';

interface LatencyEntry {
  date: string;
  latency_ms: number;
}
interface SlowestTribunal {
  tribunal: string;
  velocity_14d: number;
}
interface QualityScore {
  grade: string;
  [key: string]: unknown;
}
interface PerfMetrics {
  causaganha_collect_latency_ms?: LatencyEntry[];
  causaganha_upload_success_rate?: number;
  causaganha_backlog_pending_days?: number;
  causaganha_active_tribunals?: number;
  slowest_tribunals?: SlowestTribunal[];
}

const perfMetrics = readJson<PerfMetrics>('perf-metrics.json');
const qualityScores = readJson<Record<string, QualityScore>>('tribunal_quality_scores.json');
---

<Layout
  title="CausaGanha - Performance Dashboard"
  description="System health and performance metrics for the CausaGanha backfill pipeline."
>
  <Header
    variant="page"
    title="Performance Monitoring"
    subtitle="System latency, upload success rates, and tribunal data quality scores"
  />

  <div class="page-container space-y-6">
    <PerfDashboard client:idle perfMetrics={perfMetrics} qualityScores={qualityScores} />

    <div role="tablist" class="tabs tabs-bordered w-full sm:w-auto overflow-x-auto mb-4">
      <input type="radio" name="heatmap_tabs" role="tab" class="tab min-w-max" aria-label="Coverage Heatmap" checked="checked" />
      <div role="tabpanel" class="tab-content pt-4">
        <TribunalCoverageHeatmap client:idle />
      </div>

      <input type="radio" name="heatmap_tabs" role="tab" class="tab min-w-max" aria-label="Latency Heatmap" />
      <div role="tabpanel" class="tab-content pt-4">
        <LatencyHeatmap client:idle />
      </div>

      <input type="radio" name="heatmap_tabs" role="tab" class="tab min-w-max" aria-label="Parquet Density" />
      <div role="tabpanel" class="tab-content pt-4">
        <ParquetDensityHeatmap client:only="svelte" />
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: var(--space-md);
    padding-right: var(--space-md);
  }
</style>
