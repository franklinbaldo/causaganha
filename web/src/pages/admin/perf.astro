---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import PerfDashboard from '../../components/PerfDashboard.svelte';
import TribunalCoverageHeatmap from '../../components/TribunalCoverageHeatmap.svelte';
import LatencyHeatmap from '../../components/LatencyHeatmap.svelte';
import ParquetDensityHeatmap from '../../components/ParquetDensityHeatmap.svelte';
import { readJson } from '../../lib/readJson';

interface LatencyEntry {
  date: string;
  latency_ms: number;
}
interface SlowestTribunal {
  tribunal: string;
  velocity_14d: number;
}
interface QualityScore {
  grade: string;
  [key: string]: unknown;
}
interface PerfMetrics {
  causaganha_collect_latency_ms?: LatencyEntry[];
  causaganha_upload_success_rate?: number;
  causaganha_backlog_pending_days?: number;
  causaganha_active_tribunals?: number;
  slowest_tribunals?: SlowestTribunal[];
}

const perfMetrics = readJson<PerfMetrics>('perf-metrics.json');
const qualityScores = readJson<Record<string, QualityScore>>('tribunal_quality_scores.json');
---

<Layout
  title="Performance — Admin — CausaGanha"
  description="Saúde do sistema e métricas de performance do pipeline de backfill da CausaGanha."
>
  <Header
    variant="page"
    title="Monitoramento de Performance"
    subtitle="Latência do sistema, taxas de sucesso de upload e qualidade dos dados por tribunal"
  />

  <div class="container">
    <PerfDashboard client:visible perfMetrics={perfMetrics} qualityScores={qualityScores} />

    <details open>
      <summary>Mapa de cobertura</summary>
      <TribunalCoverageHeatmap client:visible />
    </details>

    <details>
      <summary>Mapa de latência</summary>
      <LatencyHeatmap client:visible />
    </details>

    <details>
      <summary>Densidade Parquet</summary>
      <ParquetDensityHeatmap client:only="svelte" />
    </details>
  </div>
</Layout>
