---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import JulesSessionStatus from '../../components/JulesSessionStatus.svelte';
import AuditLogExport from '../../components/AuditLogExport.svelte';
import PausedTribunals from '../../components/PausedTribunals.svelte';
import OmissionCost from '../../components/OmissionCost.svelte';
import { readJson } from '../../lib/readJson';

const backfillState = readJson<any>('cache/backfill_state.json');
const omissionStats = readJson<any>('cache/omission_stats.json');

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const adminPages = [
  { href: BASE + 'admin/backfill', title: 'Backfill Progress', description: 'Progresso de backfill e cobertura histórica' },
  { href: BASE + 'admin/perf', title: 'Performance Monitoring', description: 'Latência do sistema e taxas de sucesso de upload' },
  { href: BASE + 'admin/pr-gate', title: 'PR Gate', description: 'Explicação dos critérios de PR Gate' },
  { href: BASE + 'admin/quality', title: 'Data Quality', description: 'Score de qualidade por tribunal' },
];
---

<Layout title="Admin — CausaGanha" description="Painel de administração e monitoramento do CausaGanha.">
  <Header variant="page" title="Admin Dashboard" subtitle="Monitoramento interno e ferramentas do sistema" />

  <div class="container">
    <div class="admin-grid">

      <div class="admin-main">
        <h2>Painéis de Monitoramento</h2>
        <div class="pages-grid">
          {adminPages.map(page => (
            <a href={page.href} class="admin-page-link">
              <article>
                <strong>{page.title}</strong>
                <small>{page.description}</small>
              </article>
            </a>
          ))}
        </div>
      </div>

      <aside class="admin-sidebar">
        <h2>Jules Assistant</h2>
        <JulesSessionStatus client:idle />
      </aside>

    </div>

    <div class="bottom-section">
      <PausedTribunals data={backfillState} client:idle />
      <AuditLogExport client:only="svelte" />
      <OmissionCost omissionStats={omissionStats} client:idle />
    </div>
  </div>
</Layout>

<style>
  .admin-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .admin-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .pages-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  @media (min-width: 640px) {
    .pages-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .admin-page-link {
    text-decoration: none;
    display: block;
  }

  .admin-page-link article {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    height: 100%;
    transition: border-color 0.2s;
  }

  .admin-page-link:hover article {
    border-color: var(--pico-primary);
  }

  .admin-page-link article small {
    opacity: 0.7;
    font-size: var(--font-size-sm);
  }

  .bottom-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    margin-bottom: var(--space-xl);
  }
</style>
