---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AuditLogExport from '../../components/AuditLogExport.svelte';
import PausedTribunals from '../../components/PausedTribunals.svelte';
import OmissionCost from '../../components/OmissionCost.svelte';
import { readJson } from '../../lib/readJson';

const backfillState = readJson<any>('cache/backfill_state.json');
const omissionStats = readJson<any>('cache/omission_stats.json');

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const adminPages = [
  { href: BASE + 'admin/backfill', title: 'Backfill Progress', description: 'Progresso de backfill e cobertura histórica' },
  { href: BASE + 'admin/perf', title: 'Performance Monitoring', description: 'Latência do sistema e taxas de sucesso de upload' },
  { href: BASE + 'admin/pr-gate', title: 'PR Gate', description: 'Explicação dos critérios de PR Gate' },
  { href: BASE + 'admin/quality', title: 'Data Quality', description: 'Score de qualidade por tribunal' },
];
---

<Layout title="Admin — CausaGanha" description="Painel de administração e monitoramento do CausaGanha.">
  <Header variant="page" title="Admin Dashboard" subtitle="Monitoramento interno e ferramentas do sistema" backHref={BASE} backLabel="Início" />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'Admin' }
    ]} />

    <div class="auto-grid">
      {adminPages.map(page => (
        <a href={page.href} class="admin-nav-card">
          <strong>{page.title}</strong>
          <small>{page.description}</small>
        </a>
      ))}
    </div>

    <div class="stack" style="margin-top: var(--space-lg);">
      <PausedTribunals data={backfillState} client:idle />
      <AuditLogExport client:only="svelte" />
      <OmissionCost omissionStats={omissionStats} client:idle />
    </div>
  </div>
</Layout>

<style>
  .admin-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-box);
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-content);
    transition: background var(--transition-base), border-color var(--transition-base);
  }

  .admin-nav-card:hover {
    background: var(--color-base-200);
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .admin-nav-card strong {
    font-size: var(--font-size-base);
    font-weight: 600;
  }

  .admin-nav-card small {
    color: var(--color-content-tertiary);
    font-size: var(--font-size-sm);
  }

</style>
