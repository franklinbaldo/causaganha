---
import Layout from '../layouts/Layout.astro';
import { loadContract } from '../lib/data';
import {
  loadSiteStatus,
  evaluateSourceFreshness,
  freshnessDisplayLabel,
  formatUtcDateTime,
  utcDateTimeAttr,
  pctOfTotal,
} from '../lib/data/siteStatus';
import TribunalCoverageExplorer from '../components/TribunalCoverageExplorer.svelte';
import { css } from '../../styled-system/css';
import { alert, badge, card, table } from '../../styled-system/recipes';

const siteStatus = await loadSiteStatus();
const djen = siteStatus.sources.djen;
const statsCoverage = await loadContract('stats_coverage');
const courtReliability = (await loadContract('court_reliability')) ?? [];
const weeklyPattern = (await loadContract('weekly_pattern')) ?? [];
const tribunalCoverage = (await loadContract('tribunal_coverage')) ?? [];
const generatedAtLabel = formatUtcDateTime(siteStatus.generated_at) ?? 'desconhecido';

// #1191: the drill-down island (client:only) only ever needs one tribunal's
// days at a time. It used to receive the whole tribunal_calendar contract
// (every tribunal x date in the archive) as a prop — client:only still
// serializes its props into the page for hydration, so that shipped the
// entire contract to every /stats visitor. scripts/render_queries.py now
// splits tribunal_calendar.json into one small file per tribunal at the same
// time it renders the canonical contract (before this build even starts);
// the island fetches only the tribunal it needs — see
// web/src/lib/tribunalCalendarPartition.ts.

const BASE = import.meta.env.BASE_URL;
const explorerTribunals = [...new Set(tribunalCoverage.map(t => t.tribunal))].sort();
const explorerEnd = (siteStatus.generated_at ?? new Date().toISOString()).slice(0, 10);
const explorerStartDate = new Date(`${explorerEnd}T00:00:00Z`);
explorerStartDate.setUTCDate(explorerStartDate.getUTCDate() - 29);
const explorerStart = explorerStartDate.toISOString().slice(0, 10);
const explorerDefaultTribunal = explorerTribunals[0] ?? '';
const generatedAtIso = utcDateTimeAttr(siteStatus.generated_at);

const totalTribunals = djen.tribunals_total;
const djenFreshness = evaluateSourceFreshness(djen, Date.now());
const freshnessLabel = freshnessDisplayLabel(djenFreshness);
const lastAttempt = formatUtcDateTime(djen.last_attempt_at);
const lastSuccess = formatUtcDateTime(djen.last_success_at);
const avgCoverage30 = statsCoverage?.avg_coverage ?? 0;
const bestCount = statsCoverage?.best_count ?? 0;
const bestDay = statsCoverage?.best_day ?? null;
const worstCount = statsCoverage?.worst_count ?? 0;
const worstDay = statsCoverage?.worst_day ?? null;
const avgCoverage30Pct = pctOfTotal(avgCoverage30, totalTribunals);
const top5 = courtReliability.slice(0, 5);
const bottom5 = [...courtReliability].sort((a, b) => a.rate - b.rate || b.total - a.total).slice(0, 5);
const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyPattern.find(w => w.day_idx === idx));
const lowestDay = [...weeklyPattern].filter(w => w.days_count > 0 && w.avg > 0).sort((a, b) => a.avg - b.avg)[0] ?? null;
---

<Layout
  title="Cobertura — CausaGanha"
  description="Cobertura histórica do arquivo DJEN, confiabilidade por tribunal e lacunas observáveis."
  fullWidth={true}
  showNetworkBanner={false}
>
  <section class={css({ background: 'surfaceMuted', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' } })}>
      <span class={badge({ tone: 'info' })}>Cobertura · DJEN</span>
      <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '5', maxW: '11ch' })}>O que o arquivo realmente cobre.</h1>
      <p class={css({ mt: '6', mb: '0', maxW: '52rem', color: 'textMuted', fontSize: 'lg', lineHeight: 'body' })}>
        Estes indicadores descrevem o acervo observado. Eles ajudam a separar ausência de publicação, lacuna de coleta e cobertura efetivamente preservada.
      </p>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' } })}>
    <div class={css({ display: 'flex', alignItems: 'end', justifyContent: 'space-between', gap: '6', flexWrap: 'wrap', mb: '6' })}>
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '2' })}>Últimos 30 dias</p>
        <h2 class={css({ textStyle: 'title', m: '0' })}>Resumo do arquivo</h2>
      </div>
      <span class={badge({ tone: djenFreshness.freshness === 'atualizado' ? 'accent' : 'attention' })}>{freshnessLabel}</span>
    </div>

    <div class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: 'repeat(3, 1fr)' }, gap: '4' })}>
      <article class={card()}>
        <p class={css({ textStyle: 'eyebrow', mb: '4' })}>Média diária</p>
        <strong class={css({ display: 'block', fontSize: '2xl', lineHeight: 'heading' })}>{avgCoverage30Pct.toFixed(1)}%</strong>
        <span class={css({ display: 'block', mt: '2', color: 'textMuted', fontSize: 'sm' })}>{avgCoverage30.toFixed(1)} de {totalTribunals} tribunais</span>
      </article>
      <article class={card({ tone: 'muted' })}>
        <p class={css({ textStyle: 'eyebrow', mb: '4' })}>Melhor dia</p>
        <strong class={css({ display: 'block', fontSize: '2xl', lineHeight: 'heading' })}>{bestCount} / {totalTribunals}</strong>
        <span class={css({ display: 'block', mt: '2', color: 'textMuted', fontSize: 'sm' })}>{bestDay ?? '—'}</span>
      </article>
      <article class={card({ tone: 'attention' })}>
        <p class={css({ textStyle: 'eyebrow', mb: '4' })}>Pior dia</p>
        <strong class={css({ display: 'block', fontSize: '2xl', lineHeight: 'heading' })}>{worstCount} / {totalTribunals}</strong>
        <span class={css({ display: 'block', mt: '2', color: 'text', fontSize: 'sm' })}>{worstDay ?? '—'}</span>
      </article>
    </div>

    <p class={css({ mt: '4', mb: '0', color: 'textMuted', fontFamily: 'mono', fontSize: 'xs' })}>
      Última tentativa: {lastAttempt ?? 'desconhecida'} · último sucesso: {lastSuccess ?? 'desconhecido'}
    </p>
  </section>

  <section class={css({ background: 'text', color: 'canvas' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '16' } })}>
      <p class={css({ textStyle: 'eyebrow', color: 'accent', mb: '3' })}>Regularidade</p>
      <h2 class={css({ textStyle: 'title', color: 'canvas', m: '0', mb: '8' })}>Tribunais mais e menos regulares</h2>
      <div class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: '1fr 1fr' }, gap: '4' })}>
        <article class={card({ tone: 'dark' })}>
          <h3 class={css({ mt: '0', mb: '5' })}>Maior regularidade</h3>
          <ol class={css({ m: '0', pl: '6', display: 'grid', gap: '3' })}>
            {top5.length ? top5.map(c => <li><strong>{c.court}</strong> <span class={css({ color: 'accent', fontFamily: 'mono' })}>{(c.rate * 100).toFixed(1)}%</span></li>) : <li>Sem dados suficientes</li>}
          </ol>
        </article>
        <article class={card({ tone: 'dark' })}>
          <h3 class={css({ mt: '0', mb: '5' })}>Menor regularidade</h3>
          <ol class={css({ m: '0', pl: '6', display: 'grid', gap: '3' })}>
            {bottom5.length ? bottom5.map(c => <li><strong>{c.court}</strong> <span class={css({ color: 'attention', fontFamily: 'mono' })}>{(c.rate * 100).toFixed(1)}%</span></li>) : <li>Sem dados suficientes</li>}
          </ol>
        </article>
      </div>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' } })}>
    <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '3' })}>Padrão semanal</p>
    <div class={css({ display: 'grid', gridTemplateColumns: { base: 'repeat(2, 1fr)', md: 'repeat(7, 1fr)' }, gap: '2', mb: '12' })}>
      {displayWeekly.map(w => {
        if (!w) return null;
        const isLowest = lowestDay && w.day_idx === lowestDay.day_idx;
        return (
          <article class={card({ tone: isLowest ? 'attention' : 'plain' })}>
            <span class={css({ textStyle: 'eyebrow' })}>{w.name.slice(0, 3)}</span>
            <strong class={css({ display: 'block', mt: '3', fontSize: 'xl' })}>{pctOfTotal(w.avg, totalTribunals).toFixed(0)}%</strong>
          </article>
        );
      })}
    </div>

    <div class={css({ display: 'flex', alignItems: 'end', justifyContent: 'space-between', gap: '6', flexWrap: 'wrap', mb: '5' })}>
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '2' })}>Manifesto canônico</p>
        <h2 class={css({ textStyle: 'title', m: '0' })}>Cobertura por tribunal</h2>
      </div>
      <small class={css({ color: 'textMuted', fontFamily: 'mono', fontSize: 'xs' })}>
        Gerado em {generatedAtIso ? <time datetime={generatedAtIso}>{generatedAtLabel}</time> : generatedAtLabel}
      </small>
    </div>

    {tribunalCoverage.length > 0 ? (
      <div class={css({ overflowX: 'auto', border: '1px solid', borderColor: 'border', background: 'surface' })} tabindex="0" aria-label="Tabela de cobertura rolável">
        <table class={table({ density: 'compact' })}>
          <thead><tr><th>Tribunal</th><th>ZIPs IA</th><th>Pendente</th><th>Ausente</th><th>Desconhecido</th><th>Cobertura</th><th>Período</th></tr></thead>
          <tbody>
            {tribunalCoverage.map(t => (
              <tr>
                <td><strong>{t.tribunal}</strong></td>
                <td>{t.uploaded.toLocaleString('pt-BR')}</td>
                <td>{t.pending.toLocaleString('pt-BR')}</td>
                <td>{t.absent.toLocaleString('pt-BR')}</td>
                <td>{t.unknown ? t.unknown.toLocaleString('pt-BR') : '—'}</td>
                <td><strong>{t.coverage_pct ?? 0}%</strong></td>
                <td>{t.earliest_upload ? `${t.earliest_upload} → ${t.latest_upload ?? '—'}` : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class={alert({ tone: 'attention' })}><strong>Dados de cobertura indisponíveis.</strong><span>O contrato `tribunal_coverage` não foi renderizado neste build.</span></div>
    )}
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' } })}>
    <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '2' })}>Explorar</p>
    <h2 class={css({ textStyle: 'title', m: '0', mb: '5' })}>Cobertura por tribunal e período</h2>
    <p class={css({ mt: '0', mb: '6', color: 'textMuted', maxW: '52rem' })}>
      Escolha um tribunal e um período para ver quantos dias estão preservados (arquivados no Internet Archive) e quantos têm ausência de publicação confirmada, segundo o calendário canônico. Dias sem linha no calendário aparecem como sem evidência — nunca como ausência.
    </p>
    {explorerTribunals.length > 0 ? (
      <div class={css({ border: '1px solid', borderColor: 'border', background: 'surface', p: { base: '4', md: '6' } })}>
        <TribunalCoverageExplorer
          client:only="svelte"
          tribunals={explorerTribunals}
          publicBase={BASE}
          initialTribunal={explorerDefaultTribunal}
          initialStart={explorerStart}
          initialEnd={explorerEnd}
        />
      </div>
    ) : (
      <div class={alert({ tone: 'attention' })}><strong>Sem tribunais para explorar.</strong><span>O contrato `tribunal_coverage` não foi renderizado neste build.</span></div>
    )}
  </section>
</Layout>
