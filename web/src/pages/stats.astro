---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StatCard from '../components/StatCard.astro';
import EmptyState from '../components/EmptyState.svelte';
import { loadContract } from '../lib/data';
import {
  loadSiteStatus,
  evaluateSourceFreshness,
  freshnessDisplayLabel,
  formatUtcDateTime,
  pctOfTotal,
} from '../lib/data/siteStatus';

// All aggregations come from .qmd query contracts rendered against the manifest.
// See web/src/queries/{stats_coverage,court_reliability,weekly_pattern}.qmd
// Files are generated by `scripts/render_queries.py` (CI) — missing in fresh
// local checkouts, so the loader returns null and the UI degrades to empty.
// Present-but-invalid JSON fails the build (Zod validation in lib/data).
// Global metrics (tribunal count, freshness) come from the mandatory
// site-status.json artifact — no hardcoded fallbacks.
const siteStatus = await loadSiteStatus();
const djen = siteStatus.sources.djen;
const statsCoverage = await loadContract('stats_coverage');
const courtReliability = (await loadContract('court_reliability')) ?? [];
const weeklyPattern = (await loadContract('weekly_pattern')) ?? [];
// Cobertura por tribunal: contrato canônico tribunal_coverage, renderizado do
// mesmo sync-manifest.parquet que o site-status. Substitui o antigo
// componente ManifestStatus, que buscava manifest-summary.json direto do IA
// em runtime — um snapshot paralelo que historicamente divergia do manifesto
// canônico (ver web/src/queries/site_status.qmd). A visão "por ano" do
// componente antigo não tem equivalente canônico ainda; se voltar, deve
// nascer como um novo contrato .qmd, não de um snapshot paralelo.
const tribunalCoverage = (await loadContract('tribunal_coverage')) ?? [];
const generatedAtLabel = formatUtcDateTime(siteStatus.generated_at) ?? 'desconhecido';

function coverageTone(pct: number): string {
  if (pct >= 80) return 'success';
  if (pct >= 40) return 'warning';
  if (pct > 0) return 'error';
  return 'muted';
}

const totalTribunals = djen.tribunals_total;
// Frescor derivado do último SUCESSO (não da última tentativa) — falhas
// contínuas aparecem como "Atrasado — tentativas recentes falhando".
const djenFreshness = evaluateSourceFreshness(djen, Date.now());
const freshnessLabel = freshnessDisplayLabel(djenFreshness);
const lastAttempt = formatUtcDateTime(djen.last_attempt_at);
const lastSuccess = formatUtcDateTime(djen.last_success_at);
const avgCoverage30 = statsCoverage?.avg_coverage ?? 0;
const bestCount = statsCoverage?.best_count ?? 0;
const bestDay = statsCoverage?.best_day ?? null;
const worstCount = statsCoverage?.worst_count ?? 0;
const worstDay = statsCoverage?.worst_day ?? null;
// pctOfTotal guarda contra totalTribunals = 0 (stub de CI) — nunca NaN%.
const avgCoverage30Pct = pctOfTotal(avgCoverage30, totalTribunals);
const top5 = courtReliability.slice(0, 5);
const bottom5 = [...courtReliability].sort((a, b) => a.rate - b.rate || b.total - a.total).slice(0, 5);

const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyPattern.find(w => w.day_idx === idx));
const lowestDay = [...weeklyPattern].filter(w => w.days_count > 0 && w.avg > 0).sort((a, b) => a.avg - b.avg)[0] ?? null;

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Indicadores — CausaGanha"
  description="Análise de cobertura histórica e confiabilidade dos tribunais."
  showNetworkBanner={false}
>
  <PageHeader
    title="Indicadores"
    subtitle="Análise de cobertura histórica e confiabilidade"
    tile="stats"
    backHref={base}
    backLabel="Voltar para o Início"
  />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: base },
      { label: 'Indicadores' }
    ]} />

    <!-- Coverage Overview -->
    <article>
      <header>
        <strong>Resumo de Cobertura</strong>
        <small data-tone="muted">Últimos 30 dias · Fonte DJEN: {freshnessLabel} — última tentativa {lastAttempt ?? 'desconhecida'} · último sucesso {lastSuccess ?? 'desconhecido'}</small>
      </header>
      <div class="auto-grid">
        <StatCard
          title="Média de Coleta"
          value={`${avgCoverage30Pct.toFixed(1)}%`}
          subtitle={`${avgCoverage30.toFixed(1)} / ${totalTribunals} tribunais por dia`}
        />
        <StatCard
          title="Melhor Dia"
          value={`${bestCount} / ${totalTribunals}`}
          subtitle={bestDay ?? '--'}
          tone="success"
        />
        <StatCard
          title="Pior Dia"
          value={`${worstCount} / ${totalTribunals}`}
          subtitle={worstDay ?? '--'}
          tone="warning"
        />
      </div>
    </article>

    <!-- Court Rankings -->
    <div class="auto-grid">
      <article>
        <header><strong>Top 5 Mais Confiáveis</strong></header>
        {top5.length > 0 ? (
          <ol>
            {top5.map(c => (
              <li>
                <strong>{c.court}</strong>
                <mark data-tone="success">{(c.rate * 100).toFixed(1)}%</mark>
              </li>
            ))}
          </ol>
        ) : (
          <p class="meta-text">Sem dados suficientes</p>
        )}
      </article>

      <article>
        <header><strong>Top 5 Mais Falhas</strong></header>
        {bottom5.length > 0 ? (
          <ol>
            {bottom5.map(c => (
              <li>
                <strong>{c.court}</strong>
                <mark data-tone="error">{(c.rate * 100).toFixed(1)}%</mark>
              </li>
            ))}
          </ol>
        ) : (
          <p class="meta-text">Sem dados suficientes</p>
        )}
      </article>
    </div>

    <!-- Weekly Pattern -->
    <article>
      <header>
        <h3>Padrão Semanal</h3>
        <p><small>Média de cobertura por dia da semana</small></p>
      </header>
      <div class="auto-grid">
        {displayWeekly.map(w => {
          if (!w) return null;
          const isLowest = lowestDay && w.day_idx === lowestDay.day_idx;
          const avgPct = pctOfTotal(w.avg, totalTribunals);
          return (
            <article>
              <header><strong>{w.name.slice(0, 3)}</strong></header>
              <div class="stat-value" data-tone={isLowest ? 'error' : undefined}>
                {avgPct.toFixed(0)}%
              </div>
              <small data-tone="muted">{w.avg.toFixed(1)} / {totalTribunals}</small>
              {isLowest && <mark data-tone="error">Menor</mark>}
            </article>
          );
        })}
      </div>
    </article>

    <!-- Per-tribunal coverage from the canonical tribunal_coverage contract -->
    <article>
      <header>
        <strong>Cobertura por tribunal</strong>
        <small data-tone="muted">Contrato tribunal_coverage, renderizado do manifesto canônico (sync-manifest.parquet) · gerado em {generatedAtLabel}</small>
      </header>
      {tribunalCoverage.length > 0 ? (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Tribunal</th>
                <th>ZIPs no IA</th>
                <th>Pendente</th>
                <th>Ausente</th>
                <th>Desconhecido</th>
                <th>Cobertura</th>
                <th>Período arquivado</th>
              </tr>
            </thead>
            <tbody>
              {tribunalCoverage.map(t => {
                const pct = t.coverage_pct ?? 0;
                return (
                  <tr>
                    <td><strong>{t.tribunal}</strong></td>
                    <td><code>{t.uploaded.toLocaleString('pt-BR')}</code></td>
                    <td data-tone="warning"><code>{t.pending.toLocaleString('pt-BR')}</code></td>
                    <td data-tone="muted"><code>{t.absent.toLocaleString('pt-BR')}</code></td>
                    <td data-tone={t.unknown ? 'error' : undefined}><code>{t.unknown ? t.unknown.toLocaleString('pt-BR') : ''}</code></td>
                    <td>
                      <progress value={pct} max="100" data-tone={coverageTone(pct)} aria-label={`${t.tribunal}: ${pct}%`}></progress>
                      <span data-tone={coverageTone(pct)}>{pct}%</span>
                    </td>
                    <td>
                      {t.earliest_upload ? (
                        <small>{t.earliest_upload} → {t.latest_upload}</small>
                      ) : (
                        <span data-tone="muted">—</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      ) : (
        <EmptyState
          title="Dados de cobertura indisponíveis"
          message="O contrato tribunal_coverage ainda não foi renderizado neste build — rode `uv run python scripts/render_queries.py` para gerar web/public/data/tribunal_coverage.json a partir do manifesto canônico."
        />
      )}
    </article>
  </div>
</Layout>
