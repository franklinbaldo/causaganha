---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import totals from '../../public/data/totals.json';
import statsCoverage from '../../public/data/stats_coverage.json';
import courtReliability from '../../public/data/court_reliability.json';
import weeklyPattern from '../../public/data/weekly_pattern.json';

// All aggregations come from .qmd query contracts rendered against the manifest.
// See web/src/queries/{stats_coverage,court_reliability,weekly_pattern}.qmd
const totalTribunals = totals.tribunals_total ?? 1;
const { avg_coverage: avgCoverage30, best_count: bestCount, best_day: bestDay, worst_count: worstCount, worst_day: worstDay } = statsCoverage;
const avgCoverage30Pct = (avgCoverage30 / totalTribunals) * 100;
const top5 = courtReliability.slice(0, 5);
const bottom5 = [...courtReliability].sort((a, b) => a.rate - b.rate || b.total - a.total).slice(0, 5);

const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyPattern.find(w => w.day_idx === idx));
const lowestDay = [...weeklyPattern].filter(w => w.days_count > 0 && w.avg > 0).sort((a, b) => a.avg - b.avg)[0] ?? null;

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Indicadores — CausaGanha"
  description="Análise de cobertura histórica e confiabilidade dos tribunais."
>
  <Header
    variant="page"
    title="Indicadores"
    subtitle="Análise de cobertura histórica e confiabilidade"
    tile="stats"
    backHref={base}
    backLabel="Voltar para o Início"
  />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: base },
      { label: 'Indicadores' }
    ]} />

    <!-- Coverage Overview -->
    <div class="card section-card">
      <div class="card-body">
        <div class="card-header">
          <strong>Resumo de Cobertura</strong>
          <small class="muted">Últimos 30 dias</small>
        </div>
        <div class="coverage-grid">
          <figure>
            <div class="stat-value">{avgCoverage30Pct.toFixed(1)}<small class="stat-unit">%</small></div>
            <figcaption>Média de Coleta</figcaption>
            <small class="muted">{avgCoverage30.toFixed(1)} / {totalTribunals} tribunais por dia</small>
          </figure>
          <figure>
            <div class="stat-value color-success">{bestCount}<small class="stat-fraction"> / {totalTribunals}</small></div>
            <figcaption>Melhor Dia</figcaption>
            <small class="muted">{bestDay ?? '--'}</small>
          </figure>
          <figure>
            <div class="stat-value color-error">{worstCount}<small class="stat-fraction"> / {totalTribunals}</small></div>
            <figcaption>Pior Dia</figcaption>
            <small class="muted">{worstDay ?? '--'}</small>
          </figure>
        </div>
      </div>
    </div>

    <!-- Court Rankings -->
    <div class="rankings-grid">
      <div class="card">
        <div class="card-body">
          <div class="card-section-header">
            <strong>Top 5 Mais Confiáveis</strong>
          </div>
          {top5.length > 0 ? (
            <div class="table-responsive">
              <table class="ranking-table">
                <thead class="sr-only">
                  <tr>
                    <th scope="col">Posição</th>
                    <th scope="col">Tribunal</th>
                    <th scope="col">Taxa de cobertura</th>
                  </tr>
                </thead>
                <tbody>
                  {top5.map((c, i) => (
                    <tr>
                      <td><span class="rank-num">{i + 1}</span></td>
                      <td><strong>{c.court}</strong></td>
                      <td class="cell-success cell-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="empty-text">Sem dados suficientes</p>
          )}
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <div class="card-section-header">
            <strong>Top 5 Mais Falhas</strong>
          </div>
          {bottom5.length > 0 ? (
            <div class="table-responsive">
              <table class="ranking-table">
                <thead class="sr-only">
                  <tr>
                    <th scope="col">Posição</th>
                    <th scope="col">Tribunal</th>
                    <th scope="col">Taxa de cobertura</th>
                  </tr>
                </thead>
                <tbody>
                  {bottom5.map((c, i) => (
                    <tr>
                      <td><span class="rank-num">{i + 1}</span></td>
                      <td><strong>{c.court}</strong></td>
                      <td class="cell-error cell-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="empty-text">Sem dados suficientes</p>
          )}
        </div>
      </div>
    </div>

    <!-- Weekly Pattern -->
    <div class="card section-card-bottom">
      <div class="card-body">
        <div class="card-section-header weekly-header">
          <h3 class="weekly-title">Padrão Semanal</h3>
          <p class="weekly-subtitle">Média de cobertura por dia da semana</p>
        </div>
        <div class="weekly-grid">
          {displayWeekly.map(w => {
            if (!w) return null;
            const isLowest = lowestDay && w.day_idx === lowestDay.day_idx;
            const avgPct = (w.avg / totalTribunals) * 100;
            return (
              <div class="weekly-card">
                <div class="weekly-card-body">
                  <span class="day-name">{w.name.slice(0, 3)}</span>
                  <div class={`stat-value ${isLowest ? 'color-error' : ''}`}>
                    {avgPct.toFixed(0)}%
                  </div>
                  <small class="muted">{w.avg.toFixed(1)} / {totalTribunals}</small>
                  {isLowest && (
                    <div class="badge-wrapper"><span class="badge-error">Menor</span></div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>

  .section-card {
    margin-bottom: var(--space-lg);
  }

  .section-card-bottom {
    margin-bottom: var(--space-xl);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--color-base-300);
    padding-bottom: 0.75rem;
  }

  .card-section-header {
    border-bottom: 1px solid var(--color-base-300);
    padding-bottom: 0.75rem;
  }

  .muted {
    opacity: 0.5;
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    text-align: center;
    padding: var(--space-md) 0;
  }

  .coverage-grid figure {
    margin: 0;
    padding: var(--space-lg) var(--space-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .coverage-grid figcaption {
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 1rem;
    opacity: 0.8;
  }

  .coverage-grid small {
    display: block;
    margin-top: 0.5rem;
    opacity: 0.6;
    font-size: var(--font-size-sm);
  }

  .stat-unit {
    font-size: 0.5em;
    font-weight: 500;
  }

  .stat-fraction {
    font-size: 0.5em;
    font-weight: 400;
    opacity: 0.5;
  }

  .color-success {
    color: var(--color-success);
  }

  .color-error {
    color: var(--color-error);
  }

  .rankings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .ranking-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .ranking-table tr:nth-child(even) {
    background: var(--color-base-200);
  }

  .ranking-table td {
    padding: 0.5rem 0.75rem;
  }

  .rank-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: var(--color-surface-overlay);
    color: var(--color-content-secondary);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .cell-success {
    color: var(--color-success);
  }

  .cell-error {
    color: var(--color-error);
  }

  .cell-right {
    text-align: right;
  }

  .empty-text {
    text-align: center;
    opacity: 0.5;
    padding: var(--space-sm) 0;
  }

  .weekly-header {
    margin-bottom: var(--space-sm);
  }

  .weekly-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin-bottom: 0;
  }

  .weekly-subtitle {
    font-size: var(--font-size-sm);
    opacity: 0.6;
    margin-bottom: 0;
  }

  .weekly-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-sm);
    text-align: center;
  }

  .weekly-card {
    background: var(--color-base-200);
    border-radius: var(--radius-box);
    padding: var(--space-md) var(--space-sm);
  }

  .weekly-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-sm);
  }

  .weekly-grid .stat-value {
    font-size: var(--font-size-xl);
    margin: var(--space-xs) 0;
  }

  .day-name {
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .badge-wrapper {
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .coverage-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  @media (min-width: 480px) {
    .weekly-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .rankings-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .weekly-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .weekly-grid {
      grid-template-columns: repeat(7, 1fr);
    }
  }
</style>
