---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { readJson } from '../lib/readJson';

// All aggregations come from .qmd query contracts rendered against the manifest.
// See web/src/queries/{stats_coverage,court_reliability,weekly_pattern}.qmd
// Files are generated by `scripts/render_queries.py` (CI) — missing in fresh
// local checkouts, so we read defensively and degrade to empty UI.
type CourtRow = { court: string; rate: number; total: number };
type WeeklyRow = { day_idx: number; name: string; avg: number; days_count: number };

const totals = readJson<{ tribunals_total?: number }>('data/totals.json') ?? {};
const statsCoverage = readJson<{
  avg_coverage?: number;
  best_count?: number; best_day?: string | null;
  worst_count?: number; worst_day?: string | null;
}>('data/stats_coverage.json') ?? {};
const courtReliability = readJson<CourtRow[]>('data/court_reliability.json') ?? [];
const weeklyPattern = readJson<WeeklyRow[]>('data/weekly_pattern.json') ?? [];

const totalTribunals = totals.tribunals_total ?? 96;
const avgCoverage30 = statsCoverage.avg_coverage ?? 0;
const bestCount = statsCoverage.best_count ?? 0;
const bestDay = statsCoverage.best_day ?? null;
const worstCount = statsCoverage.worst_count ?? 0;
const worstDay = statsCoverage.worst_day ?? null;
const avgCoverage30Pct = (avgCoverage30 / totalTribunals) * 100;
const top5 = courtReliability.slice(0, 5);
const bottom5 = [...courtReliability].sort((a, b) => a.rate - b.rate || b.total - a.total).slice(0, 5);

const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyPattern.find(w => w.day_idx === idx));
const lowestDay = [...weeklyPattern].filter(w => w.days_count > 0 && w.avg > 0).sort((a, b) => a.avg - b.avg)[0] ?? null;

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Indicadores — CausaGanha"
  description="Análise de cobertura histórica e confiabilidade dos tribunais."
>
  <Header
    variant="page"
    title="Indicadores"
    subtitle="Análise de cobertura histórica e confiabilidade"
    tile="stats"
    backHref={base}
    backLabel="Voltar para o Início"
  />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: base },
      { label: 'Indicadores' }
    ]} />

    <!-- Coverage Overview -->
    <article class="section-card">
      <header>
        <strong>Resumo de Cobertura</strong>
        <small class="muted">Últimos 30 dias</small>
      </header>
      <div class="coverage-grid">
        <figure>
          <div class="stat-value">{avgCoverage30Pct.toFixed(1)}<small class="stat-unit">%</small></div>
          <figcaption>Média de Coleta</figcaption>
          <small class="muted">{avgCoverage30.toFixed(1)} / {totalTribunals} tribunais por dia</small>
        </figure>
        <figure>
          <div class="stat-value color-success">{bestCount}<small class="stat-fraction"> / {totalTribunals}</small></div>
          <figcaption>Melhor Dia</figcaption>
          <small class="muted">{bestDay ?? '--'}</small>
        </figure>
        <figure>
          <div class="stat-value color-error">{worstCount}<small class="stat-fraction"> / {totalTribunals}</small></div>
          <figcaption>Pior Dia</figcaption>
          <small class="muted">{worstDay ?? '--'}</small>
        </figure>
      </div>
    </article>

    <!-- Court Rankings -->
    <div class="rankings-grid">
      <article>
        <strong>Top 5 Mais Confiáveis</strong>
        {top5.length > 0 ? (
          <div class="table-responsive">
            <table class="ranking-table">
              <thead class="sr-only">
                <tr>
                  <th scope="col">Posição</th>
                  <th scope="col">Tribunal</th>
                  <th scope="col">Taxa de cobertura</th>
                </tr>
              </thead>
              <tbody>
                {top5.map((c, i) => (
                  <tr>
                    <td><small class="rank-num">{i + 1}</small></td>
                    <td><strong>{c.court}</strong></td>
                    <td class="cell-success cell-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty-text">Sem dados suficientes</p>
        )}
      </article>

      <article>
        <strong>Top 5 Mais Falhas</strong>
        {bottom5.length > 0 ? (
          <div class="table-responsive">
            <table class="ranking-table">
              <thead class="sr-only">
                <tr>
                  <th scope="col">Posição</th>
                  <th scope="col">Tribunal</th>
                  <th scope="col">Taxa de cobertura</th>
                </tr>
              </thead>
              <tbody>
                {bottom5.map((c, i) => (
                  <tr>
                    <td><small class="rank-num">{i + 1}</small></td>
                    <td><strong>{c.court}</strong></td>
                    <td class="cell-error cell-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <p class="empty-text">Sem dados suficientes</p>
        )}
      </article>
    </div>

    <!-- Weekly Pattern -->
    <article class="section-card-bottom">
      <header class="weekly-header">
        <h3 class="weekly-title">Padrão Semanal</h3>
        <p class="weekly-subtitle">Média de cobertura por dia da semana</p>
      </header>
      <div class="weekly-grid">
        {displayWeekly.map(w => {
          if (!w) return null;
          const isLowest = lowestDay && w.day_idx === lowestDay.day_idx;
          const avgPct = (w.avg / totalTribunals) * 100;
          return (
            <div class="weekly-card">
              <span class="day-name">{w.name.slice(0, 3)}</span>
              <div class={`stat-value ${isLowest ? 'color-error' : ''}`}>
                {avgPct.toFixed(0)}%
              </div>
              <small class="muted">{w.avg.toFixed(1)} / {totalTribunals}</small>
              {isLowest && <mark data-tone="error">Menor</mark>}
            </div>
          );
        })}
      </div>
    </article>
  </div>
</Layout>

<style>

  .section-card {
    margin-bottom: var(--space-lg);
  }

  .section-card header,
  .section-card-bottom header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--pico-muted-border-color);
    padding-bottom: 0.75rem;
    background: none;
  }

  .section-card-bottom {
    margin-bottom: var(--space-xl);
  }

  .muted {
    opacity: 0.5;
  }

  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
    text-align: center;
    padding: var(--space-md) 0;
  }

  .coverage-grid figure {
    margin: 0;
    padding: var(--space-lg) var(--space-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .coverage-grid figcaption {
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 1rem;
    opacity: 0.8;
  }

  .coverage-grid small {
    display: block;
    margin-top: 0.5rem;
    opacity: 0.6;
    font-size: var(--font-size-sm);
  }

  .stat-unit {
    font-size: 0.5em;
    font-weight: 500;
  }

  .stat-fraction {
    font-size: 0.5em;
    font-weight: 400;
    opacity: 0.5;
  }

  .color-success {
    color: var(--color-success);
  }

  .color-error {
    color: var(--color-error);
  }

  .rankings-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .ranking-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .ranking-table tr:nth-child(even) {
    background: var(--color-base-200);
  }

  .ranking-table td {
    padding: 0.5rem 0.75rem;
  }

  .rank-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    background: var(--color-surface-overlay);
    color: var(--color-content-secondary);
    font-size: var(--font-size-xs);
    font-weight: 600;
  }

  .cell-success {
    color: var(--color-success);
  }

  .cell-error {
    color: var(--color-error);
  }

  .cell-right {
    text-align: right;
  }

  .empty-text {
    text-align: center;
    opacity: 0.5;
    padding: var(--space-sm) 0;
  }

  .weekly-header {
    margin-bottom: var(--space-sm);
  }

  .weekly-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin-bottom: 0;
  }

  .weekly-subtitle {
    font-size: var(--font-size-sm);
    opacity: 0.6;
    margin-bottom: 0;
  }

  .weekly-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: var(--space-sm);
    text-align: center;
  }

  .weekly-card {
    background: var(--color-base-200);
    border-radius: var(--pico-border-radius);
    padding: var(--space-md) var(--space-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .weekly-grid .stat-value {
    font-size: var(--font-size-xl);
    margin: var(--space-xs) 0;
  }

  .day-name {
    font-size: var(--font-size-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  mark[data-tone='error'] {
    background: color-mix(in srgb, var(--color-error) 20%, transparent);
    color: var(--color-error);
    margin-top: 0.25rem;
  }

  @media (max-width: 768px) {
    .coverage-grid {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }

  @media (min-width: 480px) {
    .weekly-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .rankings-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .weekly-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .weekly-grid {
      grid-template-columns: repeat(7, 1fr);
    }
  }
</style>
