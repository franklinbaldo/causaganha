---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ManifestStatus from '../components/ManifestStatus.svelte';
import { readJson } from '../lib/readJson';

// All aggregations come from .qmd query contracts rendered against the manifest.
// See web/src/queries/{stats_coverage,court_reliability,weekly_pattern}.qmd
// Files are generated by `scripts/render_queries.py` (CI) — missing in fresh
// local checkouts, so we read defensively and degrade to empty UI.
type CourtRow = { court: string; rate: number; total: number };
type WeeklyRow = { day_idx: number; name: string; avg: number; days_count: number };

const totals = readJson<{ tribunals_total?: number }>('data/totals.json') ?? {};
const statsCoverage = readJson<{
  avg_coverage?: number;
  best_count?: number; best_day?: string | null;
  worst_count?: number; worst_day?: string | null;
}>('data/stats_coverage.json') ?? {};
const courtReliability = readJson<CourtRow[]>('data/court_reliability.json') ?? [];
const weeklyPattern = readJson<WeeklyRow[]>('data/weekly_pattern.json') ?? [];

const totalTribunals = totals.tribunals_total ?? 96;
const avgCoverage30 = statsCoverage.avg_coverage ?? 0;
const bestCount = statsCoverage.best_count ?? 0;
const bestDay = statsCoverage.best_day ?? null;
const worstCount = statsCoverage.worst_count ?? 0;
const worstDay = statsCoverage.worst_day ?? null;
const avgCoverage30Pct = (avgCoverage30 / totalTribunals) * 100;
const top5 = courtReliability.slice(0, 5);
const bottom5 = [...courtReliability].sort((a, b) => a.rate - b.rate || b.total - a.total).slice(0, 5);

const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyPattern.find(w => w.day_idx === idx));
const lowestDay = [...weeklyPattern].filter(w => w.days_count > 0 && w.avg > 0).sort((a, b) => a.avg - b.avg)[0] ?? null;

const base = import.meta.env.BASE_URL;
---

<Layout
  title="Indicadores — CausaGanha"
  description="Análise de cobertura histórica e confiabilidade dos tribunais."
>
  <Header
    variant="page"
    title="Indicadores"
    subtitle="Análise de cobertura histórica e confiabilidade"
    tile="stats"
    backHref={base}
    backLabel="Voltar para o Início"
  />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: base },
      { label: 'Indicadores' }
    ]} />

    <!-- Coverage Overview -->
    <article>
      <header>
        <strong>Resumo de Cobertura</strong>
        <small data-tone="muted">Últimos 30 dias</small>
      </header>
      <div class="auto-grid">
        <figure>
          <div class="stat-value">{avgCoverage30Pct.toFixed(1)}<small class="stat-label">%</small></div>
          <figcaption>Média de Coleta</figcaption>
          <small data-tone="muted">{avgCoverage30.toFixed(1)} / {totalTribunals} tribunais por dia</small>
        </figure>
        <figure>
          <div class="stat-value" data-tone="success">{bestCount}<small class="stat-label"> / {totalTribunals}</small></div>
          <figcaption>Melhor Dia</figcaption>
          <small data-tone="muted">{bestDay ?? '--'}</small>
        </figure>
        <figure>
          <div class="stat-value" data-tone="error">{worstCount}<small class="stat-label"> / {totalTribunals}</small></div>
          <figcaption>Pior Dia</figcaption>
          <small data-tone="muted">{worstDay ?? '--'}</small>
        </figure>
      </div>
    </article>

    <!-- Court Rankings -->
    <div class="auto-grid">
      <article>
        <header><strong>Top 5 Mais Confiáveis</strong></header>
        {top5.length > 0 ? (
          <ol>
            {top5.map(c => (
              <li>
                <strong>{c.court}</strong>
                <mark data-tone="success">{(c.rate * 100).toFixed(1)}%</mark>
              </li>
            ))}
          </ol>
        ) : (
          <p class="meta-text">Sem dados suficientes</p>
        )}
      </article>

      <article>
        <header><strong>Top 5 Mais Falhas</strong></header>
        {bottom5.length > 0 ? (
          <ol>
            {bottom5.map(c => (
              <li>
                <strong>{c.court}</strong>
                <mark data-tone="error">{(c.rate * 100).toFixed(1)}%</mark>
              </li>
            ))}
          </ol>
        ) : (
          <p class="meta-text">Sem dados suficientes</p>
        )}
      </article>
    </div>

    <!-- Weekly Pattern -->
    <article>
      <header>
        <h3>Padrão Semanal</h3>
        <p><small>Média de cobertura por dia da semana</small></p>
      </header>
      <div class="auto-grid">
        {displayWeekly.map(w => {
          if (!w) return null;
          const isLowest = lowestDay && w.day_idx === lowestDay.day_idx;
          const avgPct = (w.avg / totalTribunals) * 100;
          return (
            <article>
              <header><strong>{w.name.slice(0, 3)}</strong></header>
              <div class="stat-value" data-tone={isLowest ? 'error' : undefined}>
                {avgPct.toFixed(0)}%
              </div>
              <small data-tone="muted">{w.avg.toFixed(1)} / {totalTribunals}</small>
              {isLowest && <mark data-tone="error">Menor</mark>}
            </article>
          );
        })}
      </div>
    </article>

    <!-- Per-tribunal coverage from live IA manifest -->
    <article>
      <header>
        <strong>Cobertura por tribunal e ano</strong>
        <small data-tone="muted">Dados ao vivo do manifesto canônico em archive.org</small>
      </header>
      <ManifestStatus client:load />
    </article>
  </div>
</Layout>
