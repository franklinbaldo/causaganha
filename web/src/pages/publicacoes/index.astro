---
import Layout from '../../layouts/Layout.astro';
import PublicationSearch from '../../components/PublicationSearch.svelte';
import { loadSiteStatus, formatUtcDateTime } from '../../lib/data/siteStatus';

// Métricas globais do artefato canônico site-status.json (contrato
// site_status, renderizado do sync-manifest.parquet) — mesma fonte da
// homepage e das demais páginas. Artefato ausente/obsoleto = build falha.
const siteStatus = await loadSiteStatus();
const djen = siteStatus.sources.djen;
const totalZips = djen.zips_archived;
const tribunalsWithData = djen.tribunals_with_data;
const sinceYear = (djen.earliest_upload_date ?? '').slice(0, 4) || null;
const generatedAtLabel = formatUtcDateTime(siteStatus.generated_at) ?? 'desconhecido';

function fmt(n: number): string {
  return n.toLocaleString('pt-BR');
}

---

<Layout
  title="Publicações — CausaGanha"
  description="Busca direta nas publicações do DJEN arquivadas no Internet Archive. Cole um processo CNJ, OAB, nome de parte ou texto livre."
  fullWidth={true}
  showNetworkBanner={false}
>

  <!-- ═══════════ PAGE HEAD ═══════════ -->
  <section class="page-head" aria-label="Publicações">
    <div class="wrap wrap--wide">
      <span class="kicker">§ Publicações · arquivo de busca</span>
      <h1>Procurar uma <em>intimação,</em><br/>uma sentença, um edital.</h1>
      <p class="lede">
        Busca direta nas publicações do DJEN arquivadas no Internet Archive.
        {totalZips > 0 ? fmt(totalZips) + ' ZIPs arquivados (pares tribunal × dia)' : 'ZIPs arquivados'} de {tribunalsWithData} tribunais{sinceYear ? ` desde ${sinceYear}` : ''}.
        Cole um número de processo CNJ, uma inscrição na OAB, o nome de uma parte, ou texto livre.
      </p>
      <p class="page-head__meta">Métricas do manifesto canônico · geradas em {generatedAtLabel}</p>
    </div>
  </section>

  <section aria-label="Como interpretar lacunas de cobertura">
    <div class="wrap wrap--wide">
      <article class="attention-card" data-tone="info">
        <header>
          <strong>○ Cobertura e lacunas por tribunal</strong>
          <span class="badge" data-tone="info">Status textual, contagens e calendário</span>
        </header>
        <p>Impacto: dias sem dados podem omitir publicações em buscas por processo, OAB ou parte.</p>
        <p>Possível causa: ausência oficial do diário, backfill pendente ou falha temporária de coleta.</p>
        <p><strong>Próxima ação:</strong> abra a página de um tribunal para ver cards de atenção, calendário e dias ausentes.</p>
      </article>
    </div>
  </section>

  <!-- ═══════════ SEARCH ═══════════ -->
  <section class="publication-search-section">
    <div class="wrap wrap--wide">
      <PublicationSearch client:load />
    </div>
  </section>

</Layout>

<style>
  .publication-search-section {
    padding: var(--s-7) 0 var(--s-9);
  }

  .page-head__meta {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    color: var(--fg-muted);
  }
</style>
