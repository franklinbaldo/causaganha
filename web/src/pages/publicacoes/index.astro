---
import Layout from '../../layouts/Layout.astro';
import PublicationSearch from '../../components/PublicationSearch.svelte';
import { loadSiteStatus, formatUtcDateTime } from '../../lib/data/siteStatus';
import { css } from '../../../styled-system/css';
import { alert, badge } from '../../../styled-system/recipes';

const siteStatus = await loadSiteStatus();
const djen = siteStatus.sources.djen;
const totalZips = djen.zips_archived;
const tribunalsWithData = djen.tribunals_with_data;
const sinceYear = (djen.earliest_upload_date ?? '').slice(0, 4) || null;
const generatedAtLabel = formatUtcDateTime(siteStatus.generated_at) ?? 'desconhecido';

function fmt(n: number): string {
  return n.toLocaleString('pt-BR');
}
---

<Layout
  title="Publicações — CausaGanha"
  description="Pesquise diretamente nas publicações do DJEN por processo CNJ, OAB, nome de parte ou texto livre."
  fullWidth={true}
  showNetworkBanner={false}
>
  <section class={css({ background: 'text', color: 'canvas', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: '1.2fr 0.8fr' }, gap: '10', alignItems: 'end' })}>
      <div>
        <span class={badge({ tone: 'accent' })}>Publicações · DJEN</span>
        <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, color: 'canvas', m: '0', mt: '5', maxW: '12ch' })}>Encontre a publicação.</h1>
        <p class={css({ mt: '6', mb: '0', maxW: '46rem', color: 'surfaceMuted', fontSize: 'lg', lineHeight: 'body' })}>
          Pesquise por CNJ, OAB, parte ou texto livre. O resultado continua ligado ao tribunal, data e origem consultada.
        </p>
      </div>
      <div class={css({ display: 'grid', gridTemplateColumns: '1fr 1fr', minH: '10rem', border: '1px solid', borderColor: 'canvas' })} aria-hidden="true">
        <div class={css({ background: 'accent', borderRight: '1px solid', borderColor: 'text' })}></div>
        <div class={css({ background: 'info' })}></div>
      </div>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '10', md: '16' } })}>
    <div class={css({ background: 'surface', border: '1px solid', borderColor: 'text', p: { base: '5', md: '8' } })}>
      <PublicationSearch client:load />
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, pb: { base: '12', md: '18' } })} aria-label="Cobertura do arquivo">
    <div class={alert({ tone: 'info' })}>
      <strong>Cobertura não é uma promessa de completude.</strong>
      <span>
        {totalZips > 0 ? fmt(totalZips) + ' ZIPs arquivados' : 'ZIPs arquivados'} · {tribunalsWithData} tribunais{sinceYear ? ` · desde ${sinceYear}` : ''}.
        Dias sem dados podem representar ausência oficial do diário, backfill pendente ou falha temporária de coleta.
      </span>
      <small class={css({ fontFamily: 'mono', color: 'text' })}>Métricas geradas em {generatedAtLabel}</small>
    </div>
  </section>
</Layout>