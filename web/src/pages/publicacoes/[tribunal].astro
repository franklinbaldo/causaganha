---
import Layout from '../../layouts/Layout.astro';
import TribunalDetail from '../../components/TribunalDetail.svelte';
import { TRIBUNAIS } from '../../lib/tribunais.js';
import { loadContract } from '../../lib/data';
import { readJson } from '../../lib/readJson';
import { css } from '../../../styled-system/css';
import { badge, navLink } from '../../../styled-system/recipes';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return TRIBUNAIS.map(t => ({ params: { tribunal: t.toLowerCase() }, props: { tribunalCode: t } }));
}

const { tribunalCode } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const tribunalUpper = tribunalCode.toUpperCase();
const coverageRow = ((await loadContract('tribunal_coverage')) ?? []).find(row => row.tribunal.toUpperCase() === tribunalUpper);
const zipCount = coverageRow?.uploaded ?? 0;
const earliestDate = coverageRow?.earliest_upload ?? '';
const latestDate = coverageRow?.latest_upload ?? '';
const calendarRows = (await loadContract('tribunal_calendar')) ?? [];
const uploadedDates: string[] = [];
const absentDates: string[] = [];
for (const row of calendarRows) {
  if (row.tribunal.toUpperCase() !== tribunalUpper) continue;
  (row.status === 'uploaded' ? uploadedDates : absentDates).push(row.date);
}
const tribunalStartDates = readJson<Record<string, string>>('tribunal_start_dates.json') ?? {};
const startDate = tribunalStartDates[tribunalUpper] ?? null;
const tribunalNames: Record<string, string> = {
  STF: 'Supremo Tribunal Federal', STJ: 'Superior Tribunal de Justiça', TST: 'Tribunal Superior do Trabalho',
  TSE: 'Tribunal Superior Eleitoral', STM: 'Superior Tribunal Militar', CNJ: 'Conselho Nacional de Justiça',
};
const fullName = tribunalNames[tribunalCode] || tribunalCode;
const ogDesc = zipCount > 0
  ? `${zipCount} ZIPs de diários arquivados (pares tribunal × dia) de ${earliestDate} a ${latestDate}`
  : `Publicações judiciais do ${tribunalCode} arquivadas no Internet Archive`;

if (import.meta.env.PROD && zipCount > 0) {
  const ogSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630"><rect width="1200" height="630" fill="#17221f"/><rect x="48" y="48" width="1104" height="534" fill="#f4f0e6"/><rect x="48" y="48" width="260" height="534" fill="#d5f03f"/><text x="360" y="170" font-family="Arial,sans-serif" font-size="28" fill="#62665f">CausaGanha · DJEN</text><text x="360" y="280" font-family="Arial,sans-serif" font-size="92" font-weight="900" fill="#17221f">${tribunalCode}</text><text x="360" y="335" font-family="Arial,sans-serif" font-size="26" fill="#17221f">${fullName}</text><text x="360" y="430" font-family="monospace" font-size="38" font-weight="700" fill="#17221f">${zipCount.toLocaleString('pt-BR')} ZIPs arquivados</text><text x="360" y="482" font-family="Arial,sans-serif" font-size="22" fill="#62665f">${earliestDate ? earliestDate + ' → ' + latestDate : 'Internet Archive'}</text></svg>`;
  const ogDir = path.resolve('./public/og');
  fs.mkdirSync(ogDir, { recursive: true });
  fs.writeFileSync(path.join(ogDir, `${tribunalCode.toLowerCase()}.svg`), ogSvg);
}
const ogImage = new URL(`${BASE}og/${tribunalCode.toLowerCase()}.svg`, Astro.site).toString();
---

<Layout title={`${tribunalCode} — Publicações — CausaGanha`} description={ogDesc} ogImage={ogImage} fullWidth={true}>
  <section class={css({ background: 'surfaceMuted', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '10', md: '14' } })}>
      <a class={navLink()} href={BASE + 'publicacoes'}>← Publicações</a>
      <div class={css({ display: 'flex', alignItems: 'end', justifyContent: 'space-between', gap: '8', flexWrap: 'wrap', mt: '7' })}>
        <div>
          <span class={badge({ tone: 'accent' })}>DJEN · tribunal</span>
          <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '4' })}>{tribunalCode}</h1>
          <p class={css({ mt: '3', mb: '0', color: 'textMuted', fontSize: 'lg' })}>{fullName}</p>
        </div>
        <div class={css({ fontFamily: 'mono', fontSize: 'sm', color: 'textMuted', textAlign: { md: 'right' } })}>
          <strong class={css({ display: 'block', color: 'text', fontSize: 'xl' })}>{zipCount.toLocaleString('pt-BR')} ZIPs</strong>
          {earliestDate ? `${earliestDate} → ${latestDate}` : 'sem período publicado'}
        </div>
      </div>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '10', md: '16' } })}>
    <div class={css({ background: 'surface', border: '1px solid', borderColor: 'text', p: { base: '4', md: '7' } })}>
      <TribunalDetail client:only="svelte" tribunalCode={tribunalCode} initialUploadedDates={uploadedDates} initialAbsentDates={absentDates} initialStartDate={startDate} />
    </div>
  </section>
</Layout>
