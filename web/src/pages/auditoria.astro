---
import Layout from '../layouts/Layout.astro';
import { css } from '../../styled-system/css';
import { badge, button } from '../../styled-system/recipes';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Auditoria DJEN — Antes e Depois | CausaGanha"
  description="Compare visualmente as decisões do DJEN antes e depois da estruturação em 5 seções canônicas, desfecho CPC e extração de entidades."
  fullWidth={true}
>
  <section class={css({ background: 'surfaceMuted', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '10', md: '14' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: '1fr auto' }, gap: '8', alignItems: 'end' })}>
      <div>
        <span class={badge({ tone: 'accent' })}>Auditoria Empírica de 1.000 Decisões</span>
        <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '4', maxW: '14ch' })}>Antes vs. Depois do Pipeline.</h1>
        <p class={css({ mt: '4', mb: '0', maxW: '46rem', color: 'textMuted', fontSize: 'lg', lineHeight: 'body' })}>
          Veja como o texto bruto e desestruturado do DJEN é transformado em 5 seções canônicas, com desfecho do CPC (procedente, improcedente, parcial), polo vencedor invariante e entidades jurimétricas.
        </p>
      </div>
      <div class={css({ display: 'flex', gap: '3', flexWrap: 'wrap' })}>
        <a class={button({ visual: 'solid' })} href={`${BASE}auditoria.html`} target="_blank" rel="noopener">Abrir em Tela Cheia ↗</a>
        <a class={button({ visual: 'outline' })} href={`${BASE}visualizer_data.json`} download>Baixar JSON das Amostras</a>
      </div>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '4', md: '8' }, py: { base: '8', md: '12' } })}>
    <div class={css({ border: '1px solid', borderColor: 'text', background: 'surface', boxShadow: 'lift', overflow: 'hidden' })}>
      <iframe
        src={`${BASE}auditoria.html`}
        title="Visualizador Interativo Antes e Depois CausaGanha"
        class={css({ w: '100%', minH: '900px', border: 'none', display: 'block' })}
        loading="lazy"
      ></iframe>
    </div>
  </section>
</Layout>
