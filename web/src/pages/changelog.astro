---
import Layout from '../layouts/Layout.astro';
import { css } from '../../styled-system/css';
import { badge, card } from '../../styled-system/recipes';

const entries = [
  {
    date: '2026-04-06',
    title: 'Novas páginas de exploração de dados',
    items: ['Adicionados diretório de advogados e detalhamento por OAB.', 'Nova área de consultas SQL prontas e comparador de tribunais.'],
  },
  {
    date: '2026-04-03',
    title: 'Aprimoramentos de observabilidade',
    items: ['Painel admin de performance estabilizado.', 'Melhorias de cache para dados de backfill.'],
  },
];
const dateFormatter = new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout title="Changelog — CausaGanha" description="Atualizações publicadas do CausaGanha." fullWidth={true} showNetworkBanner={false}>
  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' } })}>
    <span class={badge({ tone: 'neutral' })}>Histórico</span>
    <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '5', maxW: '10ch' })}>O que mudou.</h1>
    <p class={css({ mt: '6', mb: '10', maxW: '44rem', color: 'textMuted', fontSize: 'lg', lineHeight: 'body' })}>Registro curto de mudanças públicas relevantes. O histórico técnico completo permanece no GitHub.</p>

    <div class={css({ display: 'grid', gap: '4', maxW: 'reading' })}>
      {entries.map(entry => (
        <article class={card()}>
          <time datetime={entry.date} class={css({ textStyle: 'eyebrow', color: 'info' })}>{dateFormatter.format(new Date(entry.date + 'T00:00:00Z'))}</time>
          <h2 class={css({ mt: '4', mb: '4', fontSize: 'xl' })}>{entry.title}</h2>
          <ul class={css({ m: '0', pl: '6', display: 'grid', gap: '2', color: 'textMuted', lineHeight: 'body' })}>{entry.items.map(item => <li>{item}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</Layout>
