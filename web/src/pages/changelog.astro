---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const entries = [
  {
    date: '2026-04-06',
    title: 'Novas páginas de exploração de dados',
    items: ['Adicionados diretório de advogados e detalhamento por OAB.', 'Nova área de consultas SQL prontas e comparador de tribunais.'],
  },
  {
    date: '2026-04-03',
    title: 'Aprimoramentos de observabilidade',
    items: ['Painel admin de performance estabilizado.', 'Melhorias de cache para dados de backfill.'],
  },
];
---

<Layout title="Changelog - CausaGanha" description="Atualizações de produto e status do projeto CausaGanha.">
  <Header variant="page" title="Changelog" subtitle="Evolução do dashboard e do pipeline" backHref={BASE} backLabel="Início" tile="changelog" />

  <div class="page-container">
    <Breadcrumbs crumbs={[{ label: 'Início', href: BASE }, { label: 'Changelog' }]} />

    <section class="entries-section">
      {entries.map((entry) => (
        <article class="card">
          <div class="card-body">
            <small class="entry-date">{entry.date}</small>
            <h2 class="card-heading">{entry.title}</h2>
            <ul class="entry-list">
              {entry.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </section>
  </div>
</Layout>

<style>
  .page-container {
    max-width: 1280px;
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .entries-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .entry-date {
    font-family: var(--font-mono);
    opacity: 0.7;
  }

  .card-heading {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin-top: 0.25rem;
  }

  .entry-list {
    list-style: disc;
    padding-left: 1.25rem;
    opacity: 0.8;
  }
</style>
