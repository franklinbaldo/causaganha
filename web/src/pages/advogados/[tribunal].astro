---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AlertBanner from '../../components/AlertBanner.svelte';
import StatCard from '../../components/StatCard.astro';
import EmptyState from '../../components/EmptyState.svelte';
import { readJson, type CacheBackfillFile } from '../../lib/readJson';

const backfill = readJson<CacheBackfillFile>('cache/backfill.json');
const tribunalStats = (backfill?.tribunal_stats ?? [])
  .map((item) => ({
    tribunal: String(item.tribunal ?? '').toUpperCase(),
    dataRatePct: Number(item.data_rate_pct ?? 0),
    daysWithData: Number(item.days_with_data ?? 0),
    daysTotal: Number(item.days_total ?? 0),
  }))
  .filter((item) => item.tribunal)
  .sort((a, b) => b.dataRatePct - a.dataRatePct)
  .slice(0, 12);

export function getStaticPaths() {
  const backfillData = readJson<CacheBackfillFile>('cache/backfill.json');
  const entries = (backfillData?.tribunal_stats ?? [])
    .map((item) => ({ slug: String(item.tribunal ?? '').toLowerCase(), rate: Number(item.data_rate_pct ?? 0) }))
    .filter((item) => item.slug.length > 0)
    .sort((a, b) => b.rate - a.rate)
    .slice(0, 12)
    .map((item) => item.slug);

  return entries.map((tribunal: string) => ({ params: { tribunal } }));
}

const { tribunal } = Astro.params;
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const key = String(tribunal ?? '').toUpperCase();
const entry = tribunalStats.find((item) => item.tribunal === key);
const query = `SELECT numero_oab, uf_oab, COUNT(*) AS aparicoes\nFROM advogados\nWHERE tribunal = '${key}'\nGROUP BY numero_oab, uf_oab\nORDER BY aparicoes DESC\nLIMIT 25;`;
---

<Layout title={`${key} — Advogados — CausaGanha`} description={`Guia de consulta de advogados/OAB para ${key}.`}>
  <PageHeader backHref={BASE + 'advogados'} backLabel="Advogados" tile="advogados" title={`Guia por Tribunal: ${key}`} subtitle="Use no Explorador para consultar OABs com dados já coletados" />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'Advogados', href: BASE + 'advogados' },
      { label: key },
    ]} />

    <AlertBanner
      level="info"
      title="Detalhe baseado em dados existentes"
      message="Este detalhe é focado no que já existe no snapshot de backfill: cobertura por tribunal e query pronta para localizar OABs reais no explorador."
    />

    {entry ? (
      <>
        <section class="auto-grid">
          <StatCard title="Tribunal" value={entry.tribunal} />
          <StatCard title="Cobertura" value={`${entry.dataRatePct.toFixed(1)}%`} tone="info" />
          <StatCard title="Dias com dados" value={`${entry.daysWithData} / ${entry.daysTotal}`} />
        </section>

        <article>
          <h2>Consulta SQL sugerida</h2>
          <p class="meta-text">Cole no explorador para identificar OABs mais recorrentes neste tribunal.</p>
          <pre><code>{query}</code></pre>
          <footer>
            <a href={BASE + 'explorador'} role="button">Abrir Explorador</a>
          </footer>
        </article>
      </>
    ) : (
      <EmptyState
        title="Tribunal não encontrado"
        message="Não há snapshot de cobertura para este identificador no build atual."
        actionHref={BASE + 'advogados'}
        actionLabel="Voltar para Advogados"
      />
    )}
  </div>
</Layout>
