---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AlertBanner from '../../components/AlertBanner.svelte';
import StatCard from '../../components/StatCard.astro';
import EmptyState from '../../components/EmptyState.svelte';
import { loadContract } from '../../lib/data';
import { loadSiteStatus, formatUtcDateTime } from '../../lib/data/siteStatus';
import { topAdvogadosTribunals } from '../../lib/advogadosCoverage';

// Mesma fonte e mesma seleção da página /advogados: contrato canônico
// tribunal_coverage (ver lib/advogadosCoverage.ts). O snapshot legado
// cache/backfill.json foi aposentado desta rota.
export async function getStaticPaths() {
  const coverage = await loadContract('tribunal_coverage');
  return topAdvogadosTribunals(coverage).map((item) => ({
    params: { tribunal: item.tribunal.toLowerCase() },
  }));
}

const siteStatus = await loadSiteStatus();
const generatedAtLabel = formatUtcDateTime(siteStatus.generated_at) ?? 'desconhecido';
const coverage = await loadContract('tribunal_coverage');
const tribunalStats = topAdvogadosTribunals(coverage);

const { tribunal } = Astro.params;
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const key = String(tribunal ?? '').toUpperCase();
const entry = tribunalStats.find((item) => item.tribunal === key);
const query = `SELECT numero_oab, uf_oab, COUNT(*) AS aparicoes\nFROM advogados\nWHERE tribunal = '${key}'\nGROUP BY numero_oab, uf_oab\nORDER BY aparicoes DESC\nLIMIT 25;`;
---

<Layout title={`${key} — Advogados — CausaGanha`} description={`Guia de consulta de advogados/OAB para ${key}.`} showNetworkBanner={false}>
  <PageHeader backHref={BASE + 'advogados'} backLabel="Advogados" tile="advogados" title={`Guia por Tribunal: ${key}`} subtitle="Use no Explorador para consultar OABs com dados já coletados" />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'Advogados', href: BASE + 'advogados' },
      { label: key },
    ]} />

    <AlertBanner
      level="info"
      title="Detalhe baseado no manifesto canônico"
      message={`Cobertura calculada do contrato tribunal_coverage (manifesto sync-manifest.parquet), gerado em ${generatedAtLabel}, com query pronta para localizar OABs reais no explorador.`}
    />

    {entry ? (
      <>
        <section class="auto-grid">
          <StatCard title="Tribunal" value={entry.tribunal} />
          <StatCard title="Cobertura" value={`${entry.dataRatePct.toFixed(1)}%`} subtitle="ZIPs arquivados / dias rastreados" tone="info" />
          <StatCard title="Dias arquivados" value={`${entry.daysWithData.toLocaleString('pt-BR')} / ${entry.daysTotal.toLocaleString('pt-BR')}`} subtitle="Pares tribunal × dia com ZIP no IA" />
        </section>

        <article>
          <h2>Consulta SQL sugerida</h2>
          <p class="meta-text">Cole no explorador para identificar OABs mais recorrentes neste tribunal.</p>
          <pre><code>{query}</code></pre>
          <footer>
            <a href={BASE + 'explorador'} role="button">Abrir Explorador</a>
          </footer>
        </article>
      </>
    ) : (
      <EmptyState
        title="Tribunal não encontrado"
        message="Não há dados de cobertura para este identificador no contrato tribunal_coverage deste build."
        actionHref={BASE + 'advogados'}
        actionLabel="Voltar para Advogados"
      />
    )}
  </div>
</Layout>
