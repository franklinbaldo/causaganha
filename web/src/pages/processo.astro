---
import Layout from '../layouts/Layout.astro';
import ProcessoLookup from '../components/ProcessoLookup.svelte';
import { css } from '../../styled-system/css';
import { alert, badge } from '../../styled-system/recipes';
---

<Layout
  title="Consultar processo — CausaGanha"
  description="Consulte um processo por número CNJ e veja o que DJEN, DataJud, TJRO JURIS e STJ sustentam, com proveniência explícita."
  fullWidth={true}
>
  <section class={css({ background: 'surfaceMuted', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: '1fr 0.65fr' }, gap: '10', alignItems: 'end' })}>
      <div>
        <span class={badge({ tone: 'accent' })}>Processo</span>
        <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '5', maxW: '10ch' })}>Um CNJ. Várias fontes.</h1>
        <p class={css({ mt: '6', mb: '0', maxW: '44rem', fontSize: 'lg', lineHeight: 'body', color: 'textMuted' })}>
          Cole o número do processo para abrir um dossiê que mantém arquivo, estado e teor separados — inclusive quando uma fonte não tem registro.
        </p>
      </div>
      <div class={alert({ tone: 'info' })}>
        <strong>A consulta roda no navegador.</strong>
        <span>O número pesquisado não é enviado a um servidor do CausaGanha.</span>
      </div>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: 'minmax(0, 1.45fr) minmax(18rem, 0.55fr)' }, gap: '10', alignItems: 'start' })}>
    <div class={css({ minW: '0', background: 'surface', border: '1px solid', borderColor: 'text', p: { base: '5', md: '8' } })}>
      <ProcessoLookup client:only="svelte" />
    </div>

    <aside class={css({ display: 'grid', gap: '6', position: { lg: 'sticky' }, top: { lg: '4' } })} aria-label="Como interpretar o resultado">
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '3' })}>Como ler</p>
        <h2 class={css({ textStyle: 'title', fontSize: 'xl', m: '0' })}>Ausência não é inexistência.</h2>
        <p class={css({ mt: '4', mb: '0', color: 'textMuted', lineHeight: 'body' })}>Cada fonte tem cobertura e tempo próprios. O CausaGanha mostra essas diferenças em vez de escondê-las.</p>
      </div>

      <dl class={css({ m: '0', display: 'grid', gap: '0', borderTop: '1px solid', borderColor: 'border' })}>
        <div class={css({ py: '4', borderBottom: '1px solid', borderColor: 'border' })}><dt class={css({ textStyle: 'eyebrow' })}>DJEN</dt><dd class={css({ m: '0', mt: '2', color: 'textMuted' })}>Publicações preservadas.</dd></div>
        <div class={css({ py: '4', borderBottom: '1px solid', borderColor: 'border' })}><dt class={css({ textStyle: 'eyebrow' })}>DataJud</dt><dd class={css({ m: '0', mt: '2', color: 'textMuted' })}>Capa e movimentos.</dd></div>
        <div class={css({ py: '4', borderBottom: '1px solid', borderColor: 'border' })}><dt class={css({ textStyle: 'eyebrow' })}>JURIS / STJ</dt><dd class={css({ m: '0', mt: '2', color: 'textMuted' })}>Teor quando disponível.</dd></div>
      </dl>
    </aside>
  </section>
</Layout>
