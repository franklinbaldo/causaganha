---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DuckDBExplorer from '../components/DuckDBExplorer.svelte';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="SQL — CausaGanha"
  description="Consulte dados judiciais brasileiros diretamente no navegador usando SQL e DuckDB-WASM."
>
  <Header variant="page" title="SQL" backHref={BASE} backLabel="Início" tile="explorador">
  </Header>

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'SQL' }
    ]} />

    <section class="intro-section">
      <p>
        Execute consultas SQL diretamente nos arquivos Parquet hospedados no
        <a href="https://archive.org/details/causaganha-dashboard" target="_blank" rel="noopener noreferrer">Internet Archive</a>
        (um item por tribunal/ano, ex.: <code>djen-tjro-2026</code>).
        O <strong>DuckDB-WASM</strong> roda inteiramente no seu navegador — nenhum dado é enviado para servidores externos.
      </p>

      <details class="schema-details">
        <summary class="schema-summary">Tabelas disponíveis</summary>
        <div class="schema-content">
          <div class="table-responsive">
            <table class="schema-table">
              <thead>
                <tr>
                  <th>Tabela</th>
                  <th>Descrição</th>
                  <th>Campos principais</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><code>comunicacoes</code></td>
                  <td>Intimações e comunicações judiciais</td>
                  <td>id, tribunal, numero_processo, data_disponibilizacao, tipo_comunicacao</td>
                </tr>
                <tr>
                  <td><code>advogados</code></td>
                  <td>Advogados identificados por OAB</td>
                  <td>id, nome, numero_oab, uf_oab, tribunal</td>
                </tr>
                <tr>
                  <td><code>textos</code></td>
                  <td>Conteúdo das comunicações (deduplicado)</td>
                  <td>id, texto</td>
                </tr>
                <tr>
                  <td><code>processos</code></td>
                  <td>Índice de atividade por processo</td>
                  <td>numero_processo, tribunal, data, comunicacao_id</td>
                </tr>
                <tr>
                  <td><code>classificacoes</code></td>
                  <td>Classificação de resultado (procedente/improcedente)</td>
                  <td>texto_id, outcome, decision_type, confidence</td>
                </tr>
                <tr>
                  <td><code>destinatarios</code></td>
                  <td>Destinatários das comunicações</td>
                  <td>comunicacao_id, nome, polo, parte_id</td>
                </tr>
                <tr>
                  <td><code>representacoes</code></td>
                  <td>Vínculos advogado-parte</td>
                  <td>advogado_id, parte_id, polo</td>
                </tr>
                <tr>
                  <td><code>partes</code></td>
                  <td>Partes normalizadas</td>
                  <td>id, nome_normalizado, nome_original</td>
                </tr>
                <tr>
                  <td><code>comunicacao_advogados</code></td>
                  <td>Vínculo comunicação-advogado</td>
                  <td>comunicacao_id, advogado_id</td>
                </tr>
                <tr>
                  <td><code>advogado_nomes</code></td>
                  <td>Variações de nome por advogado</td>
                  <td>advogado_id, nome, first_seen</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </details>
    </section>

    <DuckDBExplorer client:only="svelte" />

    <footer class="page-footer">
      <small class="muted">
        Dados do DJEN arquivados no Internet Archive.
        O DuckDB-WASM executa no navegador — seus dados não saem do seu dispositivo.
      </small>
    </footer>
  </div>
</Layout>

<style>
  .intro-section {
    margin-top: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .schema-details {
    border: 1px solid var(--color-base-300);
    background: var(--color-base-100);
    border-radius: var(--radius-box);
    margin-bottom: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .schema-summary {
    padding: var(--space-sm) var(--space-md);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .schema-summary::after {
    content: '\25B6';
    font-size: var(--font-size-xs);
    transition: transform var(--transition-base);
  }

  .schema-details[open] .schema-summary::after {
    transform: rotate(90deg);
  }

  .schema-summary::-webkit-details-marker {
    display: none;
  }

  .schema-content {
    padding: 0 var(--space-md) var(--space-md);
  }

  .schema-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .schema-table th {
    text-align: left;
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    border-bottom: 2px solid var(--color-base-300);
  }

  .schema-table td {
    padding: 0.5rem 0.75rem;
  }

  .schema-table tbody tr:nth-child(even) {
    background: var(--color-base-200);
  }

  .page-footer {
    text-align: center;
    margin-top: var(--space-xl);
    padding: var(--space-md) 0;
    border-top: 1px solid var(--color-base-300);
  }

  .muted {
    opacity: 0.5;
  }
</style>
