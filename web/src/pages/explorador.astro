---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DuckDBExplorer from '../components/DuckDBExplorer.svelte';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Explorador de Dados — CausaGanha"
  description="Consulte dados judiciais brasileiros diretamente no navegador usando SQL e DuckDB-WASM."
>
  <PageHeader title="Explorador de Dados" backHref={BASE} backLabel="Início" tile="explorador">
  </PageHeader>

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'Explorador de Dados' }
    ]} />

    <section>
      <p>
        Execute consultas SQL diretamente nos arquivos Parquet hospedados no
        <a href="https://archive.org/details/causaganha-dashboard" target="_blank" rel="noopener noreferrer">Internet Archive</a>
        (um item por tribunal/ano, ex.: <code>djen-tjro-2026</code>).
        O <strong>DuckDB-WASM</strong> roda inteiramente no seu navegador — nenhum dado é enviado para servidores externos.
      </p>

      <article>
        <header><strong>Fluxo do explorador</strong></header>
        <ul>
          <li>Escolha um tribunal e ano antes de editar a consulta SQL.</li>
          <li>Use os templates para gerar automaticamente caminhos <code>read_parquet(...)</code> no formato <code>djen-&lt;tribunal&gt;-&lt;ano&gt;</code>.</li>
          <li>Consulte rapidamente as tabelas principais: comunicações, advogados, vínculos e classificações.</li>
        </ul>
      </article>
    </section>

    <DuckDBExplorer client:only="svelte" publicBase={BASE} />

    <footer>
      <small data-tone="muted">
        Dados do DJEN arquivados no Internet Archive.
        O DuckDB-WASM executa no navegador — seus dados não saem do seu dispositivo.
      </small>
    </footer>
  </div>
</Layout>
