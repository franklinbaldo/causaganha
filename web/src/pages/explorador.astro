---
import Layout from '../layouts/Layout.astro';
import DuckDBExplorer from '../components/DuckDBExplorer.svelte';
import { css } from '../../styled-system/css';
import { alert, badge } from '../../styled-system/recipes';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Explorador de dados — CausaGanha"
  description="Consulte os Parquets públicos do CausaGanha com SQL e DuckDB-WASM diretamente no navegador."
  fullWidth={true}
>
  <section class={css({ background: 'surfaceMuted', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' } })}>
      <span class={badge({ tone: 'info' })}>Ferramenta avançada</span>
      <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '5', maxW: '11ch' })}>Consulte o dado bruto.</h1>
      <p class={css({ mt: '6', mb: '0', maxW: '52rem', color: 'textMuted', fontSize: 'lg', lineHeight: 'body' })}>
        Rode SQL diretamente sobre os Parquets públicos. O DuckDB-WASM executa no seu navegador; a consulta não passa por um servidor do CausaGanha.
      </p>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '10', md: '14' }, display: 'grid', gap: '8' })}>
    <div class={alert({ tone: 'info' })}>
      <strong>Comece escolhendo tribunal e ano.</strong>
      <span>Os templates montam caminhos `read_parquet(...)` para comunicações, advogados, vínculos e processos.</span>
      <a href="https://archive.org/details/causaganha-dashboard">Ver arquivos no Internet Archive ↗</a>
    </div>

    <div class={css({ minW: '0', background: 'surface', border: '1px solid', borderColor: 'text', p: { base: '4', md: '6' } })}>
      <DuckDBExplorer client:only="svelte" publicBase={BASE} />
    </div>
  </section>
</Layout>
