---
import Layout from '../layouts/Layout.astro';
import McpConfigCard from '../components/McpConfigCard.svelte';
import { css } from '../../styled-system/css';
import { alert, badge, card } from '../../styled-system/recipes';

const localConfig = `{
  "mcpServers": {
    "causaganha": {
      "command": "uv",
      "args": ["run", "--directory", "/caminho/para/causaganha", "causaganha-mcp"]
    }
  }
}`;

const jobs = [
  ['Arquivo', 'processo_consultar', 'O que sabemos sobre este processo?', 'Reúne evidências preservadas e deixa explícito onde há ou não cobertura.'],
  ['Arquivo', 'publicacoes_buscar', 'Quais publicações foram preservadas?', 'Busca comunicações por processo, parte, advogado, OAB, texto, tribunal ou período.'],
  ['Estado', 'processo_estado', 'Qual é o estado processual disponível?', 'Consulta estado oficial disponível sem confundi-lo com um snapshot histórico.'],
  ['Teor', 'decisoes_buscar', 'Há decisão ou acórdão — e o que diz?', 'Pesquisa teor decisório nas fontes suportadas, preservando origem e limitações.'],
];
---

<Layout
  title="CausaGanha para agentes — MCP"
  description="Conecte um agente ao CausaGanha para consultar arquivo, estado processual e teor com proveniência e limitações explícitas."
  fullWidth={true}
  showNetworkBanner={false}
>
  <section class={css({ background: 'text', color: 'canvas', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '20' } })}>
      <span class={badge({ tone: 'accent' })}>MCP · somente leitura</span>
      <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, color: 'canvas', m: '0', mt: '5', maxW: '10ch' })}>Pergunte ao acervo.</h1>
      <p class={css({ mt: '6', mb: '0', maxW: '52rem', color: 'surfaceMuted', fontSize: 'lg', lineHeight: 'body' })}>
        O agente recebe ferramentas orientadas a tarefas. A resposta continua dizendo qual fonte sustentou cada dado, quão recente ela é e onde há lacunas.
      </p>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '18' } })}>
    <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '3' })}>Quatro jobs</p>
    <h2 class={css({ textStyle: 'title', m: '0', mb: '8', maxW: '16ch' })}>Arquivo, estado e teor continuam separados.</h2>
    <div class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: '1fr 1fr' }, gap: '4' })}>
      {jobs.map(([role, tool, title, description]) => (
        <article class={card()} data-mcp-tool={tool}>
          <span class={badge({ tone: role === 'Arquivo' ? 'accent' : role === 'Estado' ? 'info' : 'neutral' })}>{role}</span>
          <h3 class={css({ mt: '5', mb: '3', fontSize: 'xl' })}>{title}</h3>
          <p class={css({ m: '0', color: 'textMuted', lineHeight: 'body' })}>{description}</p>
          {tool === 'decisoes_buscar' && (
            <ul class={css({ listStyle: 'none', p: '0', mt: '5', mb: '0', display: 'flex', flexWrap: 'wrap', gap: '2' })} aria-label="Fontes reconhecidas por decisoes_buscar">
              <li data-mcp-fonte="juris" data-mcp-status="published"><span class={badge({ tone: 'neutral' })}>JURIS</span></li>
              <li data-mcp-fonte="stj" data-mcp-status="published"><span class={badge({ tone: 'neutral' })}>STJ</span></li>
              <li data-mcp-fonte="tcu" data-mcp-status="unpublished"><span class={badge({ tone: 'attention' })}>TCU · ainda não publicada</span></li>
            </ul>
          )}
        </article>
      ))}
    </div>
  </section>

  <section id="conectar" class={css({ background: 'surfaceMuted', borderTop: '1px solid', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '18' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: '0.85fr 1.15fr' }, gap: '10', alignItems: 'start' })}>
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '3' })}>Conexão local</p>
        <h2 class={css({ textStyle: 'title', m: '0', maxW: '12ch' })}>Um servidor MCP. Sem endpoint inventado.</h2>
        <p class={css({ mt: '5', mb: '5', color: 'text', lineHeight: 'body' })}>Com o repositório clonado e `uv` disponível, a configuração abaixo inicia o entrypoint stdio canônico.</p>
        <div class={alert({ tone: 'info' })}>
          <strong>Remoto ainda não é oficial.</strong>
          <span>O caminho HTTP entra aqui somente depois de existir URL estável e smoke real com cliente novo.</span>
        </div>
      </div>
      <McpConfigCard config={localConfig} label="stdio" client:load />
    </div>
  </section>
</Layout>