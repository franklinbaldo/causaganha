---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import QueryCard from '../components/QueryCard.astro';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const queries = [
  {
    title: 'Top tribunais por volume',
    description: 'Mostra os 10 tribunais com mais comunicações disponíveis.',
    sql: `SELECT tribunal, COUNT(*) AS total\nFROM comunicacoes\nGROUP BY tribunal\nORDER BY total DESC\nLIMIT 10;`,
  },
  {
    title: 'Taxa de outcome conhecido',
    description: 'Percentual de classificações com resultado diferente de UNKNOWN.',
    sql: `SELECT\n  ROUND(100.0 * SUM(CASE WHEN outcome <> 'UNKNOWN' THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_conhecido\nFROM classificacoes;`,
  },
  {
    title: 'Advogados mais recorrentes',
    description: 'Advogados com mais aparições em comunicações.',
    sql: `SELECT a.nome, COUNT(*) AS aparicoes\nFROM comunicacao_advogados ca\nJOIN advogados a ON a.id = ca.advogado_id\nGROUP BY a.nome\nORDER BY aparicoes DESC\nLIMIT 20;`,
  },
];
---

<Layout title="Consultas SQL — CausaGanha" description="Consultas prontas para acelerar o uso do Explorador DuckDB.">
  <Header variant="page" title="Consultas Prontas" subtitle="Exemplos SQL para usar no explorador" backHref={BASE + 'explorador'} backLabel="Explorador" tile="consultas" />

  <div class="container">
    <Breadcrumbs crumbs={[{ label: 'Início', href: BASE }, { label: 'Consultas' }]} />

    <p class="intro-text">Copie e adapte os blocos abaixo no <a class="link" href={BASE + 'explorador'}>Explorador de Dados</a>.</p>

    <section class="queries-grid">
      {queries.map((query) => <QueryCard {...query} />)}
    </section>
  </div>
</Layout>
