---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Página não encontrada — CausaGanha"
  description="O endereço não existe ou foi movido. Use a busca ou volte ao início para encontrar publicações judiciais arquivadas."
>
  <PageHeader title="Página não encontrada" backHref={BASE} backLabel="Início" tile="404" />

  <section class="container">
    <hgroup>
      <p class="error-code" aria-hidden="true">404</p>
      <p>
        O endereço não existe ou foi movido. Se você chegou por um link antigo, este conteúdo pode ainda não ter sido coletado — tente a busca ou volte ao início.
      </p>
    </hgroup>
    <div>
      <a href={BASE + 'publicacoes'} role="button">Buscar publicações</a>
      <a href={BASE} role="button" class="secondary outline">Início</a>
    </div>
  </section>
</Layout>

<style>
  /* Decorative digit, not a heading — PageHeader above already renders the
     page's one heading ("Página não encontrada"). See not-found.feature. */
  .error-code {
    font-size: clamp(2.5rem, 10vw, 6rem);
    font-weight: 800;
    line-height: 1;
    margin: 0;
    color: var(--color-content);
  }
</style>
