---
import Layout from '../layouts/Layout.astro';
import { css } from '../../styled-system/css';
import { button } from '../../styled-system/recipes';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Página não encontrada — CausaGanha"
  description="O endereço não existe ou foi movido. Use a busca ou volte ao início."
  fullWidth={true}
>
  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '16', md: '28' }, display: 'grid', gridTemplateColumns: { base: '1fr', md: '0.7fr 1.3fr' }, gap: '10', alignItems: 'end' })}>
    <p class={css({ m: '0', textStyle: 'display', color: 'attention' })} aria-hidden="true">404</p>
    <div>
      <h1 class={css({ textStyle: 'title', fontSize: '2xl', m: '0' })}>Página não encontrada</h1>
      <p class={css({ mt: '5', mb: '7', maxW: '38rem', color: 'textMuted', fontSize: 'lg', lineHeight: 'body' })}>O endereço não existe ou foi movido. Tente procurar a publicação ou volte ao início.</p>
      <div class={css({ display: 'flex', flexWrap: 'wrap', gap: '3' })}>
        <a class={button({ visual: 'solid' })} href={BASE + 'publicacoes'}>Buscar publicações</a>
        <a class={button({ visual: 'outline' })} href={BASE}>Início</a>
      </div>
    </div>
  </section>
</Layout>
