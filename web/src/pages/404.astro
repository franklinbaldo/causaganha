---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Página não encontrada — CausaGanha"
  description="O endereço não existe ou foi movido. Use a busca ou volte ao início para encontrar publicações judiciais arquivadas."
>
  <Header variant="page" title="Página não encontrada" backHref={BASE} backLabel="Início" tile="404" />

  <div class="hero">
    <div class="hero-inner">
      <p class="error-code" aria-hidden="true">404</p>
      <p class="error-message">
        O endereço não existe ou foi movido. Se você chegou por um link antigo, este conteúdo pode ainda não ter sido coletado — tente a busca ou volte ao início.
      </p>
      <div class="action-buttons">
        <a href={BASE + 'publicacoes'} role="button">Buscar publicações</a>
        <a href={BASE} role="button" class="secondary outline">Início</a>
      </div>
    </div>
  </div>
</Layout>
