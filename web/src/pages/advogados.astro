---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LawyerCard from '../components/LawyerCard.astro';
import StatCard from '../components/StatCard.astro';
import AlertBanner from '../components/AlertBanner.svelte';
import { readJson } from '../lib/readJson';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const backfill = readJson<any>('cache/backfill.json');
const tribunalStats = (backfill?.tribunal_stats ?? [])
  .map((item: any) => ({
    tribunal: item.tribunal,
    dataRatePct: Number(item.data_rate_pct ?? 0),
    daysWithData: Number(item.days_with_data ?? 0),
    daysTotal: Number(item.days_total ?? 0),
  }))
  .sort((a: any, b: any) => b.dataRatePct - a.dataRatePct)
  .slice(0, 12);
const avgCoverage = tribunalStats.length
  ? tribunalStats.reduce((sum: number, item: any) => sum + item.dataRatePct, 0) / tribunalStats.length
  : 0;
---

<Layout title="Advogados — CausaGanha" description="Cobertura por tribunal para exploração de dados de advogados/OAB no acervo público.">
  <Header variant="page" title="Advogados / OAB" subtitle="Cobertura por tribunal para consultas de advogados" backHref={BASE} backLabel="Início" tile="advogados" />

  <div class="container">
    <Breadcrumbs crumbs={[{ label: 'Início', href: BASE }, { label: 'Advogados' }]} />

    <div class="alert-wrapper">
      <AlertBanner
        level="info"
        title="Ranking de atividade disponível; ranking de qualidade em validação"
        message="Um ranking descritivo por volume de atuação (quem aparece em mais comunicações) está publicado na home. O ranking de qualidade (vitórias/derrotas via OpenSkill) permanece em validação até o classificador atingir a meta de precisão."
      />
    </div>

    <section class="stats-grid">
      <StatCard title="Tribunais exibidos" value={tribunalStats.length} subtitle="Com melhor cobertura recente" />
      <StatCard title="Cobertura média" value={`${avgCoverage.toFixed(1)}%`} subtitle="Dias com dados / dias totais" tone="info" />
      <StatCard title="Fonte" value="Backfill snapshot" subtitle="Mesmo snapshot usado no dashboard" />
    </section>

    <section class="cards-grid">
      {tribunalStats.map((index: { tribunal: string; dataRatePct: number; daysWithData: number; daysTotal: number }) => <LawyerCard index={index} />)}
    </section>
  </div>
</Layout>
