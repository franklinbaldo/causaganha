---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SavedConsultations from '../components/SavedConsultations.svelte';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="Minhas consultas — CausaGanha"
  description="Guarde processos que você consulta com frequência, somente neste navegador e sem criar conta."
>
  <PageHeader
    backHref={BASE}
    backLabel="Início"
    tile="consultas"
    title="Minhas consultas"
    subtitle="Uma pequena bancada local para os processos aos quais você quer voltar"
  />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'Minhas consultas' },
    ]} />

    <SavedConsultations client:load />

    <aside class="local-note" aria-labelledby="local-note-title">
      <strong id="local-note-title">Privacidade por desenho</strong>
      <p>
        Esta lista usa apenas o armazenamento local do navegador. O CausaGanha não recebe os CNJs
        que você salva aqui. Em outro dispositivo ou navegador, a lista será diferente.
      </p>
    </aside>
  </div>
</Layout>

<style>
  .local-note {
    margin: var(--s-8, 2rem) 0;
    padding: var(--s-4, 1rem);
    border-left: 4px solid var(--verde, var(--color-accent));
    background: var(--papel-20, var(--color-surface));
  }

  .local-note p {
    margin-bottom: 0;
  }
</style>
