---
import Layout from '../layouts/Layout.astro';
import SavedConsultations from '../components/SavedConsultations.svelte';
import { css } from '../../styled-system/css';
import { alert, badge } from '../../styled-system/recipes';
---

<Layout
  title="Minhas consultas — CausaGanha"
  description="Guarde processos e buscas neste navegador, sem conta e sem enviar a lista ao CausaGanha."
  fullWidth={true}
>
  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '12', md: '18' } })}>
    <span class={badge({ tone: 'accent' })}>Local ao navegador</span>
    <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '5', maxW: '10ch' })}>Volte ao que importa.</h1>
    <p class={css({ mt: '6', mb: '0', maxW: '44rem', color: 'textMuted', fontSize: 'lg', lineHeight: 'body' })}>
      Processos e buscas salvos ficam só neste navegador. É uma bancada local, não uma conta nem um monitoramento remoto.
    </p>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, pb: { base: '12', md: '18' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: '1.3fr 0.7fr' }, gap: '8', alignItems: 'start' })}>
    <div class={css({ background: 'surface', border: '1px solid', borderColor: 'text', p: { base: '5', md: '8' } })}>
      <SavedConsultations client:load />
    </div>
    <aside class={alert({ tone: 'success' })}>
      <strong>Privacidade por desenho.</strong>
      <span>A lista usa armazenamento local. Em outro navegador ou dispositivo, ela será diferente.</span>
    </aside>
  </section>
</Layout>
