---
import Layout from '../layouts/Layout.astro';
import { css } from '../../styled-system/css';
import { badge, button, card } from '../../styled-system/recipes';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sources = [
  ['Arquivo', 'DJEN', 'Publicações preservadas e cobertura do acervo.'],
  ['Estado', 'DataJud', 'Capa, classe, assuntos e movimentos processuais.'],
  ['Teor', 'TJRO JURIS', 'Decisões e documentos quando presentes no corpus.'],
  ['Teor', 'STJ', 'Acórdãos e metadados ligados ao processo quando disponíveis.'],
];
---

<Layout
  title="Projeto & dados — CausaGanha"
  description="Entenda o que o CausaGanha consulta, preserva e publica, e como cada fato permanece ligado à sua fonte."
  fullWidth={true}
  showNetworkBanner={false}
>
  <section class={css({ background: 'surfaceMuted', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '20' } })}>
      <span class={badge({ tone: 'info' })}>Projeto & dados</span>
      <h1 class={css({ textStyle: 'display', fontSize: { base: '2xl', md: '3xl' }, m: '0', mt: '5', maxW: '10ch' })}>A fonte continua visível.</h1>
      <p class={css({ mt: '6', mb: '0', maxW: '52rem', color: 'textMuted', fontSize: 'lg', lineHeight: 'body' })}>
        O CausaGanha combina fontes públicas sem fingir que elas dizem a mesma coisa. Arquivo, estado processual e teor podem aparecer juntos — mas a origem de cada informação permanece explícita.
      </p>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '20' } })}>
    <div class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: '0.7fr 1.3fr' }, gap: '10', alignItems: 'start' })}>
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '3' })}>Quatro fontes</p>
        <h2 class={css({ textStyle: 'title', m: '0', maxW: '12ch' })}>Cada uma sustenta uma parte do quadro.</h2>
      </div>
      <div class={css({ display: 'grid', gap: '3' })}>
        {sources.map(([role, name, description]) => (
          <article class={card()}>
            <div class={css({ display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '4', flexWrap: 'wrap' })}>
              <span class={badge({ tone: role === 'Arquivo' ? 'accent' : role === 'Estado' ? 'info' : 'neutral' })}>{role}</span>
              <strong>{name}</strong>
            </div>
            <p class={css({ mb: '0', mt: '4', color: 'textMuted', lineHeight: 'body' })}>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class={css({ background: 'text', color: 'canvas' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '18' }, display: 'grid', gridTemplateColumns: { base: '1fr', md: '1fr auto' }, gap: '8', alignItems: 'end' })}>
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'accent', mb: '3' })}>Dados abertos</p>
        <h2 class={css({ textStyle: 'title', fontSize: '2xl', color: 'canvas', m: '0', maxW: '16ch' })}>Você pode reproduzir a consulta fora do site.</h2>
        <p class={css({ mt: '5', mb: '0', maxW: '46rem', color: 'surfaceMuted', lineHeight: 'body' })}>Catálogo, manifestos e Parquets públicos permitem conferir cobertura e refazer análises sem depender da interface.</p>
      </div>
      <div class={css({ display: 'flex', flexWrap: 'wrap', gap: '3' })}>
        <a class={button({ visual: 'solid' })} href="https://archive.org/details/causaganha-catalog">Abrir catálogo ↗</a>
        <a class={button({ visual: 'light' })} href={BASE + 'agentes'}>Usar com agentes</a>
      </div>
    </div>
  </section>
</Layout>
