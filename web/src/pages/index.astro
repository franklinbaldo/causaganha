---
import Layout from '../layouts/Layout.astro';
import {
  loadSiteStatus,
  evaluateSourceFreshness,
  freshnessDisplayLabel,
  formatUtcDateTime,
} from '../lib/data/siteStatus';

// Métricas globais vêm exclusivamente do artefato canônico site-status.json
// (contrato site_status, renderizado do sync-manifest.parquet). Sem números
// hardcoded, sem snapshots paralelos; artefato ausente/obsoleto = build falha.
const siteStatus = await loadSiteStatus();
const djen = siteStatus.sources.djen;
const totalZips = djen.zips_archived;
const tribunalsWithData = djen.tribunals_with_data;
const tribunalsTotal = djen.tribunals_total;
const gaps = djen.pending_real + djen.errors_transient + djen.never_checked;
const djenFreshness = evaluateSourceFreshness(djen, Date.now());
const freshnessLabel = freshnessDisplayLabel(djenFreshness);
const sinceYear = (djen.earliest_upload_date ?? '').slice(0, 4) || null;
const lastAttempt = formatUtcDateTime(djen.last_attempt_at);
const lastSuccess = formatUtcDateTime(djen.last_success_at);
const generatedAtLabel = formatUtcDateTime(siteStatus.generated_at) ?? 'desconhecido';

function fmt(n: number): string {
  return n.toLocaleString('pt-BR');
}

function fmtDate(iso: string | null): string {
  if (!iso) return '--';
  const [y, m, d] = iso.split('-');
  return `${d}/${m}/${y}`;
}

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const sources = [
  {
    sigla: 'DJEN',
    papel: 'Arquivo',
    title: 'O que foi publicado.',
    body: 'Comunicações judiciais preservadas no Internet Archive, com busca, cobertura e ZIP original.',
  },
  {
    sigla: 'DataJud',
    papel: 'Estado',
    title: 'Onde o processo está.',
    body: 'Capa, classe, assuntos, órgão, grau, datas e movimentos processuais registrados pelo CNJ.',
  },
  {
    sigla: 'TJRO JURIS',
    papel: 'Teor',
    title: 'O que a decisão diz.',
    body: 'Decisões e documentos de jurisprudência do TJRO quando presentes no corpus publicado.',
  },
  {
    sigla: 'STJ',
    papel: 'Teor',
    title: 'O que chegou ao tribunal superior.',
    body: 'Acórdãos e metadados do STJ vinculados ao processo quando a fonte correspondente tem registro.',
  },
];
---

<Layout
  title="CausaGanha — o rastro verificável do processo judicial"
  description="Consulte processos, pesquise publicações e acompanhe a proveniência entre DJEN, TJRO JURIS, STJ e DataJud sobre um arquivo público reproduzível."
  fullWidth={true}
  showNetworkBanner={false}
>
  <header class="hero" aria-labelledby="hero-title">
    <div class="hero__inner">
      <span class="kicker">§ Consulta pública · fontes oficiais · proveniência explícita</span>
      <h1 class="mega" id="hero-title">Um processo deixa<br/>rastros <em>diferentes.</em></h1>
      <p class="hero__lede">
        Consulte um número CNJ para ver o que diferentes fontes oficiais registram sobre o mesmo processo.
        Pesquise também publicações do DJEN por OAB, parte ou texto livre. O CausaGanha preserva o arquivo,
        reconcilia as fontes e mantém visível de onde veio cada fato.
      </p>
      <form class="hero__search" action={BASE + 'publicacoes'} method="get" role="search" data-processo-href={BASE + 'processo'}>
        <fieldset role="group">
          <input
            class="input hero__search-input"
            data-global-search
            name="texto"
            type="search"
            placeholder="0001234-56.2024.8.26.0100  ·  OAB/SP 245.812  ·  texto livre"
            autocomplete="off"
            aria-label="Consultar processo ou buscar publicações"
          />
          <button class="btn btn--accent" type="submit">Buscar →</button>
        </fieldset>
      </form>
      <div class="hero__chips" aria-label="Exemplos de busca">
        <button class="search-hint" data-q="0001234-56.2024.8.26.0100" type="button">
          <span class="hero__chip-k">CNJ</span> <b>0001234-56.2024.8.26.0100</b>
        </button>
        <button class="search-hint" data-q="OAB/SP 245.812" type="button">
          <span class="hero__chip-k">OAB</span> <b>OAB/SP 245.812</b>
        </button>
        <button class="search-hint" data-q="Banco Itaú" type="button">
          <span class="hero__chip-k">parte</span> <b>Banco Itaú</b>
        </button>
        <button class="search-hint" data-q="previdenciário" type="button">
          <span class="hero__chip-k">tema</span> <b>previdenciário</b>
        </button>
      </div>
      <dl class="hero__meta">
        <div><dt class="k">ZIPs DJEN preservados</dt><dd class="v">{fmt(totalZips)}</dd></div>
        <div><dt class="k">Tribunais no arquivo</dt><dd class="v">{tribunalsWithData} de {tribunalsTotal}</dd></div>
        <div><dt class="k">Espelho público</dt><dd class="v">archive.org</dd></div>
        <div><dt class="k">Última data DJEN</dt><dd class="v">{fmtDate(djen.latest_upload_date)}</dd></div>
      </dl>
    </div>
  </header>

  <section aria-labelledby="sources-h" class="source-section">
    <div class="wrap wrap--wide">
      <div class="sec-head">
        <span class="sec-num">§01 — Um CNJ, evidências diferentes</span>
        <h2 id="sources-h">Arquivo, estado e teor <em>não são a mesma coisa.</em></h2>
        <p class="lede">
          O CausaGanha não cola tudo numa resposta sem origem. Cada fonte prova uma coisa diferente — e pode ter cobertura diferente para o mesmo processo.
        </p>
      </div>
      <div class="source-grid">
        {sources.map((source) => (
          <article class="card source-card">
            <div class="source-card__head">
              <span class="kicker">{source.sigla}</span>
              <span class="source-card__role">{source.papel}</span>
            </div>
            <h3>{source.title}</h3>
            <p>{source.body}</p>
          </article>
        ))}
      </div>
      <p class="source-note">
        Uma fonte ausente para um CNJ não significa automaticamente que o fato não existe. O dossiê distingue fontes presentes, cobertura do dataset e avisos de indisponibilidade sempre que o contrato permite.
      </p>
    </div>
  </section>

  <section aria-labelledby="archive-h">
    <div class="wrap wrap--wide">
      <div class="sec-head">
        <span class="sec-num">§02 — A fundação é pública</span>
        <h2 id="archive-h">O arquivo DJEN é <em>prova e infraestrutura.</em></h2>
        <p class="lede">
          O CausaGanha preserva o original e publica o estado da própria coleta. Estes números vêm do manifesto canônico em archive.org, renderizado neste build em {generatedAtLabel}.
        </p>
      </div>
      <div class="grid-4">
        <article class="card">
          <div class="kicker">Rastreado</div>
          <div class="stat__n stat__n--azul">{fmt(djen.pairs_total)}</div>
          <div class="stat__label">Pares tribunal × dia no manifesto</div>
          <div class="stat__sub">{djen.earliest_tracked_date ? `desde ${fmtDate(djen.earliest_tracked_date)}` : 'intervalo indisponível'}</div>
        </article>
        <article class="card card--azul">
          <div class="kicker">Preservado</div>
          <div class="stat__n" style="color: var(--ocre);">{fmt(totalZips)}</div>
          <div class="stat__label">ZIPs originais no Internet Archive</div>
          <div class="stat__sub" style="color: rgba(255,255,255,0.6);">{sinceYear ? `desde ${sinceYear} · ` : ''}{tribunalsWithData} tribunais com dados</div>
        </article>
        <article class="card">
          <div class="kicker">Lacunas honestas</div>
          <div class="stat__n stat__n--ocre">{fmt(gaps)}</div>
          <div class="stat__label">Pares sem ZIP, com caderno possível</div>
          <div class="stat__sub">exclui {fmt(djen.absent_confirmed)} ausências confirmadas</div>
        </article>
        <article class="card card--sunken">
          <div class="kicker">Fonte DJEN</div>
          <div class="stat__n stat__n--accent" aria-label={`Estado da fonte DJEN: ${freshnessLabel}`}>
            <span class="stat__live-badge">{freshnessLabel}</span>
          </div>
          <div class="stat__label">Freshness da sincronização</div>
          <div class="stat__sub">tentativa {lastAttempt ?? 'desconhecida'} · sucesso {lastSuccess ?? 'desconhecido'}</div>
        </article>
      </div>
      <div class="archive-actions">
        <a class="btn" href={BASE + 'stats'}>Explorar cobertura →</a>
        <a class="btn" href={BASE + 'sobre'}>Entender a metodologia →</a>
      </div>
    </div>
  </section>

  <section aria-labelledby="interfaces-h" class="interfaces-section">
    <div class="wrap wrap--wide">
      <div class="sec-head">
        <span class="sec-num">§03 — O mesmo sistema, três interfaces</span>
        <h2 id="interfaces-h">Navegue, reproduza ou <em>consulte por agente.</em></h2>
      </div>
      <div class="grid-3">
        <article class="card interface-card">
          <div class="kicker">01 · Site</div>
          <h3>Consulte sem montar infraestrutura.</h3>
          <p>Abra um dossiê por CNJ, pesquise publicações e explore cobertura diretamente no navegador.</p>
          <a href={BASE + 'processo'}>Consultar processo →</a>
        </article>
        <article class="card interface-card">
          <div class="kicker">02 · Dados</div>
          <h3>Leve o acervo para o seu DuckDB.</h3>
          <p>ZIPs, Parquets, manifesto e catálogo SQL ficam públicos e reproduzíveis no Internet Archive.</p>
          <a href={BASE + 'sobre'}>Ver acesso aos dados →</a>
        </article>
        <article class="card interface-card">
          <div class="kicker">03 · Agentes</div>
          <h3>Use a mesma proveniência via MCP.</h3>
          <p>O servidor read-only expõe status, facetas DataJud e o dossiê processual para assistentes compatíveis.</p>
          <a href="https://github.com/franklinbaldo/causaganha#3-agentes--mcp">Ver MCP no GitHub →</a>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="why-h">
    <div class="wrap wrap--wide">
      <div class="sec-head">
        <span class="sec-num">§04 — Por que isso importa</span>
        <h2 id="why-h">Preservar não basta. É preciso <em>saber o que cada registro prova.</em></h2>
      </div>
      <div class="grid-3">
        <article class="card">
          <div class="kicker">Memória</div>
          <h3>O efêmero tem peso jurídico.</h3>
          <p>Publicações desaparecem de superfícies, URLs mudam e integrações quebram. O original preservado mantém uma referência pública durável.</p>
        </article>
        <article class="card">
          <div class="kicker">Proveniência</div>
          <h3>Movimento não é inteiro teor.</h3>
          <p>DataJud pode dizer que houve uma sentença; somente a fonte textual adequada pode sustentar o que a sentença decidiu e por quê.</p>
        </article>
        <article class="card">
          <div class="kicker">Auditoria</div>
          <h3>Lacuna também é informação.</h3>
          <p>O sistema distingue ausência confirmada, erro transitório, fonte indisponível e dado ainda não observado em vez de esconder tudo atrás de “não encontrado”.</p>
        </article>
      </div>
      <blockquote class="pull" style="margin-top: var(--s-8);">
        O valor do CausaGanha não é produzir uma resposta única. É permitir que você veja <em>qual evidência sustenta cada parte dela.</em>
      </blockquote>
    </div>
  </section>
</Layout>

<script>
  import { buildHeroSearchRedirect } from '../lib/processoCnj';

  const heroForm = document.querySelector<HTMLFormElement>('.hero__search');
  const heroInput = heroForm?.querySelector<HTMLInputElement>('input[name="texto"]');

  heroForm?.addEventListener('submit', (event) => {
    const raw = heroInput?.value ?? '';
    const processoHref = heroForm.dataset.processoHref ?? 'processo';
    const redirect = buildHeroSearchRedirect(raw, processoHref);
    if (!redirect) return;
    event.preventDefault();
    window.location.href = redirect;
  });

  document.querySelectorAll<HTMLButtonElement>('.search-hint').forEach((button) => {
    button.addEventListener('click', () => {
      if (!heroInput) return;
      heroInput.value = button.dataset.q ?? '';
      heroInput.focus();
    });
  });
</script>

<style>
  .source-section,
  .interfaces-section {
    background: var(--papel-20);
    border-block: 1.5px solid var(--concreto-90);
  }

  .source-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-3);
  }

  .source-card {
    min-height: 16rem;
    display: flex;
    flex-direction: column;
  }

  .source-card__head {
    display: flex;
    justify-content: space-between;
    gap: var(--s-2);
    align-items: center;
  }

  .source-card__role {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    border: 1px solid var(--border);
    padding: 0.2rem 0.45rem;
  }

  .source-card h3,
  .interface-card h3 {
    margin-top: auto;
  }

  .source-note {
    margin-top: var(--s-5);
    max-width: 72ch;
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--fg-muted);
  }

  .archive-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-5);
  }

  .interface-card a {
    display: inline-block;
    margin-top: auto;
    font-family: var(--font-mono);
    font-weight: 700;
  }

  @media (max-width: 64rem) {
    .source-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .source-grid {
      grid-template-columns: 1fr;
    }

    .source-card {
      min-height: auto;
    }
  }
</style>
