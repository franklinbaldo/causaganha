---
import Layout from '../layouts/Layout.astro';
import { loadSiteStatus, evaluateSourceFreshness, freshnessDisplayLabel } from '../lib/data/siteStatus';

const siteStatus = await loadSiteStatus();
const djen = siteStatus.sources.djen;
const freshnessLabel = freshnessDisplayLabel(evaluateSourceFreshness(djen, Date.now()));
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

function fmt(n: number): string {
  return n.toLocaleString('pt-BR');
}

const roles = [
  { label: 'Arquivo', source: 'DJEN', text: 'O que foi publicado e preservado.' },
  { label: 'Estado', source: 'DataJud', text: 'Onde o processo está e quais movimentos constam.' },
  { label: 'Teor', source: 'JURIS · STJ', text: 'O que decisões e acórdãos efetivamente dizem.' },
];
---

<Layout
  title="CausaGanha — consulte o rastro verificável de um processo"
  description="Consulte processos e publicações judiciais com origem, cobertura e proveniência explícitas."
  fullWidth={true}
  showNetworkBanner={false}
>
  <header class="hero" aria-labelledby="hero-title">
    <div class="hero__inner home-hero">
      <span class="kicker">Consulta pública · fontes oficiais</span>
      <h1 class="mega" id="hero-title">Encontre o processo.<br/><em>Veja a evidência.</em></h1>
      <p class="hero__lede">
        Consulte um CNJ ou pesquise publicações. O CausaGanha mostra de onde veio cada informação e deixa claras as lacunas de cobertura.
      </p>

      <form class="hero__search" action={BASE + 'publicacoes'} method="get" role="search" data-processo-href={BASE + 'processo'}>
        <fieldset role="group">
          <input
            class="input hero__search-input"
            data-global-search
            name="texto"
            type="search"
            placeholder="Número CNJ, OAB, parte ou texto"
            autocomplete="off"
            aria-label="Consultar processo ou pesquisar publicações"
            aria-describedby="hero-search-hint"
          />
          <button class="btn btn--accent" type="submit">Buscar →</button>
        </fieldset>
        <p class="hero__search-hint" id="hero-search-hint" aria-live="polite" hidden></p>
      </form>

      <div class="home-actions" aria-label="Ações principais">
        <a class="home-action home-action--primary" href={BASE + 'processo'}>
          <span class="kicker">Por número CNJ</span>
          <strong>Consultar processo</strong>
          <span>Abra um dossiê reunindo as fontes disponíveis.</span>
        </a>
        <a class="home-action" href={BASE + 'publicacoes'}>
          <span class="kicker">Por OAB, parte ou texto</span>
          <strong>Pesquisar publicações</strong>
          <span>Procure comunicações preservadas do DJEN.</span>
        </a>
      </div>

      <div class="home-proof" aria-label="Estado do arquivo DJEN">
        <span><b>{fmt(djen.zips_archived)}</b> ZIPs preservados</span>
        <span><b>{djen.tribunals_with_data}</b> tribunais com dados</span>
        <span><b>{freshnessLabel}</b> atualização DJEN</span>
        <a href={BASE + 'stats'}>Ver cobertura →</a>
      </div>
    </div>
  </header>

  <main class="home-main">
    <section class="home-section" aria-labelledby="roles-title">
      <div class="wrap wrap--wide home-section__inner">
        <div class="home-section__intro">
          <span class="kicker">Como ler o resultado</span>
          <h2 id="roles-title">Fontes diferentes respondem perguntas diferentes.</h2>
          <p>O site mantém arquivo, estado processual e teor separados para você saber o que cada registro realmente sustenta.</p>
        </div>
        <div class="role-list">
          {roles.map((role) => (
            <article class="role-item">
              <span class="role-item__label">{role.label}</span>
              <div>
                <strong>{role.source}</strong>
                <p>{role.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="home-section home-section--quiet" aria-labelledby="more-title">
      <div class="wrap wrap--wide home-more">
        <div>
          <span class="kicker">Mais</span>
          <h2 id="more-title">Use os dados sem perder a origem.</h2>
        </div>
        <nav class="home-more__links" aria-label="Outras formas de usar o CausaGanha">
          <a href={BASE + 'minhas-consultas'}>Minhas consultas <span>→</span></a>
          <a href={BASE + 'agentes'}>Usar com um agente <span>→</span></a>
          <a href={BASE + 'explorador'}>Explorar os dados <span>→</span></a>
          <a href={BASE + 'sobre'}>Projeto e metodologia <span>→</span></a>
        </nav>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { buildHeroSearchRedirect } from '../lib/processoCnj';
  import { attachHeroSearchHint } from '../lib/heroSearchHint';

  const heroForm = document.querySelector<HTMLFormElement>('.hero__search');
  const heroInput = heroForm?.querySelector<HTMLInputElement>('input[name="texto"]');
  const heroHint = heroForm?.querySelector<HTMLElement>('#hero-search-hint');

  if (heroInput && heroHint) attachHeroSearchHint(heroInput, heroHint);

  heroForm?.addEventListener('submit', (event) => {
    const raw = heroInput?.value ?? '';
    const processoHref = heroForm.dataset.processoHref ?? 'processo';
    const redirect = buildHeroSearchRedirect(raw, processoHref);
    if (!redirect) return;
    event.preventDefault();
    window.location.href = redirect;
  });
</script>

<style>
  .home-hero {
    padding-block: clamp(4rem, 9vw, 7.5rem) clamp(3rem, 6vw, 5rem);
  }

  .home-hero .mega {
    max-width: 12ch;
    margin-block: var(--s-3) var(--s-4);
  }

  .home-hero .hero__lede {
    max-width: 48rem;
    font-size: clamp(1.05rem, 2vw, 1.35rem);
  }

  .hero__search {
    max-width: 52rem;
    margin-top: var(--s-7);
  }

  .home-actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-3);
    max-width: 52rem;
    margin-top: var(--s-5);
  }

  .home-action {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    border: 1px solid var(--border);
    background: var(--papel-00);
    color: var(--fg);
    text-decoration: none;
    transition: transform 120ms ease, border-color 120ms ease;
  }

  .home-action:hover,
  .home-action:focus-visible {
    transform: translateY(-2px);
    border-color: var(--verde, var(--color-accent));
  }

  .home-action--primary {
    border-width: 2px;
  }

  .home-action strong {
    font-size: var(--t-h3, 1.35rem);
  }

  .home-action > span:last-child {
    color: var(--fg-muted);
  }

  .home-proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    align-items: center;
    max-width: 60rem;
    margin-top: var(--s-6);
    padding-top: var(--s-4);
    border-top: 1px solid var(--border);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--t-micro);
  }

  .home-proof b {
    color: var(--fg);
  }

  .home-proof a {
    margin-left: auto;
  }

  .home-main {
    border-top: 1px solid var(--border);
  }

  .home-section {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .home-section--quiet {
    background: var(--papel-20);
    border-top: 1px solid var(--border);
  }

  .home-section__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .home-section__intro h2,
  .home-more h2 {
    max-width: 14ch;
    margin-block: var(--s-3);
  }

  .home-section__intro p {
    max-width: 36rem;
    color: var(--fg-muted);
  }

  .role-list {
    border-top: 1px solid var(--border);
  }

  .role-item {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--border);
  }

  .role-item__label {
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-muted);
  }

  .role-item p {
    margin: var(--s-1) 0 0;
    color: var(--fg-muted);
  }

  .home-more {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: start;
  }

  .home-more__links {
    display: grid;
    border-top: 1px solid var(--border);
  }

  .home-more__links a {
    display: flex;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--border);
    color: var(--fg);
    text-decoration: none;
    font-weight: 700;
  }

  .home-more__links a:hover,
  .home-more__links a:focus-visible {
    color: var(--verde, var(--color-accent));
  }

  @media (max-width: 48rem) {
    .home-actions,
    .home-section__inner,
    .home-more {
      grid-template-columns: 1fr;
    }

    .home-proof a {
      width: 100%;
      margin-left: 0;
    }

    .role-item {
      grid-template-columns: 5rem 1fr;
    }
  }
</style>
