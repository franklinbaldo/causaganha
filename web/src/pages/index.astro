---
import Layout from '../layouts/Layout.astro';
import { loadSiteStatus, evaluateSourceFreshness, freshnessDisplayLabel } from '../lib/data/siteStatus';
import { css } from '../../styled-system/css';
import { button, badge, card } from '../../styled-system/recipes';

const siteStatus = await loadSiteStatus();
const djen = siteStatus.sources.djen;
const freshnessLabel = freshnessDisplayLabel(evaluateSourceFreshness(djen, Date.now()));
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="CausaGanha — consulta judicial pública e verificável"
  description="Consulte processos e publicações judiciais com origem, cobertura e proveniência explícitas."
  fullWidth={true}
  showNetworkBanner={false}
>
  <section class={css({ background: 'text', color: 'canvas', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '16', md: '28' }, display: 'grid', gridTemplateColumns: { base: '1fr', lg: '1.25fr 0.75fr' }, gap: '12', alignItems: 'end' })}>
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'accent', mb: '6' })}>Consulta judicial pública</p>
        <h1 class={css({ textStyle: 'display', color: 'canvas', m: '0', maxW: '8.5ch' })}>Procure. Confira a fonte.</h1>
        <p class={css({ mt: '8', mb: '0', maxW: '44rem', color: 'surfaceMuted', fontSize: 'lg', lineHeight: 'body' })}>
          Um número CNJ abre o dossiê do processo. Nome, OAB ou termo livre pesquisa publicações do DJEN.
        </p>
        <div class={css({ display: 'flex', flexWrap: 'wrap', gap: '3', mt: '8' })}>
          <a class={button({ visual: 'solid' })} href={BASE + 'processo'}>Consultar processo</a>
          <a class={button({ visual: 'light' })} href={BASE + 'publicacoes'}>Pesquisar publicações</a>
        </div>
      </div>

      <div class={css({ display: 'grid', gap: '3' })}>
        <article class={card({ tone: 'dark' })}>
          <span class={badge({ tone: 'accent' })}>DJEN</span>
          <p class={css({ mt: '5', mb: '1', fontSize: '2xl', fontWeight: 'black', lineHeight: 'heading' })}>{freshnessLabel}</p>
          <p class={css({ m: '0', color: 'surfaceMuted', fontSize: 'sm' })}>{djen.tribunals_with_data} tribunais com dados publicados</p>
        </article>
        <div class={css({ display: 'grid', gridTemplateColumns: '1fr 1fr', minH: '9rem', border: '1px solid', borderColor: 'canvas' })} aria-hidden="true">
          <div class={css({ background: 'accent', borderRight: '1px solid', borderColor: 'text' })}></div>
          <div class={css({ background: 'attention' })}></div>
        </div>
      </div>
    </div>
  </section>

  <section class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '14', md: '20' } })}>
    <div class={css({ display: 'flex', alignItems: 'end', justifyContent: 'space-between', gap: '8', flexWrap: 'wrap', mb: '8' })}>
      <div>
        <p class={css({ textStyle: 'eyebrow', color: 'info', mb: '3' })}>Duas entradas principais</p>
        <h2 class={css({ textStyle: 'title', m: '0', maxW: '18ch' })}>Comece pelo que você quer descobrir.</h2>
      </div>
      <a class={button({ visual: 'outline', size: 'sm' })} href={BASE + 'minhas-consultas'}>Ver salvos</a>
    </div>

    <div class={css({ display: 'grid', gridTemplateColumns: { base: '1fr', md: '1fr 1fr' }, gap: '4' })}>
      <a href={BASE + 'processo'} class={css({ display: 'grid', minH: '18rem', p: { base: '6', md: '8' }, background: 'surface', color: 'text', border: '1px solid', borderColor: 'text', textDecoration: 'none', alignContent: 'space-between', _hover: { boxShadow: 'lift', transform: 'translateY(-2px)' } })}>
        <span class={badge({ tone: 'accent' })}>Processo</span>
        <div>
          <h3 class={css({ m: '0', fontSize: '2xl', lineHeight: 'heading', maxW: '13ch' })}>Veja o rastro do CNJ entre as fontes.</h3>
          <p class={css({ mt: '4', mb: '0', color: 'textMuted', lineHeight: 'body' })}>DJEN, DataJud, JURIS e STJ permanecem distinguíveis no resultado.</p>
        </div>
      </a>

      <a href={BASE + 'publicacoes'} class={css({ display: 'grid', minH: '18rem', p: { base: '6', md: '8' }, background: 'surfaceMuted', color: 'text', border: '1px solid', borderColor: 'text', textDecoration: 'none', alignContent: 'space-between', _hover: { boxShadow: 'lift', transform: 'translateY(-2px)' } })}>
        <span class={badge({ tone: 'info' })}>Publicações</span>
        <div>
          <h3 class={css({ m: '0', fontSize: '2xl', lineHeight: 'heading', maxW: '13ch' })}>Pesquise diretamente no DJEN.</h3>
          <p class={css({ mt: '4', mb: '0', color: 'textMuted', lineHeight: 'body' })}>Use CNJ, OAB, nome de parte ou texto livre e preserve o contexto da busca.</p>
        </div>
      </a>
    </div>
  </section>

  <section class={css({ background: 'accent', borderTop: '1px solid', borderBottom: '1px solid', borderColor: 'text' })}>
    <div class={css({ maxW: 'content', mx: 'auto', px: { base: '5', md: '8' }, py: { base: '10', md: '14' }, display: 'grid', gridTemplateColumns: { base: '1fr', md: 'repeat(3, 1fr)' }, gap: '6' })}>
      <div><span class={css({ textStyle: 'eyebrow' })}>Arquivo</span><p class={css({ m: '0', mt: '2', fontWeight: 'bold' })}>DJEN preservado</p></div>
      <div><span class={css({ textStyle: 'eyebrow' })}>Estado</span><p class={css({ m: '0', mt: '2', fontWeight: 'bold' })}>DataJud</p></div>
      <div><span class={css({ textStyle: 'eyebrow' })}>Teor</span><p class={css({ m: '0', mt: '2', fontWeight: 'bold' })}>JURIS e STJ</p></div>
    </div>
  </section>
</Layout>
