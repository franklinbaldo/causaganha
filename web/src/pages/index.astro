---
import Layout from '../layouts/Layout.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import Header from '../components/Header.astro';
import TribunalCoverageGrid from '../components/TribunalCoverageGrid.astro';
import { readJson } from '../lib/readJson';
import { formatNumber, HOW_IT_WORKS_CARDS, QUICK_ACCESS_CARDS } from '../lib/homepage-content';

const iaSnapshot = readJson<any>('ia-snapshot.json');
const today = readJson<any>('cache/today.json');
const backfill = readJson<any>('cache/backfill.json');

const snap = iaSnapshot?.summary || {};
const totalZips = snap.total_zips || 0;
const totalTribunals = snap.tribunals_total || 96;
const tribunalsWithData = snap.tribunals_with_data || 0;
const totalGB = snap.total_size_gb || 0;

const filesToday = today?.files_today || 0;
const tribunalStatusCount = Object.keys(today?.tribunal_status || {}).length;

const tribunalStats: { tribunal: string; data_rate_pct: number }[] =
  (backfill?.tribunal_stats || []).map((t: any) => ({
    tribunal: t.tribunal as string,
    data_rate_pct: Number(t.data_rate_pct ?? 0),
  }));

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="CausaGanha — Dados do Judiciário Brasileiro"
  description="Coletamos e arquivamos dados públicos do Diário de Justiça Eletrônico Nacional de todos os tribunais do Brasil. Dados abertos, gratuitos, para sempre."
  fullWidth={true}
>
  <Header variant="home" />

  <!-- ── HERO ── -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-grid">

        <!-- Left: headline + search -->
        <div class="hero-text">
          <p class="hero-eyebrow">100% Aberto · 100% Gratuito · Open Source</p>
          <h1 class="hero-h1">Dados do judiciário brasileiro, abertos para todos.</h1>
          <p class="hero-description">
            Coletamos publicações de <strong>{totalTribunals} tribunais</strong> a cada 20 minutos
            e arquivamos permanentemente no Internet Archive.
          </p>

          <!-- Search form -->
          <form class="search-form" id="home-search-form" action={BASE + 'publicacoes'} method="get">
            <div class="search-input-wrapper">
              <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
              </svg>
              <input
                id="home-search-input"
                name="texto"
                type="search"
                class="search-input"
                placeholder="Buscar por OAB (SP 123456), processo ou texto…"
                autocomplete="off"
                autocorrect="off"
                spellcheck="false"
              />
            </div>
            <button type="submit" class="btn btn-primary search-btn">Buscar</button>
          </form>
          <p class="search-hint">Experimente: <button class="hint-chip" data-example="TJSP">TJSP</button> · <button class="hint-chip" data-example="OAB SP 12345">OAB SP 12345</button> · <button class="hint-chip" data-example="mandado de segurança">mandado de segurança</button></p>

          <div class="hero-ctas">
            <a href={BASE + 'publicacoes'} class="btn btn-outline">Ver Publicações de Hoje</a>
            <a href={BASE + 'explorador'} class="btn btn-outline">Explorar com SQL</a>
          </div>
        </div>

        <!-- Right: live status -->
        <div class="hero-status">
          <div class="card status-card">
            <div class="card-body">
              <div class="status-header">
                <span class="status-dot" aria-hidden="true"></span>
                <strong>Coletando agora</strong>
                <small class="status-freq">a cada 20 min</small>
              </div>
              <ul class="status-list">
                <li class="status-item">
                  <span class="status-num">{tribunalStatusCount}</span>
                  <span class="status-desc">tribunais ativos hoje</span>
                </li>
                <li class="status-item">
                  <span class="status-num">{filesToday > 0 ? formatNumber(filesToday) : formatNumber(totalZips)}</span>
                  <span class="status-desc">{filesToday > 0 ? 'arquivos coletados hoje' : 'ZIPs no arquivo total'}</span>
                </li>
                <li class="status-item">
                  <span class="status-num">{totalGB.toFixed(1)}<small class="unit">GB</small></span>
                  <span class="status-desc">preservados no Internet Archive</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── QUICK ACCESS ── -->
  <section class="section-container" id="explorar">
    <div class="section-header-row">
      <h2 class="section-title">O que você pode fazer</h2>
    </div>
    <div class="quick-access-grid">
      {QUICK_ACCESS_CARDS.map(card => (
        <a href={BASE + card.href} class="qa-card card">
          <div class="card-body">
            <div class="qa-icon" aria-hidden="true">{card.icon}</div>
            <h3 class="qa-title">{card.title}</h3>
            <p class="qa-desc">{card.description}</p>
            <span class="qa-cta">{card.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ── TRIBUNAL COVERAGE ── -->
  <section class="section-container" id="cobertura">
    <TribunalCoverageGrid
      tribunalStats={tribunalStats}
      totalTribunals={totalTribunals}
      statsHref={BASE + 'stats'}
    />
  </section>

  <!-- ── STATS ── -->
  <section id="resumo" class="section-container">
    <div class="stats-grid">
      <figure>
        <div class="stat-value stat-info">{formatNumber(totalZips)}</div>
        <figcaption>ZIPs Arquivados</figcaption>
      </figure>
      <figure>
        <div class="stat-value stat-success">{tribunalsWithData}</div>
        <figcaption>Tribunais com Dados</figcaption>
      </figure>
      <figure>
        <div class="stat-value stat-warning">{totalGB.toFixed(0)}<small class="stat-unit">GB</small></div>
        <figcaption>Volume Arquivado</figcaption>
      </figure>
      <figure>
        <div class="stat-value stat-primary">100<small class="stat-unit">%</small></div>
        <figcaption>Dados Públicos</figcaption>
      </figure>
    </div>
  </section>

  <!-- ── HOW IT WORKS ── -->
  <section id="como-funciona" class="section-full">
    <div class="section-container">
      <h2 class="section-title how-title">Como Funciona</h2>
      <div class="steps-grid">
        {HOW_IT_WORKS_CARDS.map(step => (
          <div class="card step-card">
            <div class="card-body">
              <span class="step-icon" aria-hidden="true">{step.icon}</span>
              <h3 class="card-title">{step.title}</h3>
              <p class="step-desc">{step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── OPEN SOURCE ── -->
  <section class="section-full">
    <div class="section-container">
      <div class="card open-card">
        <div class="card-body open-body">
          <div class="open-text">
            <h2 class="open-title">100% Aberto e Gratuito, para sempre.</h2>
            <p class="open-desc">
              Todos os dados coletados pelo CausaGanha são e sempre serão públicos e gratuitos.
              Código 100% open source. Infraestrutura: GitHub Actions + Internet Archive + DuckDB.
            </p>
          </div>
          <div class="open-actions">
            <a href="https://github.com/franklinbaldo/causaganha" target="_blank" rel="noopener" class="btn btn-primary">
              <GitHubIcon /> Ver no GitHub
            </a>
            <a href={BASE + 'sobre'} class="btn btn-outline">
              Sobre o Projeto
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<!-- Search: parse OAB/processo/texto and redirect with correct params -->
<script>
  const OAB_RE = /^\s*(?:OAB\s*[\/\-]?\s*)?([A-Za-z]{2})\s*[-\/ ]?\s*(\d{3,6})\s*$/;
  const CNJ_MASKED_RE = /^\s*\d{7}-\d{2}\.\d{4}\.\d\.\d{2}\.\d{4}\s*$/;
  const CNJ_BARE_RE = /^\s*\d{20}\s*$/;

  function setupSearchHandlers() {
    const form = document.getElementById('home-search-form') as HTMLFormElement | null;
    const input = document.getElementById('home-search-input') as HTMLInputElement | null;
    if (!form || !input) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = input.value.trim();
      if (!raw) return;

      const base = form.action.replace(/\/$/, '');
      const params = new URLSearchParams();

      const oabMatch = raw.match(OAB_RE);
      if (oabMatch) {
        params.set('ufOab', oabMatch[1].toUpperCase());
        params.set('numeroOab', oabMatch[2]);
      } else if (CNJ_MASKED_RE.test(raw) || CNJ_BARE_RE.test(raw)) {
        params.set('numeroProcesso', raw.replace(/\D/g, ''));
      } else {
        params.set('texto', raw);
      }

      window.location.href = `${base}?${params.toString()}`;
    });

    // Hint chips pre-fill the input
    document.querySelectorAll<HTMLButtonElement>('.hint-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        input.value = btn.dataset.example || '';
        input.focus();
      });
    });
  }

  // Setup on initial load and after view transitions swap the page back in
  setupSearchHandlers();
  document.addEventListener('astro:after-swap', setupSearchHandlers);
</script>

<style>
  /* ── Hero ── */
  .hero {
    background: var(--color-base-100);
    border-bottom: 1px solid var(--color-base-300);
  }

  .hero-content {
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .hero-grid {
      grid-template-columns: 3fr 2fr;
      align-items: center;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero-eyebrow {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.5;
    font-weight: 600;
    margin: 0;
  }

  .hero-h1 {
    font-size: var(--font-size-4xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0;
    max-width: 22ch;
  }

  @media (min-width: 768px) {
    .hero-h1 {
      font-size: var(--font-size-5xl, 3.8rem);
    }
  }

  .hero-description {
    font-size: var(--font-size-lg);
    opacity: 0.7;
    margin: 0;
    max-width: 52ch;
  }

  /* ── Search form ── */
  .search-form {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .search-input-wrapper {
    position: relative;
    flex: 1;
    min-width: 0;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    opacity: 0.4;
  }

  .search-input {
    width: 100%;
    padding: 0.625rem 0.75rem 0.625rem 2.5rem;
    font-size: var(--font-size-base);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    background: var(--color-surface, #fff);
    color: var(--color-base-content);
    outline: none;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .search-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(30, 41, 59, 0.12);
  }

  .search-btn {
    padding: 0.625rem 1.25rem;
    white-space: nowrap;
    font-size: var(--font-size-base);
  }

  .search-hint {
    font-size: var(--font-size-xs);
    opacity: 0.5;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .hint-chip {
    background: var(--color-base-200);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-full);
    padding: 0.1rem 0.5rem;
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    cursor: pointer;
    color: inherit;
    transition: background var(--transition-base);
  }

  .hint-chip:hover {
    background: var(--color-base-300);
  }

  .hero-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* ── Live Status card ── */
  .status-card {
    border-left: 3px solid var(--color-success);
  }

  .status-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-base-300);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .status-freq {
    margin-left: auto;
    font-size: var(--font-size-xs);
    opacity: 0.4;
    font-family: var(--font-mono);
  }

  .status-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .status-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .status-num {
    font-size: var(--font-size-2xl);
    font-weight: 800;
    font-family: var(--font-mono);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--color-base-content);
  }

  .unit {
    font-size: 0.5em;
    font-weight: 500;
    margin-left: 0.1em;
    opacity: 0.7;
  }

  .status-desc {
    font-size: var(--font-size-xs);
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 500;
  }

  /* ── Sections ── */
  .section-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-lg) var(--space-md);
  }

  .section-full {
    border-top: 1px solid var(--color-base-300);
  }

  .section-header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin: 0;
  }

  /* ── Quick Access cards ── */
  .quick-access-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .quick-access-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .qa-card {
    text-decoration: none;
    color: inherit;
    display: block;
    transition: box-shadow var(--transition-base), transform var(--transition-base);
  }

  .qa-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .qa-icon {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
    line-height: 1;
  }

  .qa-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    margin: 0 0 0.4rem;
  }

  .qa-desc {
    font-size: var(--font-size-sm);
    opacity: 0.65;
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .qa-cta {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-accent);
  }

  /* ── Stats grid ── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    text-align: center;
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-grid figure {
    margin: 0;
    padding: var(--space-md) 0;
  }

  .stats-grid figcaption {
    font-size: var(--font-size-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.5rem;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stat-value {
    font-size: var(--font-size-3xl);
    font-weight: 800;
    font-family: var(--font-mono);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .stat-unit {
    font-size: 0.45em;
    font-weight: 500;
    margin-left: 0.1em;
    opacity: 0.7;
    vertical-align: middle;
  }

  .stat-info    { color: var(--color-info); }
  .stat-success { color: var(--color-success); }
  .stat-warning { color: var(--color-warning); }
  .stat-primary { color: var(--color-primary); }

  /* ── How it works ── */
  .how-title {
    margin-bottom: 1.5rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .step-card {
    height: 100%;
  }

  .step-icon {
    font-size: 1.5rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-size: var(--font-size-lg);
    font-weight: 700;
    margin: 0 0 0.5rem;
  }

  .step-desc {
    font-size: var(--font-size-sm);
    opacity: 0.7;
    margin: 0;
    line-height: 1.6;
  }

  /* ── Open Source card ── */
  .open-card {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-content);
  }

  .open-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.5rem 1.5rem;
  }

  @media (min-width: 768px) {
    .open-body {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .open-title {
    font-size: var(--font-size-xl);
    font-weight: 800;
    margin: 0 0 0.5rem;
  }

  .open-desc {
    font-size: var(--font-size-sm);
    opacity: 0.75;
    margin: 0;
    max-width: 60ch;
    line-height: 1.6;
  }

  .open-actions {
    display: flex;
    gap: 0.75rem;
    flex-shrink: 0;
    flex-wrap: wrap;
  }

  .open-actions .btn-primary {
    background: var(--color-primary-content);
    color: var(--color-primary);
    border-color: var(--color-primary-content);
  }

  .open-actions .btn-primary:hover {
    opacity: 0.9;
  }

  .open-actions .btn-outline {
    border-color: rgba(255,255,255,0.4);
    color: var(--color-primary-content);
  }

  .open-actions .btn-outline:hover {
    background: rgba(255,255,255,0.1);
  }
</style>
