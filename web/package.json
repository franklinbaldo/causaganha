{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prepare": "panda codegen",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen:djen": "openapi-typescript ../openapi/djen.yml -o src/lib/djen-types.gen.ts",
    "codegen:djen-zod": "orval --config orval.config.ts",
    "prebuild": "panda codegen && npm run codegen:djen && npm run codegen:djen-zod",
    "pretest": "panda codegen && npm run codegen:djen && npm run codegen:djen-zod",
    "pretypecheck": "panda codegen && npm run codegen:djen && npm run codegen:djen-zod",
    "test:rendered-contracts": "vitest run src/lib/data/renderedContracts.integration.test.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/svelte": "^9.0.1",
    "@duckdb/duckdb-wasm": "^1.33.1-dev20.0",
    "@observablehq/plot": "^0.6.0",
    "@tanstack/svelte-query": "^6.1.14",
    "astro": "^7.1.3",
    "dompurify": "^3.4.13",
    "openapi-fetch": "^0.17.0",
    "svelte": "^5.56.3",
    "zod": "^4.0.0"
  },
  "overrides": {
    "yaml": ">=2.8.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^6.3.0",
    "@eslint/js": "^9.39.1",
    "@pandacss/dev": "^1.12.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tanstack/svelte-query-devtools": "^6.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "cobogo": "github:franklinbaldo/cobogo#8ad1fe1c40bb6af12d8b8fcbe1b20d070b5bb44c",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.13.0",
    "orval": "^8.28.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.2"
  }
}
