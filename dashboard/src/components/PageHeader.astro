---
import Header from './Header.astro';

interface Props {
  title: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  subtitle,
  backHref = import.meta.env.BASE_URL,
  backLabel = 'Back',
} = Astro.props;
---

<Header variant="page" title={title} subtitle={subtitle} backHref={backHref} backLabel={backLabel}>
  <slot name="icon" slot="icon" />
  <slot name="title" slot="title" />
  <slot name="subtitle" slot="subtitle" />
  <slot name="nav" slot="nav" />
</Header>
