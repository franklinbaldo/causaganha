---
import { ThemeToggle } from './ThemeToggle';

interface Props {
  title: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  title,
  subtitle,
  backHref = import.meta.env.BASE_URL,
  backLabel = 'Back',
} = Astro.props;

const hasIconSlot = Astro.slots.has('icon');
---

<header class="max-w-7xl mx-auto mb-8 flex items-center justify-between">
  <div class="flex items-center gap-3">
    {hasIconSlot ? (
      <div class="p-2 bg-accent-muted rounded-xl">
        <slot name="icon" />
      </div>
    ) : (
      <a href={backHref} class="p-2 bg-accent-muted rounded-xl hover:bg-accent hover:text-white transition-colors" aria-label={backLabel}>
        <svg class="w-5 h-5 text-accent hover:text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m15 18-6-6 6-6"/>
        </svg>
      </a>
    )}
    <div>
      <h1 class="text-xl font-semibold text-black dark:text-white tracking-tight">
        <slot name="title">{title}</slot>
      </h1>
      {subtitle && (
        <p class="text-sm text-gray-500 dark:text-gray-400">
          {subtitle}
        </p>
      )}
      <slot name="subtitle" />
    </div>
  </div>
  <div class="flex items-center gap-3">
    <slot name="nav" />
    <ThemeToggle client:load />
  </div>
</header>
