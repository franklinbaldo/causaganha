---
interface Props {
  class?: string;
}

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="bg-gray-900 text-gray-400 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid md:grid-cols-3 gap-8">
      <div>
        <div class="flex items-center mb-4">
          <span class="text-2xl font-bold text-white">Causa</span>
          <span class="text-2xl font-bold text-amber-500">Ganha</span>
        </div>
        <p class="text-gray-400 mb-4">
          Dados judiciais públicos arquivados permanentemente para transparência e acesso universal.
        </p>
        <p class="text-sm">&copy; {new Date().getFullYear()} CausaGanha. Código aberto sob licença MIT.</p>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-4">Links</h4>
        <ul class="space-y-2 text-sm">
          <li><a href={BASE + 'publicacoes'} class="hover:text-white transition">Publicações</a></li>
          <li><a href={BASE + 'stats'} class="hover:text-white transition">Estatísticas</a></li>
          <li><a href="https://github.com/franklinbaldo/causaganha" target="_blank" rel="noopener" class="hover:text-white transition">GitHub</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-4">Dados</h4>
        <ul class="space-y-2 text-sm">
          <li><a href="https://archive.org/search?query=identifier%3Adjen-*" target="_blank" rel="noopener" class="hover:text-white transition">Internet Archive</a></li>
          <li><a href="#como-funciona" class="hover:text-white transition">Como Funciona</a></li>
          <li><a href="#para-quem" class="hover:text-white transition">Para Quem</a></li>
        </ul>
      </div>
    </div>
  </div>
</footer>
