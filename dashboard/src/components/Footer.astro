---
interface Props {
  class?: string;
}

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="footer bg-base-200 text-base-content mt-20 p-10">
  <aside>
    <p class="text-lg font-extrabold tracking-tight">CausaGanha</p>
    <p class="max-w-xs text-sm opacity-70">Dados judiciais públicos arquivados permanentemente para transparência e acesso universal.</p>
    <p class="text-xs opacity-50">&copy; {new Date().getFullYear()} CausaGanha. Código aberto sob licença MIT.</p>
  </aside>
  <nav>
    <h6 class="footer-title">Navegação</h6>
    <a href={BASE + 'sobre'} class="link link-hover">Sobre</a>
    <a href={BASE + 'publicacoes'} class="link link-hover">Publicações</a>
    <a href={BASE + 'stats'} class="link link-hover">Estatísticas</a>
    <a href="https://github.com/franklinbaldo/causaganha" target="_blank" rel="noopener" class="link link-hover">GitHub</a>
  </nav>
  <nav>
    <h6 class="footer-title">Dados</h6>
    <a href="https://archive.org/search?query=identifier%3Adjen-*" target="_blank" rel="noopener" class="link link-hover">Internet Archive</a>
    <a href={BASE + '#como-funciona'} class="link link-hover">Como Funciona</a>
    <a href={BASE + '#para-quem'} class="link link-hover">Para Quem</a>
  </nav>
</footer>
