---
/**
 * ActivityChart.astro — Recent activity bar chart using Observable Plot.
 * Renders as static SVG at build time. Zero client-side JavaScript.
 */
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";

const { data = [] } = Astro.props;
const document = new JSDOM("").window.document;

const hasData = data && data.length > 0;

let svg = "";
if (hasData) {
  const chartData = data.map(d => ({
    date: d.date.split('-').slice(1).join('/'),
    tribunals: d.count,
    fullDate: d.date,
  }));

  const chart = Plot.plot({
    document,
    width: 500,
    height: 220,
    marginLeft: 40,
    marginBottom: 30,
    marginTop: 10,
    marginRight: 10,
    style: {
      background: "transparent",
      color: "var(--color-content-secondary)",
      fontFamily: "Inter, system-ui, sans-serif",
      fontSize: "11px",
    },
    x: {
      label: null,
      tickSize: 0,
      padding: 0.3,
    },
    y: {
      label: null,
      domain: [0, 91],
      tickSize: 0,
      grid: true,
      tickFormat: d => d,
    },
    marks: [
      Plot.ruleY([0], { stroke: "var(--color-border)" }),
      Plot.barY(chartData, {
        x: "date",
        y: "tribunals",
        fill: "#3b82f6",
        rx: 4,
        title: d => `${d.fullDate}: ${d.tribunals} tribunals`,
      }),
    ],
  });

  // Fix grid line colors for dark mode compat via CSS variables
  svg = chart.outerHTML
    .replace(/stroke: rgb\(0, 0, 0\)/g, 'stroke: var(--color-border-muted)')
    .replace(/fill: rgb\(0, 0, 0\)/g, 'fill: var(--color-content-secondary)');
}
---

<div class="card h-full min-h-[280px] flex flex-col" aria-label="Bar chart showing daily collection volume">
  <h2 class="text-lg font-semibold text-content mb-4">Recent Activity</h2>
  {hasData ? (
    <div class="flex-1 w-full overflow-hidden chart-container" set:html={svg} />
  ) : (
    <div class="flex-1 flex items-center justify-center text-content-tertiary">
      <p class="text-sm">No recent activity data</p>
    </div>
  )}
</div>

<style>
  .chart-container :global(svg) {
    width: 100%;
    height: auto;
    max-height: 100%;
  }
  /* Ensure Plot grid lines respect dark mode */
  .chart-container :global([aria-label="y-axis tick"]) {
    color: var(--color-content-secondary);
  }
  .chart-container :global([aria-label="y-axis grid"] line) {
    stroke: var(--color-border-muted);
  }
</style>
