---
/**
 * TribunalHeatmapGrid.astro
 * Iterates through all tribunals and displays a heatmap card for each.
 */

import TribunalHeatmapCard from './TribunalHeatmapCard.astro';

const { coverage, etas, startDate, endDate } = Astro.props;

// Use a static list of 91 tribunals to ensure all are shown even if missing from data
const TRIBUNALS = [
    "STF", "STJ", "TST", "TSE", "STM", "CNJ",
    "TRF1", "TRF2", "TRF3", "TRF4", "TRF5", "TRF6",
    "TRT1", "TRT2", "TRT3", "TRT4", "TRT5", "TRT6", "TRT7", "TRT8", "TRT9", "TRT10", "TRT11", "TRT12", "TRT13", "TRT14", "TRT15", "TRT16", "TRT17", "TRT18", "TRT19", "TRT20", "TRT21", "TRT22", "TRT23", "TRT24",
    "TJAC", "TJAL", "TJAM", "TJAP", "TJBA", "TJCE", "TJDFT", "TJES", "TJGO", "TJMA", "TJMG", "TJMS", "TJMT", "TJPA", "TJPB", "TJPE", "TJPI", "TJPR", "TJRJ", "TJRN", "TJRO", "TJRR", "TJRS", "TJSC", "TJSE", "TJSP", "TJTO",
    "TRE-AC", "TRE-AL", "TRE-AM", "TRE-AP", "TRE-BA", "TRE-CE", "TRE-DF", "TRE-ES", "TRE-GO", "TRE-MA", "TRE-MG", "TRE-MS", "TRE-MT", "TRE-PA", "TRE-PB", "TRE-PE", "TRE-PI", "TRE-PR", "TRE-RJ", "TRE-RN", "TRE-RO", "TRE-RR", "TRE-RS", "TRE-SC", "TRE-SE", "TRE-SP", "TRE-TO"
];

const gridItems = TRIBUNALS.map(t => {
  return {
    name: t,
    presentDates: coverage[t] || [],
    etaData: etas[t] || { missing_days: 0, velocity_14d: 0, eta_days: null },
  };
});

// Sort them logically or alphabetically
gridItems.sort((a, b) => a.name.localeCompare(b.name));
---

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
  {gridItems.map((item) => (
    <TribunalHeatmapCard
      tribunalName={item.name}
      presentDates={item.presentDates}
      etaData={item.etaData}
      startDate={startDate}
      endDate={endDate}
    />
  ))}
</div>
