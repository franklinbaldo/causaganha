---
/**
 * TribunalGrid.astro — Static tribunal card grid rendered at build time.
 * Cards use data attributes for client-side filtering via TribunalFilter island.
 * Zero client-side JavaScript for the cards themselves.
 */

const { enrichedStats } = Astro.props;

const tribunals = enrichedStats?.tribunals || {};
const items = Object.entries(tribunals).sort((a, b) => a[0].localeCompare(b[0]));

const counts = {
  all: items.length,
  success: items.filter(([, d]) => d.status === 'success').length,
  error: items.filter(([, d]) => d.status !== 'success' && d.status !== 'absent').length,
  absent: items.filter(([, d]) => d.status === 'absent').length,
};

function statusBorderClass(status) {
  if (status === 'success') return 'border-l-success';
  if (status === 'absent') return 'border-l-content-tertiary';
  return 'border-l-danger';
}

function statusCategory(status) {
  if (status === 'success') return 'success';
  if (status === 'absent') return 'absent';
  return 'error';
}
---

<div class="card min-h-[400px]" id="tribunal-grid">
  {/* Header & Controls */}
  <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-5 gap-4">
    <div>
      <h2 class="text-lg font-semibold text-content flex items-center gap-2">
        Tribunal Status
      </h2>
      <p class="text-sm text-content-tertiary mt-0.5" id="tribunal-count">
        {items.length} of {items.length} courts
      </p>
    </div>

    {/* Filter island slot */}
    <slot />
  </div>

  {/* Empty state (hidden by default, shown by JS when no results) */}
  <div id="tribunal-empty" class="hidden flex-col items-center justify-center py-16 text-center">
    <svg class="w-12 h-12 text-content-tertiary opacity-30 mb-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <p class="text-content font-medium text-base">No matching courts</p>
    <p class="text-sm text-content-tertiary mt-1">
      Try adjusting your search or filter
    </p>
    <div class="flex gap-3 mt-6">
      <button
        id="tribunal-clear-search"
        class="text-sm border border-border px-4 py-2 rounded-lg hover:border-accent hover:text-accent transition-colors font-medium"
      >
        Clear Search
      </button>
      <button
        id="tribunal-reset-all"
        class="text-sm bg-accent text-white px-4 py-2 rounded-lg hover:bg-accent-dark transition-colors font-medium"
      >
        Reset All
      </button>
    </div>
  </div>

  {/* Grid Content — static cards with data attributes for filtering */}
  <div role="list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 gap-3" id="tribunal-cards">
    {items.map(([name, data]) => (
      <div
        class={`group p-4 bg-surface border border-border rounded-xl transition-all duration-200 hover:shadow-card-hover border-l-[3px] ${statusBorderClass(data.status)}`}
        role="listitem"
        data-name={name.toLowerCase()}
        data-status={statusCategory(data.status)}
      >
        <div class="flex justify-between items-start mb-2.5">
          <span class="font-medium text-sm text-content truncate pr-2" title={name}>
            {name}
          </span>
          {data.status === 'success' ? (
            <svg class="w-4 h-4 text-success flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Online">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          ) : data.status === 'absent' ? (
            <svg class="w-4 h-4 text-content-tertiary flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Offline">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          ) : (
            <svg class="w-4 h-4 text-danger flex-shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Error">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="15" y1="9" x2="9" y2="15"></line>
              <line x1="9" y1="9" x2="15" y2="15"></line>
            </svg>
          )}
        </div>

        <div class="space-y-1.5 text-xs text-content-secondary">
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-content-tertiary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span class="font-mono tabular-nums">
              {data.last_update ? new Date(data.last_update).toLocaleDateString() : 'No date'}
            </span>
          </div>
          {data.doc_count !== undefined ? (
            <div class="flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-content-tertiary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <line x1="10" y1="9" x2="8" y2="9"></line>
              </svg>
              <span class="font-mono tabular-nums">{data.doc_count.toLocaleString()} docs</span>
            </div>
          ) : (
            <div class="flex items-center gap-1.5 text-content-tertiary">
              <svg class="w-3.5 h-3.5 opacity-60" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <line x1="10" y1="9" x2="8" y2="9"></line>
              </svg>
              <span>No metrics</span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
