---
interface Props {
  index: {
    tribunal: string;
    dataRatePct: number;
    daysWithData: number;
    daysTotal: number;
  };
}

const { index } = Astro.props;
const href = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}advogados/${index.tribunal.toLowerCase()}`;
---

<article class="card bg-base-100 shadow-sm border border-base-300 h-full">
  <div class="card-body">
    <h3 class="card-title text-lg">{index.tribunal}</h3>
    <p class="text-sm opacity-70">Base disponível para exploração de OABs neste tribunal</p>
    <ul class="text-sm space-y-1 mt-2">
      <li><strong>Dias com dados:</strong> {index.daysWithData.toLocaleString('pt-BR')} de {index.daysTotal.toLocaleString('pt-BR')}</li>
      <li><strong>Cobertura:</strong> {index.dataRatePct.toFixed(1)}%</li>
    </ul>
    <div class="card-actions justify-end mt-4">
      <a href={href} class="btn btn-outline btn-sm">Ver guia do tribunal</a>
    </div>
  </div>
</article>
