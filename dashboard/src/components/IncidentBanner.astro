---
interface Incident {
  streak: number;
  pr_url: string;
  pr_number: number | string;
  pr_blocked_by: string;
  latest_failing_run_url?: string;
}

interface Props {
  incident?: Incident | null;
}

const { incident } = Astro.props;
---

{incident && incident.streak > 0 && (
  <article
    class="border-l-danger bg-danger-muted" role="alert"
    aria-live="polite">
    <header>
      <svg class="text-danger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
      <hgroup>
        <h3 class="text-danger">
          Critical Pipeline Failure
        </h3>
        <p>
          Collect ZIPs on <code>main</code> has failed
          <span class="text-danger"> {incident.streak} consecutive times</span>.
        </p>
      </hgroup>
    </header>

    <div>
      <div>
        <span>Fix Ready:</span>
        <a
          href={incident.pr_url} target="_blank"
          rel="noopener noreferrer"
          class="text-accent bg-accent-muted">
          PR #{incident.pr_number}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 1em; height: 1em; display: inline-block; vertical-align: middle;">
            <path d="M15 3h6v6" />
            <path d="M10 14 21 3" />
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          </svg>
        </a>
      </div>
      <div>
        <span>Blocked by:</span>
        <span class="bg-warning-muted text-warning">
          {incident.pr_blocked_by}
        </span>
      </div>
      {incident.latest_failing_run_url && (
         <div>
           <a
             href={incident.latest_failing_run_url} target="_blank"
             rel="noopener noreferrer">
             View latest failing run
           </a>
         </div>
      )}
    </div>
  </article>
)}
