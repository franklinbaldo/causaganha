---
---
<dialog
  id="command-palette-dialog"
  class="modal"
  aria-labelledby="command-palette-title">
  <div class="modal-box">
    <h3 class="font-bold text-lg" id="command-palette-title">Keyboard Shortcuts</h3>
    <form method="dialog">
      <button
        id="command-palette-close"
        class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
        aria-label="Close dialog">
        ✕
      </button>
    </form>

    <div class="py-4 space-y-4">
      <div class="flex justify-between items-center border-b border-base-200 pb-2">
        <span>Open Command Palette / Help</span>
        <div class="space-x-1">
          <kbd class="kbd kbd-sm">Ctrl</kbd>
          <span>+</span>
          <kbd class="kbd kbd-sm">K</kbd>
          <span>or</span>
          <kbd class="kbd kbd-sm">?</kbd>
        </div>
      </div>

      <div class="flex justify-between items-center border-b border-base-200 pb-2">
        <span>Close Modals / Tooltips</span>
        <kbd class="kbd kbd-sm">Esc</kbd>
      </div>

      <div class="flex justify-between items-center border-b border-base-200 pb-2">
        <span>Navigate Heatmap</span>
        <div class="space-x-1">
          <kbd class="kbd kbd-sm">↑</kbd>
          <kbd class="kbd kbd-sm">↓</kbd>
          <kbd class="kbd kbd-sm">←</kbd>
          <kbd class="kbd kbd-sm">→</kbd>
        </div>
      </div>

      <div class="flex justify-between items-center border-b border-base-200 pb-2">
        <span>Select Heatmap Cell</span>
        <kbd class="kbd kbd-sm">Enter</kbd>
      </div>
    </div>

    <div class="modal-action mt-4 justify-start">
      <small class="text-base-content/70">Accessibility mode is always active. Use Tab to navigate through all interactive elements.</small>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
  function setupCommandPalette() {
    const dialog = document.getElementById('command-palette-dialog') as HTMLDialogElement;
    const closeBtn = document.getElementById('command-palette-close');

    if (!dialog) return;

    function handleKeyDown(e: KeyboardEvent) {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        const searchInput = document.getElementById('ia-search-input');
        if (searchInput && document.activeElement !== searchInput) {
          searchInput.focus();
        } else {
          toggleDialog();
        }
      } else if (e.key === '?' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName ?? '')) {
        e.preventDefault();
        toggleDialog();
      } else if (e.key === 'Escape' && dialog.open) {
        dialog.close();
      }
    }

    function toggleDialog() {
      if (dialog.open) {
        dialog.close();
      } else {
        dialog.showModal();
      }
    }

    document.addEventListener('keydown', handleKeyDown);

    if (closeBtn) {
      closeBtn.addEventListener('click', () => dialog.close());
    }

    // Cleanup logic for View Transitions
    document.addEventListener('astro:before-swap', () => {
      document.removeEventListener('keydown', handleKeyDown);
    }, { once: true });
  }

  setupCommandPalette();
  document.addEventListener('astro:after-swap', setupCommandPalette);
</script>
