---
/**
 * YearProgress.astro — Per-year collection breakdown with pure SVG progress bars.
 * Shows both collection and consolidation progress per year.
 * Zero client-side JavaScript.
 */
const { progressByYear } = Astro.props;
const progressData = progressByYear || {};
const years = Object.entries(progressData).sort((a, b) => Number(b[0]) - Number(a[0]));

function getBarColor(pct) {
  if (pct >= 90) return '#22c55e'; // success
  if (pct < 50) return '#eab308'; // warning
  return '#3b82f6'; // accent
}

function getBadgeClass(pct) {
  if (pct >= 90) return 'badge-success';
  if (pct < 50) return 'badge-warning';
  return 'badge-accent';
}

// Calculate totals for summary
const totalCompleted = years.reduce((sum, [, d]) => sum + (d.completed || 0), 0);
const totalExpected = years.reduce((sum, [, d]) => sum + (d.total || 0), 0);
const totalConsolidated = years.reduce((sum, [, d]) => sum + (d.days_consolidated || 0), 0);
const totalCollected = years.reduce((sum, [, d]) => sum + (d.unique_days || 0), 0);
---

{years.length === 0 ? (
  <div class="card flex flex-col items-center justify-center text-content-tertiary min-h-[200px]">
    <p class="text-sm">Year breakdown not available yet</p>
    <p class="text-xs mt-1">Waiting for catalog data...</p>
  </div>
) : (
  <div class="card">
    <div class="flex items-center justify-between mb-5">
      <h2 class="text-lg font-semibold text-content">Per-Year Breakdown</h2>
      {totalExpected > 0 && (
        <div class="text-xs text-content-tertiary">
          <span class="font-mono tabular-nums font-medium text-content">{totalCollected}</span> days /
          <span class="font-mono tabular-nums font-medium text-purple ml-1">{totalConsolidated}</span> consolidated
        </div>
      )}
    </div>
    <div class="space-y-5">
      {years.map(([year, data]) => {
        const pct = data.pct || 0;
        const barColor = getBarColor(pct);
        const badgeClass = getBadgeClass(pct);
        const clampedPct = Math.min(pct, 100);
        const consDays = data.days_consolidated || 0;
        const weekdays = data.weekdays || 0;
        const consPct = weekdays > 0 ? Math.min((consDays / weekdays) * 100, 100) : 0;

        return (
          <div>
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-3">
                <span class="text-lg font-semibold font-mono text-content">{year}</span>
                <span class={`badge ${badgeClass}`}>{pct.toFixed(1)}%</span>
              </div>
              <div class="flex items-center gap-4 text-sm text-content-secondary">
                <span>
                  <span class="font-mono tabular-nums font-medium text-content">{data.unique_days}</span>
                  <span class="text-xs text-content-tertiary">/{weekdays}d</span>
                </span>
                {consDays > 0 && (
                  <span class="flex items-center gap-1">
                    <span class="inline-block w-2 h-2 rounded-sm bg-purple"></span>
                    <span class="font-mono tabular-nums font-medium text-purple">{consDays}</span>
                  </span>
                )}
              </div>
            </div>
            {/* Stacked progress bars: collection on top, consolidation overlaid */}
            <div class="relative">
              <svg
                width="100%"
                height="10"
                role="progressbar"
                aria-valuenow={pct}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-label={`${year}: ${pct.toFixed(1)}% collected`}
              >
                <rect width="100%" height="10" rx="5" fill="var(--color-surface-overlay)" />
                <rect width={`${clampedPct}%`} height="10" rx="5" fill={barColor} opacity="0.3" />
                <rect width={`${consPct}%`} height="10" rx="5" fill="#a855f7" />
              </svg>
            </div>
            <div class="flex justify-between mt-1 text-[10px] text-content-tertiary">
              <span>
                {data.zips || 0} ZIPs collected
              </span>
              <span>
                {consDays > 0 ? `${consPct.toFixed(0)}% consolidated` : 'not consolidated'}
              </span>
            </div>
          </div>
        );
      })}
    </div>
    {/* Legend */}
    <div class="flex items-center gap-4 mt-4 pt-3 border-t border-border-muted text-xs text-content-tertiary">
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-2.5 h-2.5 bg-accent rounded-sm opacity-30"></span> Collected
      </span>
      <span class="flex items-center gap-1.5">
        <span class="inline-block w-2.5 h-2.5 rounded-sm" style="background: #a855f7;"></span> Consolidated
      </span>
    </div>
  </div>
)}
