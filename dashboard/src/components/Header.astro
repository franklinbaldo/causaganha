---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  variant: 'home' | 'page';
  title?: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  variant,
  title,
  subtitle,
  backHref = import.meta.env.BASE_URL,
  backLabel = 'Back',
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hasIconSlot = Astro.slots.has('icon');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === BASE.replace(/\/$/, '')) return currentPath === normalized;
  return currentPath.startsWith(normalized);
}

const navLinks = [
  { href: BASE + 'publicacoes', label: 'Publicações' },
  { href: BASE + 'stats', label: 'Estatísticas' },
  { href: BASE + 'sobre', label: 'Sobre' },
];
---

<style>
  /* Base Header Styles */
  .header-base {
    padding-top: var(--space-md);
    padding-bottom: var(--space-xs);
  }

  /* Page Variant Specific */
  .header-page {
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border-muted);
    margin-bottom: var(--space-lg);
  }
  .header-page nav ul {
    margin: 0;
  }
  .header-page hgroup h1 {
    font-size: var(--font-size-2xl);
    margin-bottom: 0;
  }
  .header-page hgroup p {
    font-size: var(--font-size-sm);
    color: var(--color-content-tertiary);
    margin: 0;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--color-content-tertiary);
  }
  .back-link:hover {
    color: var(--color-content);
  }

  /* Shared Brand */
  .brand-strong {
    font-weight: 800;
    font-size: var(--font-size-md);
    letter-spacing: -0.02em;
    color: var(--color-content);
    text-decoration: none;
  }

  /* Active link indicator */
  .nav-active {
    font-weight: 600;
    color: var(--color-content) !important;
    border-bottom: 2px solid var(--pico-primary);
    padding-bottom: 2px;
  }

  /* Mobile Nav */
  .mobile-nav {
    display: none;
  }
  .desktop-nav {
    display: flex;
  }
  @media (max-width: 768px) {
    .mobile-nav {
      display: block;
    }
    .desktop-nav {
      display: none;
    }
    .mobile-nav summary {
      padding: 0.5rem;
    }
    .mobile-nav summary::after {
      display: none;
    }
    .mobile-nav ul[dir="rtl"] {
      right: 0;
      left: auto;
      min-width: 200px;
    }
    .mobile-nav ul[dir="rtl"] a {
      padding: 0.75rem 1rem;
      display: block;
    }
    .mobile-nav ul[dir="rtl"] .nav-active {
      border-bottom: none;
      background: var(--color-surface-overlay);
      border-radius: var(--pico-border-radius);
    }
  }
</style>

{variant === 'home' ? (
  <nav class="container header-base">
    <ul>
      <li><a href={BASE} class="brand-strong">CausaGanha</a></li>
    </ul>
    <ul class="desktop-nav">
      <li><a href={BASE + '#como-funciona'}>Como Funciona</a></li>
      <li><a href={BASE + '#dados'}>Dados</a></li>
      <li><a href={BASE + '#para-quem'}>Para Quem</a></li>
      {navLinks.map(link => (
        <li>
          <a href={link.href} class={isActive(link.href) ? 'nav-active' : ''}>
            {link.label}
          </a>
        </li>
      ))}
      <li><ThemeToggle /></li>
    </ul>
    <ul class="mobile-nav">
      <li><ThemeToggle /></li>
      <li>
        <details class="dropdown" data-nav-dropdown>
          <summary aria-label="Menu">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </summary>
          <ul dir="rtl">
            <li><a href={BASE + '#como-funciona'}>Como Funciona</a></li>
            <li><a href={BASE + '#dados'}>Dados</a></li>
            <li><a href={BASE + '#para-quem'}>Para Quem</a></li>
            {navLinks.map(link => (
              <li>
                <a href={link.href} class={isActive(link.href) ? 'nav-active' : ''}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </li>
    </ul>
  </nav>
) : (
  <header class="container header-page">
    <nav>
      <ul>
        <li>
          {hasIconSlot ? (
            <slot name="icon" />
          ) : (
            <a href={backHref} aria-label={backLabel} class="back-link">
              <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
              </svg>
            </a>
          )}
        </li>
        <li>
          <hgroup>
            <h1><slot name="title">{title}</slot></h1>
            {subtitle && <p>{subtitle}</p>}
            <slot name="subtitle" />
          </hgroup>
        </li>
      </ul>
      <ul class="desktop-nav">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class={isActive(link.href) ? 'nav-active' : ''}>
              {link.label}
            </a>
          </li>
        ))}
        <li><ThemeToggle /></li>
      </ul>
      <ul class="mobile-nav">
        <li><ThemeToggle /></li>
        <li>
          <details class="dropdown" data-nav-dropdown>
            <summary aria-label="Menu">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </summary>
            <ul dir="rtl">
              <li><a href={BASE}>Início</a></li>
              {navLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'nav-active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </nav>
  </header>
)}

<!-- Close mobile dropdown on outside click -->
<script is:inline>
  document.addEventListener('click', function(e) {
    document.querySelectorAll('[data-nav-dropdown]').forEach(function(d) {
      if (!d.contains(e.target)) d.removeAttribute('open');
    });
  });
</script>
