---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  variant: 'home' | 'page';
  title?: string;
  subtitle?: string;
  backHref?: string;
  backLabel?: string;
}

const {
  variant,
  title,
  subtitle,
  backHref = import.meta.env.BASE_URL,
  backLabel = 'Back',
} = Astro.props;

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hasIconSlot = Astro.slots.has('icon');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string): boolean {
  const normalized = href.replace(/\/$/, '') || '/';
  if (normalized === BASE.replace(/\/$/, '')) return currentPath === normalized;
  return currentPath.startsWith(normalized);
}

const mainLinks = [
  { href: BASE + 'publicacoes', label: 'Publicações' },
  { href: BASE + 'advogados', label: 'Advogados' },
  { href: BASE + 'comparador', label: 'Comparador' },
  { href: BASE + 'explorador', label: 'Explorador' },
  { href: BASE + 'dados', label: 'Dados' },
  { href: BASE + 'stats', label: 'Estatísticas' },
];

const secondaryLinks = [
  { href: BASE + 'consultas', label: 'Consultas' },
  { href: BASE + 'dicionario', label: 'Dicionário' },
  { href: BASE + 'changelog', label: 'Changelog' },
  { href: BASE + 'sobre', label: 'Sobre' },
];
---

{variant === 'home' ? (
  <div class="navbar bg-base-100 container mx-auto">
    <div class="navbar-start">
      <a href={BASE} class="btn btn-ghost text-lg font-extrabold tracking-tight">CausaGanha</a>
    </div>
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal gap-1 p-0">
        <li><a href={BASE + '#como-funciona'}>Como Funciona</a></li>
        <li><a href={BASE + '#resumo'}>Resumo</a></li>
        <li><a href={BASE + '#para-quem'}>Para Quem</a></li>
        <div class="divider divider-horizontal mx-1"></div>
        {mainLinks.map(link => (
          <li>
            <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <details>
            <summary>Recursos</summary>
            <ul class="bg-base-100 rounded-t-none p-2 z-[100] min-w-[160px] shadow-lg border border-base-300">
              {secondaryLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        </li>
      </ul>
    </div>
    <div class="navbar-end gap-2">
      <ThemeToggle />
      <div class="drawer drawer-end lg:hidden w-auto">
        <input id="mobile-drawer-home" type="checkbox" class="drawer-toggle" />
        <div class="drawer-content">
          <label for="mobile-drawer-home" class="btn btn-ghost btn-square">
            <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </label>
        </div>
        <div class="drawer-side z-[99]">
          <label for="mobile-drawer-home" aria-label="close sidebar" class="drawer-overlay"></label>
          <ul class="menu bg-base-200 min-h-full w-80 p-4">
            <li class="menu-title">Projeto</li>
            <li><a href={BASE + '#como-funciona'}>Como Funciona</a></li>
            <li><a href={BASE + '#resumo'}>Resumo</a></li>
            <li><a href={BASE + '#para-quem'}>Para Quem</a></li>
            <div class="divider"></div>
            <li class="menu-title">Principal</li>
            {mainLinks.map(link => (
              <li>
                <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                  {link.label}
                </a>
              </li>
            ))}
            <div class="divider"></div>
            <li class="menu-title">Recursos</li>
            {secondaryLinks.map(link => (
              <li>
                <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
) : (
  <header class="container mx-auto px-4 border-b border-base-300 pb-6 mb-6">
    <div class="navbar bg-base-100 px-0">
      <div class="navbar-start flex items-center gap-4">
        {hasIconSlot ? (
          <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center">
            <slot name="icon" />
          </div>
        ) : (
          <a href={backHref} aria-label={backLabel} class="btn btn-ghost btn-sm">
            <svg width="20" height="20" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
          </a>
        )}
        <div class="flex flex-col">
          <h1 class="text-2xl font-bold leading-tight"><slot name="title">{title}</slot></h1>
          {subtitle && <p class="text-xs text-base-content/50 leading-tight">{subtitle}</p>}
          <slot name="subtitle" />
        </div>
      </div>
      <div class="navbar-end hidden lg:flex">
        <ul class="menu menu-horizontal gap-1 p-0">
          {mainLinks.map(link => (
            <li>
              <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <details>
              <summary>Recursos</summary>
              <ul class="bg-base-100 rounded-t-none p-2 z-[100] min-w-[160px] shadow-lg border border-base-300">
                {secondaryLinks.map(link => (
                  <li>
                    <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        </ul>
        <div class="divider divider-horizontal mx-1"></div>
        <ThemeToggle />
      </div>
      <div class="navbar-end lg:hidden gap-2">
        <ThemeToggle />
        <div class="drawer drawer-end w-auto">
          <input id="mobile-drawer-page" type="checkbox" class="drawer-toggle" />
          <div class="drawer-content">
            <label for="mobile-drawer-page" class="btn btn-ghost btn-square">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </label>
          </div>
          <div class="drawer-side z-[99]">
            <label for="mobile-drawer-page" aria-label="close sidebar" class="drawer-overlay"></label>
            <ul class="menu bg-base-200 min-h-full w-80 p-4">
              <li><a href={BASE}>Início</a></li>
              <div class="divider"></div>
              <li class="menu-title">Principal</li>
              {mainLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
              <div class="divider"></div>
              <li class="menu-title">Recursos</li>
              {secondaryLinks.map(link => (
                <li>
                  <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>
)}
