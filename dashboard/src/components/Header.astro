---
import { LABELS } from '../lib/constants';

interface Props {
  health?: number;
}

const { health } = Astro.props;
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-page/80 border-b border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <div class="flex items-center gap-4">
        <a href="/causaganha/" class="flex items-baseline gap-0 font-mono text-xl font-bold tracking-tight">
          <span class="text-accent-green">causa</span><span class="text-text-primary">ganha</span>
        </a>
        <span class="hidden sm:block text-text-muted text-sm">
          {LABELS.header.subtitle}
        </span>
      </div>

      <!-- Right side -->
      <div class="flex items-center gap-4">
        <!-- System Status (island placeholder) -->
        <div id="system-status" data-health={health}>
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-card border border-border">
            <div class="w-2 h-2 rounded-full bg-text-muted animate-pulse"></div>
            <span class="text-xs text-text-muted font-medium">Carregando...</span>
          </div>
        </div>

        <!-- Clock (island placeholder) -->
        <div id="clock" class="hidden sm:block text-text-muted text-sm font-mono tabular-nums">
          --:--:--
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  // Clock island - client-side only
  function updateClock() {
    const el = document.getElementById('clock');
    if (el) {
      el.textContent = new Date().toLocaleTimeString('pt-BR', {
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        timeZone: 'America/Sao_Paulo'
      });
    }
  }

  updateClock();
  setInterval(updateClock, 1000);

  // System status island
  async function updateStatus() {
    const container = document.getElementById('system-status');
    if (!container) return;

    try {
      const response = await fetch('https://api.github.com/repos/franklinbaldo/causaganha/actions/runs?per_page=10');
      const data = await response.json();
      const runs = data.workflow_runs || [];
      const successful = runs.filter((r: any) => r.conclusion === 'success').length;
      const health = runs.length > 0 ? Math.round((successful / runs.length) * 100) : 0;

      let status = 'Falha';
      let colorClass = 'bg-accent-red';

      if (health >= 80) {
        status = 'Operacional';
        colorClass = 'bg-accent-green status-pulse';
      } else if (health >= 50) {
        status = 'Degradado';
        colorClass = 'bg-accent-yellow';
      }

      container.innerHTML = `
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-card border border-border card-glow cursor-default">
          <div class="w-2 h-2 rounded-full ${colorClass}"></div>
          <span class="text-xs text-text-primary font-medium">${status}</span>
        </div>
      `;
    } catch {
      container.innerHTML = `
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-card border border-border">
          <div class="w-2 h-2 rounded-full bg-text-muted"></div>
          <span class="text-xs text-text-muted font-medium">Offline</span>
        </div>
      `;
    }
  }

  updateStatus();
  setInterval(updateStatus, 5 * 60 * 1000); // Refresh every 5 minutes
</script>
