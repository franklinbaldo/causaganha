---
interface Props {
  title: string;
  message: string;
  actionHref?: string;
  actionLabel?: string;
}

const { title, message, actionHref, actionLabel } = Astro.props;
---

<div class="card bg-base-200 border border-dashed border-base-300">
  <div class="card-body text-center">
    <h3 class="text-lg font-semibold">{title}</h3>
    <p class="opacity-70">{message}</p>
    {actionHref && actionLabel && (
      <div class="card-actions justify-center mt-2">
        <a href={actionHref} class="btn btn-primary btn-sm">{actionLabel}</a>
      </div>
    )}
  </div>
</div>
