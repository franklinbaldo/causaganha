---
interface Props {
  title?: string;
}

const { title = 'CausaGanha' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Monitor do Pipeline DJEN - Arquivo de comunicações judiciais brasileiras" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/causaganha/favicon.svg" />

    <!-- OpenGraph -->
    <meta property="og:title" content="CausaGanha - Monitor do Pipeline DJEN" />
    <meta property="og:description" content="Dashboard de monitoramento da coleta de comunicações judiciais brasileiras" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://franklinbaldo.github.io/causaganha/" />

    <title>{title}</title>
  </head>
  <body class="bg-page text-text-primary font-sans min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
