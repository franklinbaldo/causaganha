---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import DatabaseIcon from '../../components/icons/DatabaseIcon.astro';
import { deriveData } from '../../lib/fetchData';
import { TribunalView } from '../../components/TribunalView';
import { IASearchBar } from '../../components/IASearchBar';
import { readJson } from '../../lib/readJson';

const dashboardData = readJson('dashboard-data.json');
const tribunalStartDates = readJson('tribunal_start_dates.json');
const tribunalQualityScores = readJson('tribunal_quality_scores.json');
const today = readJson('cache/today.json');
const backfill = readJson('cache/backfill.json');
const iaSnapshot = readJson('ia-snapshot.json');

const cacheData = {};
if (today) cacheData.today = today;
if (backfill) cacheData.backfill = backfill;
const cache = Object.keys(cacheData).length > 0 ? cacheData : null;

const data = deriveData(null, dashboardData, cache, tribunalStartDates, tribunalQualityScores, null, iaSnapshot);

// Snapshot-based header info
const snap = iaSnapshot?.summary;
const latestDate = snap?.latest_collection_date;
const snapshotTime = iaSnapshot?.generated_at;

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="CausaGanha - Publicações"
  description="Publicações judiciais brasileiras arquivadas no Internet Archive."
>
  <PageHeader title="CausaGanha">
    <DatabaseIcon slot="icon" />
    <p slot="subtitle">
      {snap ? `${snap.total_zips.toLocaleString()} ZIPs | ${snap.tribunals_with_data} tribunais | última coleta: ${latestDate}` : 'Carregando...'}
    </p>
    <a slot="nav" href={BASE}>Início</a>
  </PageHeader>

  <main id="main-content" class="container">
    <IASearchBar client:idle />

    <TribunalView
      client:idle
      initialCoverage={data?.tribunalCoverage}
      initialEtas={data?.tribunalEtas}
      initialTargetRange={data?.targetRange}
      initialStartDates={data?.tribunalStartDates}
      initialQualityScores={data?.tribunalQualityScores}
      initialPipeline={data?.cacheData?.today?.pipeline}
      initialProgressByYear={data?.progressByYear}
      initialVolume={data?.volume}
      initialVelocityMetrics={data?.velocityMetrics}
      initialIaSnapshot={data?.iaSnapshot}
    />

    <footer style="text-align: center;">
      <small>Dados do DJEN arquivados no Internet Archive.
        {snapshotTime && <span> Instantâneo: {new Date(snapshotTime).toLocaleString('pt-BR', { timeZone: 'UTC', day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' })} UTC</span>}
      </small>
    </footer>
  </main>
</Layout>
