---
import Layout from '../../layouts/Layout.astro';
import { ThemeToggle } from '../../components/ThemeToggle';
import { DocsDashboard } from '../../components/DocsDashboard';

let docsWarnings = null;

try {
  const fetchLocal = async (url) => {
    const fs = await import('node:fs/promises');
    const path = await import('node:path');
    const filePath = path.join(process.cwd(), 'public', url);
    const content = await fs.readFile(filePath, 'utf-8');
    return JSON.parse(content);
  };

  docsWarnings = await fetchLocal('docs-warnings.json').catch(() => null);
} catch (e) {
  console.warn('Failed to load docs warnings at build time:', e);
}
---

<Layout
  title="CausaGanha - Docs Warnings Digest"
  description="Compact operational summary of documentation build warnings."
>
  <div class="min-h-screen bg-white dark:bg-slate-950 p-4 md:p-6 lg:p-8">
    <header class="max-w-7xl mx-auto mb-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/causaganha/" class="p-2 bg-accent-muted rounded-xl hover:bg-accent hover:text-white transition-colors" aria-label="Voltar para o início">
          <svg class="w-5 h-5 text-accent hover:text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </a>
        <div>
          <h1 class="text-xl font-semibold text-black dark:text-white tracking-tight">
            Docs Warnings Digest
          </h1>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Categorized operational summary of mkdocs build warnings
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href="/causaganha/admin/perf" class="text-sm text-accent hover:underline hidden sm:block">Perf Dashboard</a>
        <ThemeToggle client:load />
      </div>
    </header>

    <main class="max-w-7xl mx-auto space-y-6">
      {docsWarnings ? (
        <DocsDashboard client:load docsWarnings={docsWarnings} />
      ) : (
        <div class="p-8 text-center bg-gray-50 dark:bg-slate-900 rounded-xl border border-gray-100 dark:border-slate-800">
          <p class="text-gray-500 dark:text-gray-400">No docs-warnings.json found. The documentation build may be clean, or the CI artifact has not been fetched.</p>
        </div>
      )}
    </main>
  </div>
</Layout>
