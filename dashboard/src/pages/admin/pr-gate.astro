---
import Layout from '../../layouts/Layout.astro';
import { ThemeToggle } from '../../components/ThemeToggle';
import { PRGateExplainer } from '../../components/PRGateExplainer';
---

<Layout
  title="CausaGanha - PR Readiness Gate"
  description="Compact PR readiness gate explainer for CausaGanha."
>
  <div class="min-h-screen bg-white dark:bg-slate-950 p-4 md:p-6 lg:p-8">
    <header class="max-w-7xl mx-auto mb-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a href="/causaganha/" class="p-2 bg-accent-muted rounded-xl hover:bg-accent hover:text-white transition-colors">
          <svg class="w-5 h-5 text-accent hover:text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
        </a>
        <div>
          <h1 class="text-xl font-semibold text-black dark:text-white tracking-tight">
            PR Readiness Gate
          </h1>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            Explain why a PR is or is not ready to merge
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <ThemeToggle client:load />
      </div>
    </header>

    <main class="max-w-7xl mx-auto space-y-6">
      <PRGateExplainer client:load />
    </main>
  </div>
</Layout>
