---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import JulesSessionStatus from '../../components/JulesSessionStatus.svelte';
import AuditLogExport from '../../components/AuditLogExport.svelte';
import PausedTribunals from '../../components/PausedTribunals.svelte';
import OmissionCost from '../../components/OmissionCost.svelte';
import { readJson } from '../../lib/readJson';

const backfillState = readJson<any>('cache/backfill_state.json');
const omissionStats = readJson<any>('cache/omission_stats.json');

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const adminPages = [
  { href: BASE + 'admin/backfill', title: 'Backfill Progress', description: 'Progresso de backfill e cobertura histórica' },
  { href: BASE + 'admin/perf', title: 'Performance Monitoring', description: 'Latência do sistema e taxas de sucesso de upload' },
  { href: BASE + 'admin/pr-gate', title: 'PR Gate', description: 'Explicação dos critérios de PR Gate' },
  { href: BASE + 'admin/quality', title: 'Data Quality', description: 'Score de qualidade por tribunal' },
];
---

<Layout title="Admin Dashboard" description="Painel de administração e monitoramento do CausaGanha.">
  <Header variant="page" title="Admin Dashboard" subtitle="Monitoramento interno e ferramentas do sistema" />

  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- Left Column: Admin Links -->
      <div class="lg:col-span-2">
        <h2 class="text-xl font-bold mb-4">Painéis de Monitoramento</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {adminPages.map(page => (
            <a href={page.href} class="card bg-base-100 shadow-sm border border-base-300 hover:border-primary transition-colors">
              <div class="card-body p-6">
                <h3 class="card-title text-lg">{page.title}</h3>
                <p class="text-sm opacity-70">{page.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right Column: Jules Sessions Widget -->
      <div class="lg:col-span-1">
        <h2 class="text-xl font-bold mb-4">Jules Assistant</h2>
        <JulesSessionStatus client:load />
      </div>

    </div>

    <!-- Bottom Section: Paused Tribunals -->
    <div class="mt-8">
      <PausedTribunals data={backfillState} client:load />
      <div class="mt-8">
        <AuditLogExport client:load />
      </div>
      <div class="mt-8">
        <OmissionCost omissionStats={omissionStats} client:load />
      </div>
    </div>

  </div>
</Layout>
