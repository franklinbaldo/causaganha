---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DatabaseCloudIcon from '../components/icons/DatabaseCloudIcon.astro';
import DownloadIcon from '../components/icons/DownloadIcon.astro';
import { readJson } from '../lib/readJson';

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const iaSnapshot = readJson('ia-snapshot.json');
const snap = iaSnapshot?.summary;
---

<Layout
  title="Dados Abertos - CausaGanha"
  description="Acesse, baixe e consulte dados judiciais brasileiros de 96 tribunais. Parquet, DuckDB e API pública."
>
  <style>
    .code-block {
      background: var(--color-surface-overlay);
      border: 1px solid var(--color-border-muted);
      border-radius: var(--border-radius);
      padding: var(--space-md);
      overflow-x: auto;
      font-size: var(--font-size-sm);
      position: relative;
    }
    .code-block pre {
      margin: 0;
      white-space: pre-wrap;
    }
    .schema-table td:first-child {
      font-family: monospace;
      font-weight: 600;
    }
    .schema-table td:nth-child(2) {
      font-family: monospace;
      font-size: var(--font-size-sm);
      color: var(--color-content-tertiary);
    }
    .download-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: var(--space-md);
    }
    .download-grid article {
      margin-bottom: 0;
    }
  </style>

  <Header variant="page" title="Dados Abertos" backHref={BASE} backLabel="Início">
    <DatabaseCloudIcon slot="icon" />
  </Header>

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: BASE },
      { label: 'Dados Abertos' }
    ]} />

    {/* Overview */}
    <section style="margin-top: var(--space-lg); margin-bottom: var(--space-xl);">
      <p>
        Todos os dados do CausaGanha são <strong>100% públicos e gratuitos</strong>.
        Coletados de {snap?.tribunals_with_data ?? 96} tribunais brasileiros,
        arquivados permanentemente no Internet Archive.
      </p>

      {snap && (
        <div class="grid" style="text-align: center;">
          <article>
            <strong style="font-size: var(--font-size-xl);">{snap.total_zips?.toLocaleString()}</strong>
            <br /><small class="text-muted">ZIPs arquivados</small>
          </article>
          <article>
            <strong style="font-size: var(--font-size-xl);">{snap.tribunals_with_data}</strong>
            <br /><small class="text-muted">Tribunais</small>
          </article>
          <article>
            <strong style="font-size: var(--font-size-xl);">{snap.total_size_gb} GB</strong>
            <br /><small class="text-muted">Volume total</small>
          </article>
          {snap.total_parquets > 0 && (
            <article>
              <strong style="font-size: var(--font-size-xl);">{snap.total_parquets}</strong>
              <br /><small class="text-muted">Parquets consolidados</small>
            </article>
          )}
        </div>
      )}
    </section>

    {/* Formats */}
    <article style="margin-bottom: var(--space-xl);">
      <header class="pb-sm border-bottom">
        <strong>Formatos disponíveis</strong>
      </header>
      <div class="download-grid" style="margin-top: var(--space-md);">
        <article>
          <h4>ZIP (Dados brutos)</h4>
          <p style="font-size: var(--font-size-sm);">
            Arquivos JSON originais do DJEN, um ZIP por tribunal por dia.
            Formato: <code>djen-YYYY-MM-DD-TRIBUNAL.zip</code>
          </p>
          <a href="https://archive.org/search?query=creator%3A%22causaganha%22" target="_blank" rel="noopener" role="button" class="outline">
            Buscar no Internet Archive
          </a>
        </article>
        <article>
          <h4>Parquet (Estruturado)</h4>
          <p style="font-size: var(--font-size-sm);">
            10 tabelas consolidadas por dia (comunicações, advogados, classificações, etc.).
            Compressão ZSTD, ideal para consultas analíticas.
          </p>
          <a href={BASE + 'explorador'} role="button" class="outline">
            Consultar no Explorador
          </a>
        </article>
        <article>
          <h4>DuckDB (Catálogo)</h4>
          <p style="font-size: var(--font-size-sm);">
            Banco analítico com views remotas para todos os Parquets.
            Baixe e consulte localmente sem downloads pesados.
          </p>
          <a href="https://archive.org/download/causaganha-catalog/catalog.duckdb" target="_blank" rel="noopener" role="button" class="outline">
            Baixar catalog.duckdb
          </a>
        </article>
      </div>
    </article>

    {/* Schema documentation */}
    <article style="margin-bottom: var(--space-xl);">
      <header class="pb-sm border-bottom">
        <strong>Schema das tabelas Parquet</strong>
      </header>

      <details open>
        <summary><code>comunicacoes.parquet</code> — Intimações e comunicações judiciais</summary>
        <div style="overflow-x: auto;">
          <table class="schema-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td>id</td><td>string</td><td>UUID da comunicação (hash de id + tribunal)</td></tr>
              <tr><td>tribunal</td><td>string</td><td>Código do tribunal (ex: TJSP)</td></tr>
              <tr><td>numero_processo</td><td>string</td><td>Número CNJ do processo</td></tr>
              <tr><td>data_disponibilizacao</td><td>date</td><td>Data de disponibilização</td></tr>
              <tr><td>tipo_comunicacao</td><td>string</td><td>Tipo (Intimação, Citação, etc.)</td></tr>
              <tr><td>nome_orgao</td><td>string</td><td>Vara ou turma responsável</td></tr>
              <tr><td>texto_id</td><td>string</td><td>FK para tabela textos</td></tr>
            </tbody>
          </table>
        </div>
      </details>

      <details>
        <summary><code>advogados.parquet</code> — Advogados identificados por OAB</summary>
        <div style="overflow-x: auto;">
          <table class="schema-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td>id</td><td>string</td><td>UUID global (hash de OAB+UF ou nome+tribunal)</td></tr>
              <tr><td>nome</td><td>string</td><td>Nome completo</td></tr>
              <tr><td>numero_oab</td><td>string</td><td>Número da OAB</td></tr>
              <tr><td>uf_oab</td><td>string</td><td>Estado da inscrição (SP, RJ, etc.)</td></tr>
              <tr><td>tribunal</td><td>string</td><td>Tribunal de origem</td></tr>
            </tbody>
          </table>
        </div>
      </details>

      <details>
        <summary><code>classificacoes.parquet</code> — Classificação de resultado</summary>
        <div style="overflow-x: auto;">
          <table class="schema-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td>texto_id</td><td>string</td><td>FK para textos.id</td></tr>
              <tr><td>metodo</td><td>string</td><td>Método de classificação (keyword_v1, llm_v1)</td></tr>
              <tr><td>outcome</td><td>string</td><td>WIN, LOSS, PARTIAL, SETTLEMENT, UNKNOWN</td></tr>
              <tr><td>decision_type</td><td>string</td><td>sentença, acórdão, decisão interlocutória</td></tr>
              <tr><td>confidence</td><td>float64</td><td>Score de confiança (0.0 a 1.0)</td></tr>
              <tr><td>winner_advogado_id</td><td>string</td><td>FK para advogados.id (quando identificado)</td></tr>
              <tr><td>loser_advogado_id</td><td>string</td><td>FK para advogados.id (quando identificado)</td></tr>
            </tbody>
          </table>
        </div>
      </details>

      <details>
        <summary><code>processos.parquet</code> — Índice de atividade processual</summary>
        <div style="overflow-x: auto;">
          <table class="schema-table">
            <thead><tr><th>Campo</th><th>Tipo</th><th>Descrição</th></tr></thead>
            <tbody>
              <tr><td>numero_processo</td><td>string</td><td>Número CNJ</td></tr>
              <tr><td>tribunal</td><td>string</td><td>Código do tribunal</td></tr>
              <tr><td>data</td><td>date</td><td>Data do evento</td></tr>
              <tr><td>comunicacao_id</td><td>string</td><td>FK para comunicacoes.id</td></tr>
            </tbody>
          </table>
        </div>
      </details>

      <details>
        <summary>Tabelas auxiliares (textos, destinatarios, partes, representacoes, etc.)</summary>
        <p style="font-size: var(--font-size-sm);">
          <code>textos</code> (id, texto) — Conteúdo das comunicações, deduplicado por hash.<br />
          <code>destinatarios</code> (comunicacao_id, nome, polo, parte_id) — Destinatários das intimações.<br />
          <code>partes</code> (id, nome_normalizado, nome_original) — Entidades normalizadas.<br />
          <code>representacoes</code> (advogado_id, parte_id, polo) — Vínculos advogado-parte.<br />
          <code>comunicacao_advogados</code> (comunicacao_id, advogado_id) — Link M:N.<br />
          <code>advogado_nomes</code> (advogado_id, nome, first_seen) — Variações de nome.
        </p>
      </details>
    </article>

    {/* Code examples */}
    <article style="margin-bottom: var(--space-xl);">
      <header class="pb-sm border-bottom">
        <strong>Como acessar os dados</strong>
      </header>

      <h4 style="margin-top: var(--space-lg);">Python + DuckDB</h4>
      <div class="code-block">
        <pre><code>import duckdb

con = duckdb.connect()

# Consulta remota (sem download)
con.sql("""
    SELECT tribunal, COUNT(*) as total
    FROM read_parquet('https://archive.org/download/djen-2026-04-01/comunicacoes.parquet')
    GROUP BY tribunal
    ORDER BY total DESC
""").show()

# Ou baixe o catálogo para consultas locais
# curl -O https://archive.org/download/causaganha-catalog/catalog.duckdb
# con = duckdb.connect('catalog.duckdb')</code></pre>
      </div>

      <h4 style="margin-top: var(--space-lg);">DuckDB CLI</h4>
      <div class="code-block">
        <pre><code>duckdb -c "
  SELECT nome, numero_oab, uf_oab
  FROM read_parquet('https://archive.org/download/djen-2026-04-01/advogados.parquet')
  LIMIT 10
"</code></pre>
      </div>

      <h4 style="margin-top: var(--space-lg);">Node.js / TypeScript</h4>
      <div class="code-block">
        <pre><code>import * as duckdb from '@duckdb/node-api';

const db = await DuckDBInstance.create();
const conn = await db.connect();

const result = await conn.run(`
  SELECT outcome, COUNT(*) as total
  FROM read_parquet('https://archive.org/download/djen-2026-04-01/classificacoes.parquet')
  GROUP BY outcome
`);</code></pre>
      </div>
    </article>

    {/* License */}
    <article style="margin-bottom: var(--space-2xl);">
      <header class="pb-sm border-bottom">
        <strong>Licença e citação</strong>
      </header>
      <p>
        Dados de domínio público, coletados do <strong>Diário de Justiça Eletrônico Nacional (DJEN)</strong>.
        O código do CausaGanha é licenciado sob <strong>MIT</strong>.
      </p>
      <div class="code-block">
        <pre><code>CausaGanha: Judicial Data Intelligence Pipeline.
https://github.com/franklinbaldo/causaganha
Dados: Internet Archive, coleção "djen-*"</code></pre>
      </div>
    </article>

    <footer style="text-align: center; padding: var(--space-lg) 0; border-top: 1px solid var(--color-border-muted);">
      <small class="text-muted">
        Dados 100% públicos, arquivados permanentemente no Internet Archive.
      </small>
    </footer>
  </div>
</Layout>
