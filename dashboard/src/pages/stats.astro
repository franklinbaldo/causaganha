---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { processCoverageOverview, processCourtReliability, processWeeklyPattern } from '../lib/stats-processing';

let data = {};
try {
  const response = await fetch(`https://archive.org/download/causaganha-catalog/completed-items.json?t=${Date.now()}`);
  const catalog = await response.json();
  data = catalog.completed_items || {};
} catch {
  // Network unavailable at build time
}

const { avgPct: avgCoverage30Pct, avgCoverage: avgCoverage30, bestDay, bestCount, worstDay, worstCount } = processCoverageOverview(data, 30);
const { top5, bottom5 } = processCourtReliability(data);
const { weeklyAverages, lowestDay } = processWeeklyPattern(data);

const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyAverages.find(w => w.dayIdx === idx));

const base = import.meta.env.BASE_URL ?? '/causaganha/';
---

<Layout
  title="Estatísticas - CausaGanha"
  description="Análise de cobertura histórica e confiabilidade dos tribunais."
>
  <style>
    .coverage-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-lg);
      text-align: center;
      padding: var(--space-md) 0;
    }
    .coverage-grid figure {
      margin: 0;
      padding: var(--space-lg) var(--space-sm);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    .coverage-grid figcaption {
      font-size: var(--font-size-sm);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-top: 1rem;
      opacity: 0.8;
    }
    .coverage-grid small {
      display: block;
      margin-top: 0.5rem;
      opacity: 0.6;
      font-size: var(--font-size-sm);
    }

    .rank-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 9999px;
      background: var(--color-surface-overlay);
      color: var(--color-content-secondary);
      font-size: var(--font-size-xs);
      font-weight: 600;
    }

    .weekly-grid {
      display: grid;
      grid-template-columns: repeat(1, 1fr);
      gap: var(--space-sm);
      text-align: center;
    }

    @media (min-width: 480px) {
      .weekly-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (min-width: 768px) {
      .weekly-grid { grid-template-columns: repeat(4, 1fr); }
    }

    @media (min-width: 1024px) {
      .weekly-grid { grid-template-columns: repeat(7, 1fr); }
    }

    .weekly-grid .card {
      padding: var(--space-md) var(--space-sm);
    }
    .weekly-grid .stat-value {
      font-size: var(--font-size-xl);
      margin: var(--space-xs) 0;
    }
    .day-name {
      font-size: var(--font-size-sm);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.7;
    }

    @media (max-width: 768px) {
      .coverage-grid { grid-template-columns: 1fr; gap: var(--space-md); }
    }
  </style>

  <Header
    variant="page"
    title="Estatísticas de Coleta"
    subtitle="Análise de cobertura histórica e confiabilidade"
    backHref={base}
    backLabel="Voltar para o Início"
  />

  <div class="container mx-auto px-4">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: base },
      { label: 'Estatísticas' }
    ]} />

    <!-- Coverage Overview -->
    <div class="card bg-base-100 shadow-sm border border-base-300 mb-10">
      <div class="card-body">
        <div class="flex justify-between items-baseline border-b border-base-300 pb-3">
          <strong>Resumo de Cobertura</strong>
          <small class="opacity-50">Últimos 30 dias</small>
        </div>
        <div class="coverage-grid pt-4">
          <figure>
            <div class="stat-value">{avgCoverage30Pct.toFixed(1)}<small style="font-size: 0.5em; font-weight: 500;">%</small></div>
            <figcaption>Média de Coleta</figcaption>
            <small class="opacity-50">{avgCoverage30.toFixed(1)} / 91 tribunais por dia</small>
          </figure>
          <figure>
            <div class="stat-value text-success">{bestCount}<small style="font-size: 0.5em; font-weight: 400; opacity: 0.5;"> / 91</small></div>
            <figcaption>Melhor Dia</figcaption>
            <small class="opacity-50">{bestDay ? bestDay.replace('djen-', '') : '--'}</small>
          </figure>
          <figure>
            <div class="stat-value text-error">{worstCount === 999 ? 0 : worstCount}<small style="font-size: 0.6em; font-weight: 600; opacity: 0.7;"> / 91</small></div>
            <figcaption>Pior Dia</figcaption>
            <small class="opacity-50">{worstDay ? worstDay.replace('djen-', '') : '--'}</small>
          </figure>
        </div>
      </div>
    </div>

    <!-- Court Rankings -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body">
          <div class="border-b border-base-300 pb-3">
            <strong>Top 5 Mais Confiáveis</strong>
          </div>
          {top5.length > 0 ? (
            <div class="table-responsive">
              <table class="table table-zebra table-sm">
                <tbody>
                  {top5.map((c, i) => (
                    <tr>
                      <td><span class="rank-num">{i + 1}</span></td>
                      <td><strong>{c.court}</strong></td>
                      <td class="text-success text-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-center opacity-50">Sem dados suficientes</p>
          )}
        </div>
      </div>

      <div class="card bg-base-100 shadow-sm border border-base-300">
        <div class="card-body">
          <div class="border-b border-base-300 pb-3">
            <strong>Top 5 Mais Falhas</strong>
          </div>
          {bottom5.length > 0 ? (
            <div class="table-responsive">
              <table class="table table-zebra table-sm">
                <tbody>
                  {bottom5.map((c, i) => (
                    <tr>
                      <td><span class="rank-num">{i + 1}</span></td>
                      <td><strong>{c.court}</strong></td>
                      <td class="text-error text-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="text-center opacity-50">Sem dados suficientes</p>
          )}
        </div>
      </div>
    </div>

    <!-- Weekly Pattern -->
    <div class="card bg-base-100 shadow-sm border border-base-300 mb-16">
      <div class="card-body">
        <div class="border-b border-base-300 pb-3 mb-4">
          <h3 class="text-xl font-bold mb-0">Padrão Semanal</h3>
          <p class="text-sm opacity-60 mb-0">Média de cobertura por dia da semana</p>
        </div>
        <div class="weekly-grid">
          {displayWeekly.map(w => {
            if (!w) return null;
            const isLowest = lowestDay && w.dayIdx === lowestDay.dayIdx;
            return (
              <div class="card bg-base-200">
                <div class="card-body items-center p-4">
                  <span class="day-name">{w.name.slice(0, 3)}</span>
                  <div class={`stat-value ${isLowest ? 'text-error' : ''}`}>
                    {w.avgPct.toFixed(0)}%
                  </div>
                  <small class="opacity-50">{w.avg.toFixed(1)} / 91</small>
                  {isLowest && (
                    <div class="mt-1"><span class="badge badge-error badge-sm">Menor</span></div>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</Layout>
