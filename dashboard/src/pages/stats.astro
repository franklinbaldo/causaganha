---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { processCoverageOverview, processCourtReliability, processWeeklyPattern } from '../lib/stats-processing';

// Fetch the catalog (with fallback for build environments without network)
let data = {};
try {
  const response = await fetch(`https://archive.org/download/causaganha-catalog/completed-items.json?t=${Date.now()}`);
  const catalog = await response.json();
  data = catalog.completed_items || {};
} catch {
  // Network unavailable at build time — page will render with empty data
}

// --- 1. Coverage Overview (30 days) ---
const { avgPct: avgCoverage30Pct, avgCoverage: avgCoverage30, bestDay, bestCount, worstDay, worstCount } = processCoverageOverview(data, 30);

// --- 2. Court Reliability Rankings ---
const { top5, bottom5 } = processCourtReliability(data);

// --- 3. Weekly Pattern ---
const { weeklyAverages, lowestDay } = processWeeklyPattern(data);

// Reorder for display: Monday (1) to Sunday (0)
const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyAverages.find(w => w.dayIdx === idx));

const base = import.meta.env.BASE_URL ?? '/causaganha/';
---

<Layout
  title="Estatísticas - CausaGanha Dashboard"
  description="Historical tribunal coverage analysis and reliability rankings."
>
  <PageHeader
    title="Estatísticas de Coleta"
    subtitle="Análise de cobertura histórica e confiabilidade"
    backHref={base}
    backLabel="Voltar para o Início"
  />

  <div class="container" style="margin-top: 2rem;">

    {/* 1. Coverage Overview */}
    <article style="margin-bottom: 2rem;">
      <header>
        <strong>Resumo de Cobertura (Últimos 30 Dias)</strong>
      </header>
      <div class="grid">
        <div style="text-align: center;">
          <div class="stat-value text-primary">{avgCoverage30Pct.toFixed(1)}%</div>
          <p class="stat-label">Média de Coleta</p>
          <small class="text-muted">{avgCoverage30.toFixed(1)} / 91 tribunais por dia</small>
        </div>
        <div style="text-align: center;">
          <div class="stat-value text-success">{bestCount} / 91</div>
          <p class="stat-label">Melhor Dia</p>
          <small class="text-muted">{bestDay ? bestDay.replace('djen-', '') : '--'}</small>
        </div>
        <div style="text-align: center;">
          <div class="stat-value text-danger">{worstCount === 999 ? 0 : worstCount} / 91</div>
          <p class="stat-label">Pior Dia</p>
          <small class="text-muted">{worstDay ? worstDay.replace('djen-', '') : '--'}</small>
        </div>
      </div>
    </article>

    {/* 2. Court Reliability Rankings */}
    <div class="grid" style="margin-bottom: 2rem;">
      <article>
        <header><strong>Top 5 Mais Confiáveis</strong></header>
        {top5.length > 0 ? (
          <table class="striped">
            <tbody>
              {top5.map((c, i) => (
                <tr>
                  <td><span class="badge" style="background: var(--pico-muted-border-color); color: var(--pico-color);">{i + 1}</span></td>
                  <td><strong>{c.court}</strong></td>
                  <td class="text-success"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                  <td class="text-muted"><small>{c.collected} success / {c.absent} fail</small></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p style="text-align: center;" class="text-muted">Sem dados suficientes</p>
        )}
      </article>

      <article>
        <header><strong>Top 5 Mais Falhas</strong></header>
        {bottom5.length > 0 ? (
          <table class="striped">
            <tbody>
              {bottom5.map((c, i) => (
                <tr>
                  <td><span class="badge" style="background: var(--pico-muted-border-color); color: var(--pico-color);">{i + 1}</span></td>
                  <td><strong>{c.court}</strong></td>
                  <td class="text-danger"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                  <td class="text-muted"><small>{c.collected} success / {c.absent} fail</small></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p style="text-align: center;" class="text-muted">Sem dados suficientes</p>
        )}
      </article>
    </div>

    {/* 3. Weekly Pattern */}
    <article style="margin-bottom: 4rem;">
      <header>
        <hgroup>
          <h2>Padrão Semanal</h2>
          <p>Média de cobertura por dia da semana em todo o histórico.</p>
        </hgroup>
      </header>
      <div class="grid">
        {displayWeekly.map(w => {
          if (!w) return null;
          const isLowest = lowestDay && w.dayIdx === lowestDay.dayIdx;
          return (
            <div style="text-align: center; padding: 1rem; border-radius: var(--pico-border-radius); background: var(--pico-background-color);">
              <small class="stat-label"><strong>{w.name.slice(0, 3)}</strong></small>
              <div class={`stat-value ${isLowest ? 'text-danger' : 'text-primary'}`} style="font-size: 1.5rem; margin: 0.5rem 0;">
                {w.avgPct.toFixed(0)}%
              </div>
              <small class="text-muted">{w.avg.toFixed(1)} / 91</small>
              {isLowest && (
                <div style="margin-top: 0.5rem;"><span class="badge badge-danger">Lowest</span></div>
              )}
            </div>
          );
        })}
      </div>
    </article>

  </div>
</Layout>
