---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { processCoverageOverview, processCourtReliability, processWeeklyPattern } from '../lib/stats-processing';

let data = {};
try {
  const response = await fetch(`https://archive.org/download/causaganha-catalog/completed-items.json?t=${Date.now()}`);
  const catalog = await response.json();
  data = catalog.completed_items || {};
} catch {
  // Network unavailable at build time
}

const { avgPct: avgCoverage30Pct, avgCoverage: avgCoverage30, bestDay, bestCount, worstDay, worstCount } = processCoverageOverview(data, 30);
const { top5, bottom5 } = processCourtReliability(data);
const { weeklyAverages, lowestDay } = processWeeklyPattern(data);

const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyAverages.find(w => w.dayIdx === idx));

const base = import.meta.env.BASE_URL ?? '/causaganha/';
---

<Layout
  title="Estatísticas - CausaGanha"
  description="Análise de cobertura histórica e confiabilidade dos tribunais."
>
  <style>
    .coverage-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
      text-align: center;
    }
    .coverage-grid figure {
      margin: 0;
      padding: var(--space-md) 0;
    }
    .coverage-grid figcaption {
      font-size: var(--font-size-xs);
      font-weight: 500;
      color: var(--color-content-tertiary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      margin-top: 0.5rem;
    }
    .coverage-grid small {
      display: block;
      margin-top: var(--space-xs);
    }

    table td {
      vertical-align: middle;
    }
    .rank-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.5rem;
      height: 1.5rem;
      border-radius: 9999px;
      background: var(--color-surface-overlay);
      color: var(--color-content-secondary);
      font-size: var(--font-size-xs);
      font-weight: 600;
    }

    .weekly-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: var(--space-sm);
      text-align: center;
    }
    .weekly-grid article {
      padding: var(--space-md) var(--space-sm);
      margin-bottom: 0;
    }
    .weekly-grid .stat-value {
      font-size: var(--font-size-xl);
      margin: var(--space-xs) 0;
    }
    .day-name {
      font-size: var(--font-size-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-content-tertiary);
    }

    @media (max-width: 768px) {
      .coverage-grid { grid-template-columns: 1fr; }
      .weekly-grid { grid-template-columns: repeat(4, 1fr); }
    }
  </style>

  <Header
    variant="page"
    title="Estatísticas de Coleta"
    subtitle="Análise de cobertura histórica e confiabilidade"
    backHref={base}
    backLabel="Voltar para o Início"
  />

  <div class="container">
    <Breadcrumbs crumbs={[
      { label: 'Início', href: base },
      { label: 'Estatísticas' }
    ]} />

    <!-- Coverage Overview -->
    <article class="mb-xl">
      <header class="pb-sm border-bottom">
        <strong>Resumo de Cobertura</strong>
        <small class="text-muted" style="float: right;">Últimos 30 dias</small>
      </header>
      <div class="coverage-grid pt-md">
        <figure>
          <div class="stat-value">{avgCoverage30Pct.toFixed(1)}<small style="font-size: 0.5em; font-weight: 500;">%</small></div>
          <figcaption>Média de Coleta</figcaption>
          <small class="text-muted">{avgCoverage30.toFixed(1)} / 91 tribunais por dia</small>
        </figure>
        <figure>
          <div class="stat-value text-success">{bestCount}<small style="font-size: 0.5em; font-weight: 400; color: var(--color-content-tertiary);"> / 91</small></div>
          <figcaption>Melhor Dia</figcaption>
          <small class="text-muted">{bestDay ? bestDay.replace('djen-', '') : '--'}</small>
        </figure>
        <figure>
          <div class="stat-value text-danger">{worstCount === 999 ? 0 : worstCount}<small style="font-size: 0.5em; font-weight: 400; color: var(--color-content-tertiary);"> / 91</small></div>
          <figcaption>Pior Dia</figcaption>
          <small class="text-muted">{worstDay ? worstDay.replace('djen-', '') : '--'}</small>
        </figure>
      </div>
    </article>

    <!-- Court Rankings -->
    <div class="grid mb-xl">
      <article>
        <header class="pb-sm border-bottom">
          <strong>Top 5 Mais Confiáveis</strong>
        </header>
        {top5.length > 0 ? (
          <table>
            <tbody>
              {top5.map((c, i) => (
                <tr>
                  <td><span class="rank-num">{i + 1}</span></td>
                  <td><strong>{c.court}</strong></td>
                  <td class="text-success text-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="text-center text-muted">Sem dados suficientes</p>
        )}
      </article>

      <article>
        <header class="pb-sm border-bottom">
          <strong>Top 5 Mais Falhas</strong>
        </header>
        {bottom5.length > 0 ? (
          <table>
            <tbody>
              {bottom5.map((c, i) => (
                <tr>
                  <td><span class="rank-num">{i + 1}</span></td>
                  <td><strong>{c.court}</strong></td>
                  <td class="text-danger text-right"><strong>{(c.rate * 100).toFixed(1)}%</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="text-center text-muted">Sem dados suficientes</p>
        )}
      </article>
    </div>

    <!-- Weekly Pattern -->
    <article style="margin-bottom: var(--space-2xl);">
      <header class="pb-sm border-bottom mb-md">
        <hgroup>
          <h3 class="mb-0">Padrão Semanal</h3>
          <p class="mb-0" style="font-size: var(--font-size-sm);">Média de cobertura por dia da semana</p>
        </hgroup>
      </header>
      <div class="weekly-grid">
        {displayWeekly.map(w => {
          if (!w) return null;
          const isLowest = lowestDay && w.dayIdx === lowestDay.dayIdx;
          return (
            <article>
              <span class="day-name">{w.name.slice(0, 3)}</span>
              <div class={`stat-value ${isLowest ? 'text-danger' : ''}`}>
                {w.avgPct.toFixed(0)}%
              </div>
              <small class="text-muted">{w.avg.toFixed(1)} / 91</small>
              {isLowest && (
                <div style="margin-top: var(--space-xs);"><span class="badge badge-danger">Menor</span></div>
              )}
            </article>
          );
        })}
      </div>
    </article>

  </div>
</Layout>
