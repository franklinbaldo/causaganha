---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import { processCoverageOverview, processCourtReliability, processWeeklyPattern } from '../lib/stats-processing';

// Fetch the catalog (with fallback for build environments without network)
let data = {};
try {
  const response = await fetch(`https://archive.org/download/causaganha-catalog/completed-items.json?t=${Date.now()}`);
  const catalog = await response.json();
  data = catalog.completed_items || {};
} catch {
  // Network unavailable at build time — page will render with empty data
}

// --- 1. Coverage Overview (30 days) ---
const { avgPct: avgCoverage30Pct, avgCoverage: avgCoverage30, bestDay, bestCount, worstDay, worstCount } = processCoverageOverview(data, 30);

// --- 2. Court Reliability Rankings ---
const { top5, bottom5 } = processCourtReliability(data);

// --- 3. Weekly Pattern ---
const { weeklyAverages, lowestDay } = processWeeklyPattern(data);

// Reorder for display: Monday (1) to Sunday (0)
const displayOrder = [1, 2, 3, 4, 5, 6, 0];
const displayWeekly = displayOrder.map(idx => weeklyAverages.find(w => w.dayIdx === idx));

const base = import.meta.env.BASE_URL ?? '/causaganha/';
---

<Layout
  title="Estatísticas - CausaGanha Dashboard"
  description="Historical tribunal coverage analysis and reliability rankings."
>
  <PageHeader
    title="Estatísticas de Coleta"
    subtitle="Historical coverage and reliability analysis"
    backHref={base}
    backLabel="Back to Dashboard"
  />

  <main id="main-content" class="container">

    {/* 1. Coverage Overview */}
    <article>
      <h2>Coverage Overview (Últimos 30 Dias)</h2>
      <div class="grid">
        <div style="text-align: center;">
          <small>Média de Coleta</small>
          <p class="text-accent"><strong>{avgCoverage30Pct.toFixed(1)}%</strong></p>
          <small>{avgCoverage30.toFixed(1)} / 91 tribunais por dia</small>
        </div>
        <div style="text-align: center;">
          <small>Melhor Dia</small>
          <p class="text-success"><strong>{bestCount} / 91</strong></p>
          <small>{bestDay ? bestDay.replace('djen-', '') : '--'}</small>
        </div>
        <div style="text-align: center;">
          <small>Pior Dia</small>
          <p class="text-danger"><strong>{worstCount === 999 ? 0 : worstCount} / 91</strong></p>
          <small>{worstDay ? worstDay.replace('djen-', '') : '--'}</small>
        </div>
      </div>
    </article>

    {/* 2. Court Reliability Rankings */}
    <div class="grid">
      <article>
        <h2>Top 5 Mais Confiáveis</h2>
        {top5.length > 0 ? (
          <table>
            <tbody>
              {top5.map((c, i) => (
                <tr>
                  <td><mark>{i + 1}</mark></td>
                  <td><strong>{c.court}</strong></td>
                  <td class="text-success">{(c.rate * 100).toFixed(1)}%</td>
                  <td><small>{c.collected} success / {c.absent} fail</small></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p style="text-align: center;">Sem dados suficientes</p>
        )}
      </article>

      <article>
        <h2>Top 5 Mais Falhas</h2>
        {bottom5.length > 0 ? (
          <table>
            <tbody>
              {bottom5.map((c, i) => (
                <tr>
                  <td><mark>{i + 1}</mark></td>
                  <td><strong>{c.court}</strong></td>
                  <td class="text-danger">{(c.rate * 100).toFixed(1)}%</td>
                  <td><small>{c.collected} success / {c.absent} fail</small></td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p style="text-align: center;">Sem dados suficientes</p>
        )}
      </article>
    </div>

    {/* 3. Weekly Pattern */}
    <article>
      <h2>Padrão Semanal</h2>
      <p>Média de cobertura por dia da semana em todo o histórico.</p>
      <div class="grid">
        {displayWeekly.map(w => {
          if (!w) return null;
          const isLowest = lowestDay && w.dayIdx === lowestDay.dayIdx;
          return (
            <div style="text-align: center;">
              <small><strong>{w.name.slice(0, 3)}</strong></small>
              <p class={isLowest ? 'text-danger' : ''}>
                <strong>{w.avgPct.toFixed(0)}%</strong>
              </p>
              <small>{w.avg.toFixed(1)} / 91</small>
              {isLowest && (
                <p><kbd class="text-danger">Lowest</kbd></p>
              )}
            </div>
          );
        })}
      </div>
    </article>

  </main>
</Layout>
