---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title="Página não encontrada — CausaGanha">
  <Header variant="page" title="Página não encontrada" backHref={BASE} backLabel="Início" />

  <div class="hero min-h-[50vh]">
    <div class="hero-content text-center">
      <div class="max-w-md">
        <p class="font-mono text-8xl font-extrabold tracking-tighter opacity-20">404</p>
        <h2 class="text-3xl font-bold mt-4">Página não encontrada</h2>
        <p class="py-4 opacity-60">
          Este conteúdo pode ainda não ter sido coletado ou o snapshot ainda não foi atualizado.
        </p>
        <div class="flex gap-4 justify-center">
          <a href={BASE + 'publicacoes'} class="btn btn-primary">Dashboard</a>
          <a href={BASE} class="btn btn-outline btn-secondary">Início</a>
        </div>
      </div>
    </div>
  </div>
</Layout>
