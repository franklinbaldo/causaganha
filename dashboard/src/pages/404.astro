---
import Layout from '../layouts/Layout.astro';
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout title="Página não encontrada - CausaGanha">
  <main class="container" style="text-align: center; padding-top: 4rem;">
    <h1 style="font-size: 6rem; opacity: 0.2; margin-bottom: 0;">404</h1>
    <h2>Página não encontrada</h2>
    <p>
      Este conteúdo pode ainda não ter sido coletado ou o snapshot ainda não foi atualizado.
    </p>
    <div class="grid">
      <a href={BASE + 'publicacoes'} role="button">Dashboard</a>
      <a href={BASE} role="button" class="secondary">Início</a>
    </div>
  </main>
</Layout>
