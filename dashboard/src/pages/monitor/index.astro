---
import Layout from '../../layouts/Layout.astro';
import { ThemeToggle } from '../../components/ThemeToggle';
import { deriveData } from '../../lib/fetchData';
import { TribunalView } from '../../components/TribunalView';
import { SystemStatus } from '../../components/SystemStatus';
import { CommandPalette } from '../../components/CommandPalette';
import { NetworkStatusBanner } from '../../components/NetworkStatusBanner';
import { IncidentBanner } from '../../components/IncidentBanner';
import { DataSourceIndicator } from '../../components/DataSourceIndicator';
import { WorkflowStatusBadge } from '../../components/WorkflowStatusBadge';
import { AnnualCoverageMonitor } from '../../components/AnnualCoverageMonitor';
import fs from 'node:fs';
import path from 'node:path';

// Read cache files from filesystem at build time
function readJson(relativePath) {
  try {
    const fullPath = path.resolve('./public', relativePath);
    return JSON.parse(fs.readFileSync(fullPath, 'utf-8'));
  } catch { return null; }
}

const dashboardData = readJson('dashboard-data.json');
const tribunalStartDates = readJson('tribunal_start_dates.json');
const tribunalQualityScores = readJson('tribunal_quality_scores.json');
const perfMetrics = readJson('perf-metrics.json');
const today = readJson('cache/today.json');
const calendar = readJson('cache/calendar.json');
const runs = readJson('cache/runs.json');
const backfill = readJson('cache/backfill.json');
const iaSnapshot = readJson('ia-snapshot.json');

const cacheData = {};
if (today) cacheData.today = today;
if (calendar) cacheData.calendar = calendar;
if (runs) cacheData.runs = runs;
if (backfill) cacheData.backfill = backfill;
const cache = Object.keys(cacheData).length > 0 ? cacheData : null;

const data = deriveData(null, dashboardData, cache, tribunalStartDates, tribunalQualityScores, perfMetrics, iaSnapshot);

const backfillProgress = data?.backfillProgress;
const lastUpdated = backfillProgress?.last_updated || today?.date;

const incident = data?.perfMetrics?.incident || null;
const tribunal_coverage = data?.tribunalCoverage || {};
const tribunal_etas = data?.tribunalEtas || {};

// Count healthy tribunals
let healthyTribunals = 0;
let maxEta = 0;
let pendingCount = 0;

const tribunalKeys = Object.keys(tribunal_etas);
if (tribunalKeys.length > 0) {
  for (const t in tribunal_etas) {
    const etaData = tribunal_etas[t];
    const missing = etaData.missing_days || 0;
    if (missing === 0) healthyTribunals++;

    if (etaData.eta_days) {
      if (etaData.eta_days > maxEta) {
        maxEta = etaData.eta_days;
      }
    } else if (missing > 0) {
      pendingCount++;
    }
  }
}

const targetRangeStart = data?.targetRange?.start || "2024-01-01";
const targetRangeEnd = data?.targetRange?.end || "2026-02-03";

function formatEta(days, pendingCount, healthyTribunals, totalTribunals) {
  if (totalTribunals === 0) return "Pending";
  if (healthyTribunals === totalTribunals) return "All Complete ✓";
  if (pendingCount > 0 || days === 0) return "Pending"; // If not all complete, but maxEta is 0, it means no velocity data

  if (days < 30) return `~${days} days`;
  const months = Math.round(days / 30);
  return `~${months} month${months > 1 ? 's' : ''}`;
}

const totalTribunalsInStats = tribunalKeys.length > 0 ? tribunalKeys.length : 91;
const globalEtaText = formatEta(maxEta, pendingCount, healthyTribunals, totalTribunalsInStats);

// Parse generated_at for display
let generatedText = '';
let isStale = false;

const generatedAtRaw = dashboardData?.generated_at || today?.date;
if (generatedAtRaw) {
  const d = new Date(generatedAtRaw);
  if (!isNaN(d.getTime())) {
    const now = new Date();
    const diffMs = now.getTime() - d.getTime();
    const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
    isStale = diffHours > 24;

    const day = String(d.getUTCDate()).padStart(2, '0');
    const month = String(d.getUTCMonth() + 1).padStart(2, '0');
    const hours = String(d.getUTCHours()).padStart(2, '0');
    const mins = String(d.getUTCMinutes()).padStart(2, '0');

    let relative = '';
    if (diffHours < 1) {
      const diffMins = Math.floor(diffMs / (1000 * 60));
      relative = `${diffMins} minuto${diffMins !== 1 ? 's' : ''} atrás`;
    } else if (diffHours < 24) {
      relative = `${diffHours} hora${diffHours !== 1 ? 's' : ''} atrás`;
    } else {
      const diffDays = Math.floor(diffHours / 24);
      relative = `${diffDays} dia${diffDays !== 1 ? 's' : ''} atrás`;
    }

    generatedText = `Dados atualizados: ${day}/${month} às ${hours}:${mins} UTC (${relative})`;
  }
}
---

<Layout
  title="CausaGanha Dashboard - Sistema de Monitoramento"
  description="Dashboard de monitoramento do pipeline de coleta e análise de dados judiciais brasileiros. Elimine assimetria de informação no mercado jurídico."
>
  <div class="min-h-screen bg-white dark:bg-slate-950 p-4 md:p-6 lg:p-8">
    <!-- Header — pure Astro HTML, zero JS -->
    <header class="max-w-7xl mx-auto mb-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-accent-muted rounded-xl">
          <svg class="w-5 h-5 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"/>
            <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
            <path d="M3 12A9 3 0 0 0 21 12"/>
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-semibold text-black dark:text-white tracking-tight">
            CausaGanha
          </h1>
          <p class="text-sm text-gray-500 dark:text-gray-400">
            {healthyTribunals} of 91 tribunais saudáveis | última coleta: {lastUpdated ? new Date(lastUpdated).toLocaleTimeString('pt-BR', {hour: '2-digit', minute:'2-digit'}) : '--:--'} | Global ETA: {globalEtaText}
          </p>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <WorkflowStatusBadge client:load />
        <a href={import.meta.env.BASE_URL} class="text-sm font-medium text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors mr-2">
          Início
        </a>
        <a href={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'stats'} class="text-sm font-medium text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors mr-2">
          Estatísticas
        </a>
        {generatedText && (
          <div class="flex flex-col items-end gap-1 text-sm">
            <div class="text-gray-500 dark:text-gray-400 font-mono text-xs hidden sm:block">
              {generatedText}
            </div>
            {isStale && (
              <div class="text-yellow-600 dark:text-yellow-400 font-medium text-xs flex items-center gap-1 bg-yellow-50 dark:bg-yellow-900/30 px-2 py-1 rounded hidden sm:flex">
                <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
                  <path d="M12 9v4"/><path d="M12 17h.01"/>
                </svg>
                Atenção: dados podem estar desatualizados
              </div>
            )}
          </div>
        )}
        <ThemeToggle client:load />
      </div>
    </header>

    <main id="main-content" class="max-w-7xl mx-auto space-y-6">

      <DataSourceIndicator client:load />

      <IncidentBanner client:load incident={incident} />

      <TribunalView
        client:load
        initialCoverage={tribunal_coverage}
        initialEtas={tribunal_etas}
        initialTargetRange={data?.targetRange}
        initialStartDates={data?.tribunalStartDates}
        initialQualityScores={data?.tribunalQualityScores}
        initialPipeline={data?.cacheData?.today?.pipeline}
        initialProgressByYear={data?.progressByYear}
        initialVolume={data?.volume}
        initialTribunalStats={data?.tribunalStats}
        initialVelocityMetrics={data?.velocityMetrics}
        initialIaSnapshot={data?.iaSnapshot}
      />

      <SystemStatus client:visible initialStats={data?.stats} initialCacheToday={data?.cacheData?.today} />

      <AnnualCoverageMonitor client:visible />

      <!-- Footer -->
      <footer class="text-center text-xs text-gray-500 dark:text-gray-400 pt-4 pb-2">
        <p>Data sourced from DJEN across 91 tribunals. Stored on Internet Archive.</p>
      </footer>
    </main>

    <CommandPalette client:load />
    <NetworkStatusBanner client:load />
  </div>
</Layout>
