---
import Layout from '../../../layouts/Layout.astro';
import { ThemeToggle } from '../../../components/ThemeToggle';
import { ZipDetail } from '../../../components/ZipDetail';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  let snapshot = null;
  try {
    const fullPath = path.resolve('./public', 'ia-snapshot.json');
    snapshot = JSON.parse(fs.readFileSync(fullPath, 'utf-8'));
  } catch { /* no snapshot available */ }
  if (!snapshot?.items) return [];

  const paths = [];
  for (const item of Object.values(snapshot.items)) {
    const tribunal = item.tribunal.toLowerCase();
    for (const date of item.dates) {
      paths.push({
        params: { tribunal, rest: date },
        props: { tribunalCode: item.tribunal, dateStr: date },
      });
    }
  }
  return paths;
}

const { tribunalCode, dateStr } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title={`${tribunalCode} ${dateStr} - CausaGanha`}
  description={`Publicacoes do ${tribunalCode} em ${dateStr} arquivadas no Internet Archive.`}
>
  <div class="min-h-screen bg-white dark:bg-slate-950 p-4 md:p-6 lg:p-8">
    <header class="max-w-7xl mx-auto mb-8 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="p-2 bg-accent-muted rounded-xl">
          <svg class="w-5 h-5 text-accent" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"/>
            <path d="M3 5V19A9 3 0 0 0 21 19V5"/>
            <path d="M3 12A9 3 0 0 0 21 12"/>
          </svg>
        </div>
        <div>
          <h1 class="text-xl font-semibold text-black dark:text-white tracking-tight">
            CausaGanha <span class="text-gray-400">/ {tribunalCode} / {dateStr}</span>
          </h1>
        </div>
      </div>
      <div class="flex items-center gap-3">
        <a href={`${BASE}monitor/${tribunalCode.toLowerCase()}`} class="text-sm font-medium text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors">
          {tribunalCode}
        </a>
        <a href={BASE + 'monitor'} class="text-sm font-medium text-gray-500 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors">
          Dashboard
        </a>
        <ThemeToggle client:load />
      </div>
    </header>

    <main class="max-w-7xl mx-auto">
      <ZipDetail client:load tribunalCode={tribunalCode} dateStr={dateStr} />
    </main>
  </div>
</Layout>
