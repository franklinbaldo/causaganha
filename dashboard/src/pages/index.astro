                </div>
                <div class="ml-4 flex-1">
                  <div class="font-semibold text-gray-800 dark:text-white">{tribunalsWithData} tribunais com dados</div>
                  <div class="text-sm text-gray-500 dark:text-gray-400">de {totalTribunals} monitorados</div>
                </div>
              </div>
              <div class="flex items-center p-3 bg-gray-50 dark:bg-slate-800 rounded-lg">
                <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center text-white">
