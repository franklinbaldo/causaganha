        </div>
        <div class="stat-card text-center p-6 rounded-xl transition-all duration-300">
          <div class="text-4xl md:text-5xl font-extrabold text-blue-800 dark:text-blue-400 mb-2">{totalGB.toFixed(0)} GB</div>
          <div class="text-gray-600 dark:text-gray-400">Volume Arquivado</div>
        </div>
        <div class="stat-card text-center p-6 rounded-xl transition-all duration-300">
          <div class="text-4xl md:text-5xl font-extrabold text-blue-800 dark:text-blue-400 mb-2">100%</div>
