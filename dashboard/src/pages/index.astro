---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Section from '../components/Section.astro';
import InfoSection from '../components/InfoSection.astro';
import MetricsGrid from '../components/MetricsGrid';
import ActivityCalendar from '../components/ActivityCalendar';
import TribunalHeatmap from '../components/TribunalHeatmap';
import RecentRuns from '../components/RecentRuns';
import RecentDays from '../components/RecentDays';
import { LABELS, API } from '../lib/constants';
---

<Layout title="CausaGanha - Monitor do Pipeline DJEN">
  <div class="min-h-screen flex flex-col">
    <Header />

    <main class="flex-1 max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <!-- Metrics Grid -->
      <section>
        <MetricsGrid client:load />
      </section>

      <!-- Activity Calendar -->
      <Section title={LABELS.activity.title}>
        <ActivityCalendar client:visible />
      </Section>

      <!-- Tribunal Heatmap -->
      <Section title={LABELS.tribunals.title}>
        <TribunalHeatmap client:visible />
      </Section>

      <!-- Two Column Layout: Runs + Days -->
      <div class="grid md:grid-cols-2 gap-6">
        <Section
          title={LABELS.runs.title}
          rightLink={{ text: LABELS.runs.viewAll, href: API.GH_ACTIONS }}
        >
          <RecentRuns client:visible />
        </Section>

        <Section
          title={LABELS.days.title}
          rightLink={{ text: LABELS.days.viewAll, href: 'https://archive.org/search?query=creator%3ACausaGanha' }}
        >
          <RecentDays client:visible />
        </Section>
      </div>

      <!-- Info Section -->
      <InfoSection />
    </main>

    <!-- Footer -->
    <footer class="border-t border-border py-6">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-text-muted">
          <div class="flex items-center gap-2">
            <span class="font-mono text-text-primary">causaganha</span>
            <span>•</span>
            <span>Arquivando comunicações judiciais brasileiras</span>
          </div>
          <div class="flex items-center gap-4">
            <a
              href="https://github.com/franklinbaldo/causaganha"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-text-primary transition-colors"
            >
              GitHub
            </a>
            <a
              href="https://archive.org/search?query=creator%3ACausaGanha"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-text-primary transition-colors"
            >
              Internet Archive
            </a>
          </div>
        </div>
      </div>
    </footer>
  </div>
</Layout>
