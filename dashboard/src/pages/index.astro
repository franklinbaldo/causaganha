---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import CheckIcon from '../components/icons/CheckIcon.astro';
import CheckCircleIcon from '../components/icons/CheckCircleIcon.astro';
import DownloadIcon from '../components/icons/DownloadIcon.astro';
import ArchiveIcon from '../components/icons/ArchiveIcon.astro';
import ChartIcon from '../components/icons/ChartIcon.astro';
import GitHubIcon from '../components/icons/GitHubIcon.astro';
import { readJson } from '../lib/readJson';
import { formatNumber, HOW_IT_WORKS_CARDS, AUDIENCE_CARDS } from '../lib/homepage-content';

const iaSnapshot = readJson('ia-snapshot.json');
const today = readJson('cache/today.json');

// Use snapshot as source of truth
const snap = iaSnapshot?.summary || {};
const totalZips = snap.total_zips || 0;
const totalTribunals = snap.tribunals_total || 96;
const tribunalsWithData = snap.tribunals_with_data || 0;
const totalGB = snap.total_size_gb || 0;
const latestDate = snap.latest_collection_date || '';

// Legacy pipeline data as fallback
const pipeline = today?.pipeline || {};
const datesCollected = pipeline.dates_collected || 0;
const progressPct = pipeline.progress_pct || 0;

const BASE = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Layout
  title="CausaGanha - Transparência no Mercado Jurídico Brasileiro"
  description="Coletamos e arquivamos dados públicos do Diário de Justiça Eletrônico Nacional de todos os tribunais do Brasil. Dados abertos, gratuitos, para sempre."
>
  <style>
    .gradient-bg {
      background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #1e3a8a 100%);
      color: #fff;
    }
    .hero-pattern {
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
    .floating { animation: floating 3s ease-in-out infinite; }
    @keyframes floating {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    .gradient-bg a { color: #fff; }
    .gradient-bg h1 { color: #fff; }
    .gradient-bg p { color: rgba(219, 234, 254, 0.9); }
    .hero-badge { display: inline-block; padding: 0.5rem 1rem; background: rgba(255,255,255,0.1); border-radius: 9999px; font-size: 0.875rem; margin-bottom: 1.5rem; }
    .amber { color: #f59e0b; }
    .stat-card { text-align: center; transition: transform 0.3s, box-shadow 0.3s; }
    .stat-card:hover { transform: translateY(-5px); box-shadow: 0 20px 40px rgba(0,0,0,0.15); }
    .stat-big { font-size: 2.5rem; font-weight: 800; color: var(--pico-primary); }
  </style>

  <!-- Navigation -->
  <nav class="container">
    <ul>
      <li><strong><span style="color: var(--pico-primary);">Causa</span><span class="amber">Ganha</span></strong></li>
    </ul>
    <ul>
      <li><a href="#como-funciona">Como Funciona</a></li>
      <li><a href="#dados">Dados</a></li>
      <li><a href="#para-quem">Para Quem</a></li>
      <li><a href={BASE + 'publicacoes'} role="button">Publicações</a></li>
    </ul>
  </nav>

  <!-- Hero Section -->
  <header class="gradient-bg hero-pattern" style="padding: 4rem 0;">
    <div class="container">
      <div class="grid">
        <div>
          <div class="hero-badge">
            Dados reais do Diário de Justiça Eletrônico Nacional
          </div>
          <h1>
            Transparência no Mercado <span class="amber">Jurídico</span> Brasileiro
          </h1>
          <p>
            Coletamos e arquivamos dados públicos de <strong>{totalTribunals} tribunais</strong> brasileiros
            diariamente. Dados abertos, gratuitos, armazenados permanentemente no Internet Archive.
          </p>
          <div class="grid">
            <a href={BASE + 'publicacoes'} role="button">
              Ver Publicações
            </a>
            <a href="#como-funciona" role="button" class="outline">
              Saiba Mais
            </a>
          </div>
        </div>
        <article class="floating">
          <header>
            <strong>Pipeline ao Vivo</strong>
            <small>Atualizado a cada 20 min</small>
          </header>
          <div>
            <p>
              <CheckIcon /> <strong>{tribunalsWithData} tribunais com dados</strong><br/>
              <small>de {totalTribunals} monitorados</small>
            </p>
            <p>
              <DownloadIcon /> <strong>{formatNumber(totalZips)} ZIPs coletados</strong><br/>
              <small>armazenados no Internet Archive</small>
            </p>
            <p>
              <strong>{progressPct}%</strong> Backfill em andamento<br/>
              <small>{formatNumber(pipeline.backfill_done || 0)} de {formatNumber(pipeline.backfill_total || 0)}</small>
            </p>
          </div>
        </article>
      </div>
    </div>
  </header>

  <!-- Stats Section -->
  <section id="dados">
    <div class="container">
      <hgroup style="text-align: center;">
        <h2>Dados Reais do Pipeline</h2>
        <p>Números atualizados automaticamente pelo workflow de coleta</p>
      </hgroup>

      <div class="grid">
        <article class="stat-card">
          <div class="stat-big">{formatNumber(totalZips)}</div>
          <p>ZIPs Arquivados</p>
        </article>
        <article class="stat-card">
          <div class="stat-big">{tribunalsWithData}</div>
          <p>Tribunais com Dados</p>
        </article>
        <article class="stat-card">
          <div class="stat-big">{totalGB.toFixed(0)} GB</div>
          <p>Volume Arquivado</p>
        </article>
        <article class="stat-card">
          <div class="stat-big">100%</div>
          <p>Dados Públicos</p>
        </article>
      </div>
    </div>
  </section>

  <!-- How it Works -->
  <section id="como-funciona">
    <div class="container">
      <hgroup style="text-align: center;">
        <h2>Como Funciona</h2>
        <p>Pipeline automatizado coleta dados do DJEN a cada 20 minutos e arquiva permanentemente no Internet Archive</p>
      </hgroup>
      <div class="grid">
        <article>
          <header><DownloadIcon /></header>
          <h3>1. Coleta Automática</h3>
          <p>A cada 20 minutos, o GitHub Actions coleta publicações do DJEN de {totalTribunals} tribunais brasileiros via proxy dedicado.</p>
        </article>
        <article>
          <header><ArchiveIcon /></header>
          <h3>2. Arquivo Permanente</h3>
          <p>Cada ZIP é enviado ao Internet Archive, garantindo acesso público permanente. Já temos {formatNumber(totalZips)} arquivos preservados.</p>
        </article>
        <article>
          <header><ChartIcon /></header>
          <h3>3. Catálogo Indexado</h3>
          <p>Um catálogo em Parquet é gerado automaticamente, permitindo consultas rápidas sobre os dados coletados.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- For Who Section -->
  <section id="para-quem">
    <div class="container">
      <hgroup style="text-align: center;">
        <h2>Para Quem?</h2>
        <p>Dados abertos para todo o ecossistema jurídico</p>
      </hgroup>
      <div class="grid">
        <article>
          <h3>&#129489;&#8205;&#9878;&#65039; Pesquisadores</h3>
          <p>Acesse dados estruturados de publicações judiciais para pesquisas acadêmicas e análises jurídicas.</p>
          <ul>
            <li>Dados em formato Parquet</li>
            <li>Consultável via DuckDB</li>
            <li>Histórico completo preservado</li>
          </ul>
        </article>
        <article>
          <h3>&#127970; LegalTechs</h3>
          <p>Use como base de dados para construir produtos e serviços no mercado jurídico brasileiro.</p>
          <ul>
            <li>API via Internet Archive</li>
            <li>Atualização contínua</li>
            <li>Sem custos de licenciamento</li>
          </ul>
        </article>
        <article>
          <h3>&#9878;&#65039; Jornalistas</h3>
          <p>Investigue e analise dados do judiciário brasileiro com transparência total.</p>
          <ul>
            <li>Dados públicos verificáveis</li>
            <li>Cobertura de {totalTribunals} tribunais</li>
            <li>Arquivo permanente no IA</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- Open Data + Support Section -->
  <section>
    <div class="container">
      <hgroup style="text-align: center;">
        <p><kbd>100% Aberto e Gratuito</kbd></p>
        <h2>Dados Abertos Para Sempre</h2>
        <p>
          Transparência no judiciário é um direito de todos.
          <br/>Os dados coletados pelo CausaGanha são e sempre serão gratuitos e públicos.
        </p>
      </hgroup>

      <article>
        <h3>Infraestrutura</h3>
        <div class="grid">
          <p><CheckCircleIcon /> GitHub Actions para coleta automática</p>
          <p><CheckCircleIcon /> Internet Archive para armazenamento permanente</p>
          <p><CheckCircleIcon /> DuckDB + Parquet para consultas rápidas</p>
          <p><CheckCircleIcon /> Código 100% open source no GitHub</p>
        </div>
      </article>

      <article style="text-align: center;">
        <h3>Apoie o Projeto</h3>
        <p>O CausaGanha é mantido de forma independente. Contribua com uma estrela no GitHub ou ajude a divulgar o projeto.</p>
        <div class="grid">
          <a href="https://github.com/franklinbaldo/causaganha" target="_blank" rel="noopener" role="button">
            <GitHubIcon /> Estrela no GitHub
          </a>
          <a href={BASE + 'publicacoes'} role="button" class="secondary">
            Ver Publicações &rarr;
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- FAQ Section -->
  <section>
    <div class="container">
      <h2 style="text-align: center;">Perguntas Frequentes</h2>
      <details>
        <summary>De onde vêm os dados?</summary>
        <p>Todos os dados são extraídos do Diário de Justiça Eletrônico Nacional (DJEN), que é um registro público de todas as comunicações judiciais do Brasil. Coletamos de {totalTribunals} tribunais.</p>
      </details>
      <details>
        <summary>Com que frequência os dados são atualizados?</summary>
        <p>O pipeline roda a cada 20 minutos via GitHub Actions. Cada execução coleta novas publicações e envia ao Internet Archive. O dashboard é atualizado automaticamente após cada coleta.</p>
      </details>
      <details>
        <summary>Como posso acessar os dados?</summary>
        <p>Os dados estão disponíveis no Internet Archive sob o identificador <code>djen-YYYY-MM-DD</code>. O catálogo indexado em formato Parquet pode ser consultado via DuckDB.</p>
      </details>
      <details>
        <summary>O projeto é open source?</summary>
        <p>Sim! Todo o código está disponível no <a href="https://github.com/franklinbaldo/causaganha" target="_blank" rel="noopener">GitHub</a>. Contribuições são bem-vindas.</p>
      </details>
    </div>
  </section>

  <Footer />
</Layout>
